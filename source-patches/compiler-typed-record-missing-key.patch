diff --git a/packages/compiler-backend-cpp/src/cppTypedRecordMissingKey.test.ts b/packages/compiler-backend-cpp/src/cppTypedRecordMissingKey.test.ts
new file mode 100644
index 0000000..045a197
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppTypedRecordMissingKey.test.ts
@@ -0,0 +1,48 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/typedRecordMissingKey.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('reads a missing erased record key as undefined through the indexed and named forms', () => {
+  const output = emit(`
+    export function countSection(record: Record<string, unknown>, key: string): number {
+      const value = record[key];
+      if (!Array.isArray(value) || value.length === 0) return 0;
+      return value.length;
+    }
+    export function armatureOf(record: Record<string, unknown>): unknown {
+      return record.armature;
+    }
+  `);
+
+  expect(output).toContain('record.get(key).value_or(flight::Any(flight::undefined))');
+  expect(output).toContain('record.get(flight::String("armature")).value_or(flight::Any(flight::undefined))');
+  expect(output).not.toContain('record.get(key).value()');
+});
+
+it('keeps the strict read for a concrete record value type', () => {
+  const output = emit(`
+    export function total(record: Record<string, number>): number {
+      return record.total;
+    }
+  `);
+
+  expect(output).toContain('.get(flight::String("total")).value()');
+  expect(output).not.toContain('value_or');
+});
