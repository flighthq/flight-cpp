+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const toolchain = findCppCompilerToolchain();
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+const source = `export interface Meta{image:string;layers?:string[];scale?:string;size:number|null}
+let calls=0;
+function nullable():number|null{calls=calls*10+2;return null}
+function label():string{calls=calls*10+1;return 'native'}
+export function make():Meta{return {size:nullable(),scale:undefined,image:label()}}
+export function empty():Meta{return {image:'empty',size:null}}
+export function trace():number{return calls}
+export function write(value:Meta):void{value.layers=[];value.scale=undefined;value.image='changed'}
+export function erase(value:Meta):boolean{return delete value.scale}
+class Plain{value=0;constructor(value:number){this.value=value}}
+export function classValue():number{return new Plain(5).value}`;
+function emit(): string {
+  const [lowered] = lowerTypeScriptSources([
+    {
+      packageName: '@flighthq/probe',
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/probe/src/probe.ts', source, ts.ScriptTarget.Latest, true),
+    },
+  ]);
+  expect(lowered!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered!.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/probe': { namespace: 'probe', includePrefix: 'fixture' } },
+  }).contents;
+}
+it.skipIf(!toolchain || includes.length === 0)(
+  'retains authored null/undefined/omission/order and the original native owner',
+  () => {
+    const js: Record<string, (...args: unknown[]) => unknown> = {};
+    new Function(
+      'exports',
+      ts.transpileModule(source, {
+        compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+      }).outputText,
+    )(js);
+    const expected = js.make!() as Record<string, unknown>;
+    const cppKeys = (value: Record<string, unknown>) =>
+      Object.keys(value)
+        .map((key) => 'flight::String(' + JSON.stringify(key) + ')')
+        .join(',');
+    const keys = cppKeys(expected);
+    const erased = js.erase!(expected);
+    const eraseAgain = js.erase!(expected);
+    const erasedKeys = cppKeys(expected);
+    expected.scale = undefined;
+    const readdedKeys = cppKeys(expected);
+    const written = js.empty!() as Record<string, unknown>;
+    js.write!(written);
+    const writtenKeys = cppKeys(written);
+    const directory = mkdtempSync(path.join(tmpdir(), 'flight-native-literal-presence-'));
+    try {
+      const header = emit();
+      expect(header).not.toContain('NOT GENERATED');
+      writeFileSync(path.join(directory, 'probe.hpp'), header);
+      const code = `#include "probe.hpp"
+#include <iostream>
+#include <stdexcept>
+int main(){try{
+(void)(sizeof(flight::RowKey<"image">)+sizeof(flight::RowKey<"layers">)+sizeof(flight::RowKey<"scale">)+sizeof(flight::RowKey<"size">));
+int checks=0;auto check=[&](bool value){++checks;if(!value)throw std::runtime_error("native presence control "+std::to_string(checks));};
+auto native=probe::make();auto alias=native;const auto row=flight::StructuralRef<flight::RowOf<flight::Ref<probe::Meta>>>(native);const auto properties=flight::named_properties(row);
+check(properties.keys()==std::vector<flight::String>{${keys}});
+check(probe::trace()==${String(js.trace!())});
+check(properties.has(flight::String("size"))&&properties.get(flight::String("size")).is_null());
+check(properties.has(flight::String("scale"))&&properties.get(flight::String("scale")).is_undefined());
+check(!properties.has(flight::String("layers"))&&properties.get(flight::String("layers")).is_undefined());
+const auto originalKeys=properties.keys();check(!properties.set(flight::String("layers"),flight::Any(13.0)));
+check(!properties.has(flight::String("layers"))&&properties.keys()==originalKeys);
+check(row.shared_object()==native&&alias==native);check(flight::named_properties(alias).shared_owner()==row.shared_owner());
+native->size=7;check(properties.get(flight::String("size")).as_number()==7);
+native->size.reset();check(properties.get(flight::String("size")).is_null());
+const auto empty=probe::empty();check(flight::named_properties(empty).keys()==std::vector<flight::String>{flight::String("image"),flight::String("size")});
+check(!flight::named_properties(empty).has(flight::String("scale")));
+check(probe::erase(native)==${String(erased)});
+check(!flight::named_properties(alias).has(flight::String("scale")));check(flight::named_properties(alias).keys()==std::vector<flight::String>{${erasedKeys}});check(probe::erase(native)==${String(eraseAgain)});
+check(properties.set(flight::String("scale"),flight::Any(flight::undefined)));
+check(flight::named_properties(alias).has(flight::String("scale"))&&flight::named_properties(alias).get(flight::String("scale")).is_undefined());
+check(flight::named_properties(alias).keys()==std::vector<flight::String>{${readdedKeys}});
+probe::write(empty);check(flight::named_properties(empty).has(flight::String("layers")));
+check(flight::named_properties(empty).has(flight::String("scale"))&&flight::named_properties(empty).get(flight::String("scale")).is_undefined());
+check(flight::named_properties(empty).keys()==std::vector<flight::String>{${writtenKeys}});
+check(flight::named_properties(empty).get(flight::String("image")).as_string()==flight::String("changed"));
+check(probe::class_value()==${String(js.classValue!())});
+std::cout<<checks<<" original source native-literal presence controls PASS\\n";
+}catch(const std::exception& error){std::cerr<<error.what()<<"\\n";return 1;}}`;
+      const input = path.join(directory, 'native.cpp'),
+        output = path.join(directory, getCppExecutableName(toolchain!, 'native'));
+      writeFileSync(input, code);
+      execFileSync(
+        toolchain!.command,
+        createCppExecutableArguments(toolchain!, input, output, [directory, ...includes]),
+        { stdio: 'pipe' },
+      );
+      expect(execFileSync(output, [], { encoding: 'utf8', stdio: 'pipe' })).toContain(
+        '25 original source native-literal presence controls PASS',
+      );
+    } finally {
+      rmSync(directory, { recursive: true, force: true });
+    }
+  },
+  120000,
+);
