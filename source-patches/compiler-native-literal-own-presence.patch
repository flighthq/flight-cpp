+// Literal key metadata describes storage, not a snapshot of a native value. A null-only optional
+// needs a null fallback for its disengaged carrier; represented alternatives remain cell-owned.
+function getCppConstructedMemberSentinelCpp(
+  type: Readonly<IrType> | undefined,
+  context: EmitContext,
+): 'Null' | 'Value' {
+  const union = type ? getIrUnionTypeCpp(type, context, new Set()) : undefined;
+  const plan = union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  return plan?.sentinels.null === 'optionalAbsence' && plan.sentinels.undefined === 'absent' ? 'Null' : 'Value';
+}
+
+// A subsequent source assignment must add an omitted native key on its original owner. Keep the
+// original typed member assignment (including evaluation and return carrier), then record presence.
+// Class constructors use a raw receiver before shared ownership exists, and retain their existing
+// lowering, together with external/accessor storage. Only native literal representations participate.
+function emitCppConstructedMemberAssignmentCpp(
+  target: Readonly<IrExpression>,
+  value: string,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || target.kind !== 'property') return undefined;
+  const type = getIrExpressionTypeEvidenceCpp(target.object, context);
+  if (!type || getIrExpressionClassAccessorCpp(target.object, target.name, 'set', context)) return undefined;
+  const plan = context.referenceRepresentationPlanner.plan(type, context.module);
+  if (
+    plan.kind !== 'represented' ||
+    !['interface', 'objectAlias', 'anonymousObject'].includes(plan.category) ||
+    !hasFlightReferenceRepresentationCpp(type, context)
+  )
+    return undefined;
+  const property = getIrObjectPropertyTypeCpp(type, target.name, context);
+  if (!property) return undefined;
+  const receiver = getGeneratedTargetName('member_write_receiver', context);
+  const result = getGeneratedTargetName('member_write_result', context);
+  const sentinel = getCppConstructedMemberSentinelCpp(property, context);
+  context.includes.add('flight/structural_ref.hpp');
+  return `([&]() { const auto ${receiver} = ${emitExpression(target.object, context)}; auto ${result} = (${receiver}->${safeCppName(target.name)} = ${value}); flight::named_properties(${receiver}).shared_owner()->mark_named_own_key(${JSON.stringify(target.name)}, flight::ConstructedKeySentinel::${sentinel}); return ${result}; }())`;
+}
+
+// Source delete is distinct from assignment of undefined. A declared optional data field of an
+// exact native subject has a disengageable carrier, so row_delete clears it and removes own presence.
+function emitCppConstructedMemberDeleteCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'unary' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (
+    getCppRuntimeProfile(context.options) !== 'flight-cpp' ||
+    expression.operator !== 'delete' ||
+    expression.operand.kind !== 'property'
+  )
+    return undefined;
+  const target = expression.operand;
+  const type = getIrExpressionTypeEvidenceCpp(target.object, context);
+  if (!type || getIrExpressionClassAccessorCpp(target.object, target.name, 'get', context)) return undefined;
+  const plan = context.referenceRepresentationPlanner.plan(type, context.module);
+  if (
+    plan.kind !== 'represented' ||
+    !['interface', 'objectAlias', 'anonymousObject'].includes(plan.category) ||
+    !hasFlightReferenceRepresentationCpp(type, context)
+  )
+    return undefined;
+  const property = context.referenceRepresentationPlanner
+    .resolveObjectShape(type, context.module)
+    ?.find((member) => member.name === target.name);
+  if (!property?.optional || property.readonly) return undefined;
+  context.includes.add('flight/structural_ref.hpp');
+  const rowType = `flight::StructuralRef<flight::RowWritable<flight::RowOf<${emitType(type, context)}>>>`;
+  return `flight::row_delete<flight::RowKey<${JSON.stringify(target.name)}>>(${rowType}(${emitExpression(target.object, context)}))`;
+}
