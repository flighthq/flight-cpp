@@ -14244,6 +14245,29 @@ function getCppClosedKeyElementWriteTypeCpp(
 // evaluated once and in source order before the dispatch. A key outside the proven set can only arrive
 // through unsound typing; it calls no target and throws the TypeError JavaScript raises for calling
 // `undefined`. An open key, a spread argument, or a non-void result keeps the existing paths and refusals.
+// A host object the profile binds -- `console`, `performance` -- has members, not a subscript. A represented
+// access to one never reaches element emission: a named member is a property read, and a finite key proven
+// to name bound members is a call the dispatch lane takes first. Any element access that does reach here is
+// an open key -- a `string`, an `any` cast, a Record cast of the host -- and every remaining lowering would
+// index the host carrier, which neither compiles nor selects a member. Refused and named instead, with no
+// cast of the host to an erased value.
+function refuseCppHostObjectDynamicIndexCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'element' }>>,
+  context: EmitContext,
