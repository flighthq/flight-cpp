--- /dev/null
+++ b/packages/types/src/ModifierValue.ts
@@ -0,0 +1,40 @@
+import type { AnimatedNormalModifier } from './AnimatedNormalModifier.ts';
+import type { DissolveModifier } from './DissolveModifier.ts';
+import type { EmissiveModifier } from './EmissiveModifier.ts';
+import type { EnvReflectModifier } from './EnvReflectModifier.ts';
+import type { FogModifier } from './FogModifier.ts';
+import type { Modifier } from './Modifier.ts';
+import type { RimModifier } from './RimModifier.ts';
+import type { ToonModifier } from './ToonModifier.ts';
+import type { VertexDisplaceModifier } from './VertexDisplaceModifier.ts';
+
+// The Modifier family is open: vendor descriptors implement Modifier and the built-ins extend it.
+// Storing a stack through the flattened Modifier owner alone discards which native owner was stored,
+// so a GL callback that reads a built-in's fields asserts them back out of a carrier the emitter
+// flattens into an unrelated owner. Naming the built-ins as redundant arms BESIDE the open one keeps
+// the same TypeScript value domain -- every arm already extends Modifier, so vendor kinds stay
+// accepted through the open arm -- while giving the exact-owner union rule one owner to select.
+export type ModifierValue =
+  | Modifier
+  | AnimatedNormalModifier
+  | DissolveModifier
+  | EmissiveModifier
+  | EnvReflectModifier
+  | FogModifier
+  | RimModifier
+  | ToonModifier
+  | VertexDisplaceModifier;
+
+// The callback-facing view. Written out rather than as Readonly<ModifierValue> so the readonly
+// application distributes over each arm: a homomorphic mapped type over a union of interfaces whose
+// members differ would otherwise collapse the arms the callbacks need to select between.
+export type ReadonlyModifierValue =
+  | Readonly<Modifier>
+  | Readonly<AnimatedNormalModifier>
+  | Readonly<DissolveModifier>
+  | Readonly<EmissiveModifier>
+  | Readonly<EnvReflectModifier>
+  | Readonly<FogModifier>
+  | Readonly<RimModifier>
+  | Readonly<ToonModifier>
+  | Readonly<VertexDisplaceModifier>;
