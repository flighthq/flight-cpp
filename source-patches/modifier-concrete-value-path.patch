+import type { ToonModifier } from './ToonModifier';
+import type { VertexDisplaceModifier } from './VertexDisplaceModifier';
+
+// The open Modifier arm keeps vendor kinds accepted, while the redundant built-in arms retain their
+// concrete owners across heterogeneous material stacks on invariant native targets. Every named arm
+// already extends Modifier, so this union changes neither the TypeScript value domain nor JavaScript.
+export type ModifierValue =
+  | Modifier
+  | AnimatedNormalModifier
+  | DissolveModifier
+  | EmissiveModifier
+  | EnvReflectModifier
+  | FogModifier
+  | RimModifier
+  | ToonModifier
+  | VertexDisplaceModifier;
