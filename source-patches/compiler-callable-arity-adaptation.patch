@@ -21989,6 +21999,73 @@ function isIrStringTypeEvidenceCpp(type: Readonly<IrType> | undefined): boolean
 // both. Prefer a complete contextual substitution when every argument can retain its representation or
 // is a fresh object constructible in that domain; otherwise retain the checker-inferred call result.
 // An incomplete result is left to ordinary C++ deduction instead of manufacturing a runtime type.
+// A source callable whose parameter list is not the one the position declares, stored where that position's
+// callable is expected -- TypeScript passes the extra arguments and the source ignores them, while
+// `std::function` refuses the narrower signature.
+//
+// The adaptation itself is the one this file already performs for a callable slot inside a union
+// (`emitCppContextualCallableUnionValueCpp`): a wrapper taking the contextual parameter list, invoking the
+// source once and retaining it by value. This reaches that same lowering from the plain-callable position,
+// which had no path to it. The opposite direction -- a source REQUIRING more parameters than the target
+// promises -- is not an adaptation but a different callable, and is refused.
+// The callable a position declares, when it declares one directly: an alias resolved to a function type. A
+// union or optional carrier is deliberately NOT resolved here -- the emission for those wraps the callable,
+// and that wrapping is the union path's job.
+function getCppPlainCallableTypeCpp(
+  type: Readonly<IrType>,
+  context: EmitContext,
+): Readonly<Extract<IrType, { kind: 'function' }>> | undefined {
+  if (type.kind === 'function') return type;
+  if (type.kind === 'typeOf') {
+    const valueType = getCppTypeOfValueType(type, context);
+    return valueType ? getCppPlainCallableTypeCpp(valueType, context) : undefined;
+  }
+  if (type.kind !== 'named' || type.reference.kind !== 'binding') return undefined;
+  const alias = resolveCppTypeAliasTarget(type, context);
+  return alias ? getCppPlainCallableTypeCpp(alias, context) : undefined;
+}
+
+function emitCppContextualCallableArityAdaptationCpp(
+  expression: Readonly<IrExpression>,
+  expectedType: Readonly<IrType> | undefined,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expectedType === undefined) return undefined;
+  // A function literal pads its own parameter list (emitExpression's own case) -- this is about a callable
+  // VALUE being stored, which is a different shape and must not be wrapped twice.
+  if (expression.kind === 'function') return undefined;
+  // A PLAIN callable position only: a union or optional carrier has its own path, which wraps the adapted
+  // callable in that carrier -- adapting here instead would drop the carrier the source declared.
+  const target = getCppPlainCallableTypeCpp(expectedType, context);
+  if (!target || target.typeParameters.length > 0 || target.parameters.some((parameter) => parameter.rest)) {
+    return undefined;
+  }
+  // A function DECLARATION's binding records no type of its own, so its own signature is the evidence --
+  // the same substitution the identifier evidence path makes where it needs one.
+  const declaration =
+    expression.kind === 'identifier' && expression.reference.kind === 'binding'
+      ? getCppFunctionDeclarationForBindingCpp(expression.reference.binding.id, context)
+      : undefined;
+  const sourceType =
+    getIrExpressionTypeEvidenceCpp(expression, context) ??
+    (declaration ? getIrFunctionDeclarationTypeCpp(declaration) : undefined);
+  if (sourceType?.kind !== 'function' || sourceType.typeParameters.length > 0) return undefined;
+  const restIndex = sourceType.parameters.findIndex((parameter) => parameter.rest);
+  if (restIndex !== -1 && restIndex !== sourceType.parameters.length - 1) return undefined;
+  // What the source REQUIRES is what the target has to be able to supply: a trailing optional parameter is
+  // one the source can be called without, so a target promising fewer arguments is still a faithful caller.
+  const requiredSourceParameters = sourceType.parameters.filter((parameter) => !parameter.optional).length;
+  if (requiredSourceParameters > target.parameters.length) {
+    emissionError(
+      context,
+      `a callable requiring ${String(requiredSourceParameters)} parameters cannot be stored where ${String(target.parameters.length)} are promised: it would be called with fewer arguments than it declares, and no adapter can supply them. Widen the source, or declare the target's callable with the parameters it needs`,
+      'cpp-callable-arity-narrowing-unrepresented',
+    );
+  }
+  if (sourceType.parameters.length === target.parameters.length) return undefined;
+  return emitCppContextualCallableUnionValueCpp(expression, sourceType, expectedType, context);
+}
