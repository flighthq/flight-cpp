@@ -0,0 +1,58 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/narrowed.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const prelude = `
+  interface ClipRegion { version: number }
+  interface Placement { characterId: number; depth: number }
+`;
+
+it('rebuilds a nested optional Map lookup into the three-state dual-sentinel carrier', () => {
+  const output = emit(`${prelude}
+    export function f(clips: Map<Readonly<Placement>, ClipRegion | null>, key: Readonly<Placement>): ClipRegion | null {
+      const cached = clips.get(key);
+      if (cached !== undefined) return cached;
+      return null;
+    }
+  `);
+  // Outer absence is undefined; the stored null stays null; a present entry contributes its value.
+  expect(output).toContain('if (!lookup.has_value()) return std::variant<');
+  expect(output).toContain('std::in_place_type<flight::Undefined>, flight::undefined');
+  expect(output).toContain('if (!lookup.value().has_value()) return std::variant<');
+  expect(output).toContain('std::in_place_type<flight::Null>, flight::null');
+  expect(output).toContain('lookup.value().value()');
+});
+
+it('projects a value that still admits null into the narrowed optional carrier', () => {
+  const output = emit(`${prelude}
+    export function f(clips: Map<Readonly<Placement>, ClipRegion | null>, key: Readonly<Placement>): ClipRegion | null {
+      const cached = clips.get(key);
+      if (cached !== undefined) return cached;
+      return null;
+    }
+  `);
+  // The `!== undefined` guard leaves null reachable; the projection keeps it and never reads the
+  // value alternative out of a Null state.
+  expect(output).toContain('if (std::holds_alternative<flight::Null>(cached)) return {};');
+  expect(output).toContain('throw std::logic_error("narrowed union holds a sentinel the narrowing excluded")');
+  expect(output).toContain('std::optional<flight::Ref<ClipRegion>>{*present}');
+});
+
+it('keeps the direct value read when the narrowing removes every sentinel', () => {
+  const output = emit(`${prelude}
+    export function f(clips: Map<Readonly<Placement>, ClipRegion | null>, key: Readonly<Placement>): ClipRegion | null {
+      const cached = clips.get(key);
+      if (cached != null) return cached;
+      return null;
+    }
+  `);
+  expect(output).not.toContain('narrowed union holds a sentinel the narrowing excluded');
+});
