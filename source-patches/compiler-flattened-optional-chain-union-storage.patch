+// An optional chain over a nullable MULTI-ALTERNATIVE member is emitted as optional<payload-variant>:
+// the chain and the member both contribute absence, but a following nullish coalesce consumes either
+// sentinel and therefore needs only the present payload. The expression's source type still records
+// null and undefined separately as a dual-sentinel variant, which is not the carrier the optional-chain
+// emitter wrote. Describe the actual optional carrier here so a contextual `value ?? null` conversion
+// unwraps (or directly reuses) it instead of applying std::get_if to std::optional itself.
+//
+// The one-value case deliberately stays on the dual-sentinel path: optional-chain emission preserves its
+// null and undefined alternatives independently, as the dedicated optional-property tests require.
+function getCppFlattenedOptionalChainStoragePlanCpp(
+  expression: Readonly<IrExpression>,
+  valueType: Readonly<IrType>,
+  context: EmitContext,
+): ReturnType<typeof getCppUnionRepresentationPlan> | undefined {
+  if (expression.kind !== 'property' || !expression.optional || !expression.optionalChain) return undefined;
+  const union = getIrUnionTypeCpp(valueType, context, new Set());
+  const plan = union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  if (!plan || plan.valueSlots.length < 2) return undefined;
+  const payload = getCppNonNullableType(valueType, context, new Set());
+  return payload ? getCppImplicitAbsenceStoragePlanCpp(payload, context) : undefined;
+}
