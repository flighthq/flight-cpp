+++ b/packages/compiler-backend-cpp/src/cppNominalSubtypeMembership.test.ts
@@ -0,0 +1,35 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/nominalSubtypeMembership.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const states = `
+  export interface RenderState { allowSmoothing: boolean }
+  export interface WgpuRenderState extends RenderState { device: number }
+  export interface GlRenderState extends RenderState { gl: number }
+`;
+
+it('asks the allocation exact type when only a subtype declares the key', () => {
+  const output = emit(`${states}
+    export function isWgpu(state: RenderState): boolean { return 'device' in state; }
+  `);
+
+  expect(output).toContain('flight::has_own_named_property<flight::RowKey<"device">>(state)');
+  expect(output).not.toContain('"device" in state');
+});
+
+it('keeps a key no assignable type declares refused', () => {
+  expect(() =>
+    emit(`${states}
+      export function hasOther(state: RenderState): boolean { return 'other' in state; }
+    `),
+  ).toThrow(/"other" in receiver` probes a key flight::Ref<RenderState> does not declare/);
+});
