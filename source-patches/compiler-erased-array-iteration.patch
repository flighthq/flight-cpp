diff --git a/packages/compiler-backend-cpp/src/cppErasedArrayIteration.test.ts b/packages/compiler-backend-cpp/src/cppErasedArrayIteration.test.ts
new file mode 100644
index 0000000..d85afdd
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppErasedArrayIteration.test.ts
@@ -0,0 +1,68 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/erasedArrayIteration.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('iterates an erased array through the runtime array reads', () => {
+  const output = emit(`
+    export function countObjects(raw: unknown): number {
+      if (!Array.isArray(raw)) return 0;
+      let count = 0;
+      for (const entry of raw) {
+        if (entry === null) continue;
+        if (typeof entry === 'object') count++;
+      }
+      return count;
+    }
+  `);
+
+  expect(output).toContain('const auto for_of_source = raw;');
+  expect(output).toContain(
+    'for (double for_of_index = 0.0; for_of_index < static_cast<double>(for_of_source.array_size()); for_of_index += 1.0) {',
+  );
+  expect(output).toContain(
+    'auto entry = for_of_source.array_get(for_of_index).value_or(flight::Any(flight::undefined));',
+  );
+  expect(output).toContain('presence_operand.is_null()');
+  expect(output).toContain('entry.type_of()');
+  expect(output).not.toContain('for (auto entry : raw)');
+});
+
+it('keeps the range-for for a represented array and a non-erased element', () => {
+  const output = emit(`
+    export function visitUnknowns(raw: unknown[]): number {
+      let count = 0;
+      for (const entry of raw) {
+        if (entry === null) continue;
+        count++;
+      }
+      return count;
+    }
+    export function sum(numbers: number[]): number {
+      let total = 0;
+      for (const number of numbers) total += number;
+      return total;
+    }
+  `);
+
+  expect(output).toContain('for (auto entry : raw) {');
+  expect(output).toContain('for (auto number : numbers) {');
+  expect(output).not.toContain('array_size()');
+  expect(output).toContain('presence_operand.is_null()');
+});
