+// The view expression a recognized assertion local is initialized with. It holds the source
+// reference and its recorded row owner; nothing is copied, cast to a derived owner, or materialized.
+function getCppStructuralMemberViewInitializerCpp(
+  initializer: Readonly<IrExpression> | undefined,
+  context: EmitContext,
+): string | undefined {
+  if (initializer === undefined) return undefined;
+  const source = getCppStructuralMemberViewCastSourceCpp(initializer, context);
+  if (source === undefined || initializer.kind !== 'cast') return undefined;
+  context.includes.add('flight/structural_ref.hpp');
+  return `flight::StructuralMemberView<${emitType(source, context)}>(${emitExpression(initializer.expression, context)})`;
