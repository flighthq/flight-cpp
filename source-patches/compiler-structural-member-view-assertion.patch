+function collectCppStructuralMemberViewBindingIdsCpp(
+  module: Readonly<IrModule>,
+  context: EmitContext,
+): ReadonlySet<string> {
+  const candidates = new Set<string>();
+  analyzeIrModuleTraversal(module, {
+    variable(variable) {
+      if (!('binding' in variable) || variable.initializer === undefined) return;
+      if (getCppStructuralMemberViewCastSourceCpp(variable.initializer, context)) candidates.add(variable.binding.id);
+    },
+  });
+  if (candidates.size === 0) return candidates;
+  // The view is a READ-ONLY window onto the source object: it holds no writable cell and no carrier a
+  // caller could pass on. A binding is lowered only when every one of its uses is a member read, so a
+  // write to a member (assignment target) or any escape (argument, return, initializer, operand) keeps
+  // the function's existing refusal instead of emitting an invalid view use. Counting every reference
+  // of the binding against the references that appear as a property's object proves exactly that.
+  const references = new Map<string, number>();
+  const propertyObjects = new Map<string, number>();
+  const written = new Set<string>();
+  const bump = (counts: Map<string, number>, id: string) => counts.set(id, (counts.get(id) ?? 0) + 1);
+  const writtenBindingId = (target: Readonly<IrExpression>): string | undefined => {
+    let current = target;
+    while (current.kind === 'property') current = current.object;
+    return current.kind === 'identifier' &&
+      current.reference.kind === 'binding' &&
+      candidates.has(current.reference.binding.id)
+      ? current.reference.binding.id
+      : undefined;
+  };
+  analyzeIrModuleTraversal(module, {
+    expression(expression) {
+      if (
+        expression.kind === 'identifier' &&
+        expression.reference.kind === 'binding' &&
+        candidates.has(expression.reference.binding.id)
+      ) {
+        bump(references, expression.reference.binding.id);
+      }
+      if (
+        expression.kind === 'property' &&
+        expression.object.kind === 'identifier' &&
+        expression.object.reference.kind === 'binding' &&
+        candidates.has(expression.object.reference.binding.id)
+      ) {
+        bump(propertyObjects, expression.object.reference.binding.id);
+      }
