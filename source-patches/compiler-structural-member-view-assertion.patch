+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/structuralMemberView.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('reads an asserted interface local through the same owner member view', () => {
+  const output = emit(`
+    interface ResourceLoader { onProgress: number }
+    interface ResourceLoaderInternal extends ResourceLoader {
+      started: boolean;
+      total: number;
+      totalWeight: number;
+      weightLoaded: number;
+      loaded: number;
+      xs: number[];
+    }
+    export function progress(loader: ResourceLoader): number {
+      const internal = loader as ResourceLoaderInternal;
+      if (!internal.started) return 0;
+      let n = internal.total + internal.totalWeight;
+      for (const x of internal.xs) n += x;
+      return n + internal.xs.length + internal.loaded / internal.weightLoaded;
+    }
+  `);
+
+  // The local is the view, never a nominal reference to the asserted owner: no cast, no copy.
+  expect(output).toContain('auto internal = flight::StructuralMemberView<flight::Ref<ResourceLoader>>(loader);');
+  expect(output).not.toContain('flight::Ref<ResourceLoaderInternal> internal');
+  // No owner cast, no materialized replacement owner.
+  expect(output).not.toContain('static_cast<flight::Ref<ResourceLoaderInternal>>');
+  expect(output).not.toContain('structural_ref_cast');
+  // Every member read names its declared carrier and goes through the view's own named-cell read.
+  expect(output).toContain('(internal).read<bool>("started")');
+  expect(output).toContain('(internal).read<double>("total")');
+  expect(output).toContain('(internal).read<flight::Array<double>>("xs")->size()');
+  // Iteration is a range-for over the live member handle.
+  expect(output).toContain('for (auto x : (internal).read<flight::Array<double>>("xs"))');
+});
+
+it('keeps the refusal for an asserted local that escapes as a value', () => {
+  expect(() =>
+    emit(`
+      interface ResourceLoader { onProgress: number }
+      interface ResourceLoaderInternal extends ResourceLoader { started: boolean }
+      export function escape(loader: ResourceLoader): ResourceLoaderInternal {
+        const internal = loader as ResourceLoaderInternal;
+        return internal;
+      }
+    `),
+  ).toThrow(/no heritage to cast along|structural member view/);
+});
+
+it('keeps the refusal for an asserted local whose member is written', () => {
+  expect(() =>
+    emit(`
+      interface ResourceLoader { onProgress: number }
+      interface ResourceLoaderInternal extends ResourceLoader { started: boolean; total: number }
+      export function reset(loader: ResourceLoader): void {
+        const internal = loader as ResourceLoaderInternal;
+        internal.total = 0;
+      }
+    `),
+  ).toThrow(/no heritage to cast along|structural member view/);
+});
+
+it('reads a nullable reference member through both absence layers', () => {
+  const output = emit(`
+    interface ItemSignals { onItemComplete: number }
+    interface ResourceLoader { onProgress: number }
+    interface ResourceLoaderInternal extends ResourceLoader {
+      itemSignals: ItemSignals | null;
+    }
+    export function dispose(loader: ResourceLoader): number {
+      const internal = loader as ResourceLoaderInternal;
+      if (internal.itemSignals !== null) return internal.itemSignals.onItemComplete;
+      return 0;
+    }
+  `);
+  // The cell's own presence and the member's stored null are tested separately.
+  expect(output).toMatch(/member_view_read\.has_value\(\) && !member_view_read\.value\(\)\.has_value\(\)/);
+  // A reference member reaches its members through the present owner.
+  expect(output).toContain('read<std::optional<flight::Ref<ItemSignals>>>("itemSignals").value().value()->on_item_complete');
+});
+
+it('keeps the refusal when the asserted interface does not extend the source', () => {
+  expect(() =>
+    emit(`
+      interface ResourceLoader { onProgress: number }
+      interface Other { started: boolean }
+      export function bad(loader: ResourceLoader): number {
+        const other = loader as Other;
+        return other.started ? 1 : 0;
+      }
+    `),
+  ).toThrow(/no heritage to cast along/);
+});
