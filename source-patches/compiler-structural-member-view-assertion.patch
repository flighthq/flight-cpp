+// The interface declaration a named type names, wherever it was declared. Interfaces flatten into
+// independent C++ structs, so this declaration is the heritage evidence the member-view lowering
+// reads; a class, an unresolved import, or any other type yields undefined and keeps the refusal.
+function getCppInterfaceDeclarationCpp(
+  type: Readonly<IrType>,
+  context: EmitContext,
+  module: Readonly<IrModule> = context.module,
+): Readonly<IrInterfaceDeclaration> | undefined {
+  if (type.kind !== 'named' || type.reference.kind !== 'binding') return undefined;
+  const direct = context.directBindingOwners.get(type.reference.binding.id)?.declaration;
+  if (direct?.kind === 'interface') return direct;
+  const owner = getCppNamedTypeDeclarationOwnerCpp(type, module, context);
+  return owner?.declaration.kind === 'interface' ? owner.declaration : undefined;
+}
+
+// Whether the interface `derived` names reaches the interface `base` names through authored
+// `extends` edges. The identity is the EMITTED SPELLING, as in the class-heritage walk: a chain
+// that crosses a package boundary names its base with the declaring module's binding, while both
+// sides spell the same C++ type. This relation does not make one flattened owner a C++ base of the
+// other; it is the member evidence that lets the same owner be read through its base interface.
+function isCppInterfaceHeritageRelatedCpp(
+  derived: Readonly<IrType>,
+  base: Readonly<IrType>,
+  context: EmitContext,
+): boolean {
+  if (!getCppInterfaceDeclarationCpp(base, context)) return false;
+  const isolatedContext: EmitContext = { ...context, anonymousStructs: new Map(), includes: new Set<string>() };
+  const baseSpelling = emitType(base, isolatedContext);
+  const visited = new Set<string>();
+  const queue: Readonly<{ module: Readonly<IrModule>; type: Readonly<IrType> }>[] = [
+    { module: context.module, type: derived },
+  ];
+  while (queue.length > 0) {
+    const current = queue.pop();
+    if (current === undefined) continue;
+    const declaration = getCppInterfaceDeclarationCpp(current.type, context, current.module);
+    if (!declaration) continue;
+    if (visited.has(declaration.binding.id)) continue;
+    visited.add(declaration.binding.id);
+    if (emitType(current.type, isolatedContext) === baseSpelling) return true;
+    for (const heritage of declaration.extends) queue.push({ module: current.module, type: heritage });
+  }
+  return false;
+}
