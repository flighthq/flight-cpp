+// The source interface a member-view assertion names, when the assertion is representable without
+// copying or reinterpreting the owner: a cast between two interface declarations where the target
+// transitively extends the source. The view reads the SAME object's recorded cells, so exactly one
+// represented owner survives and every member read keeps its declared type and absence.
+function getCppStructuralMemberViewCastSourceCpp(
+  expression: Readonly<IrExpression>,
+  context: EmitContext,
+): Readonly<IrType> | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expression.kind !== 'cast') return undefined;
+  // The asserted value must be an EXISTING object handle, not a factory result: a factory allocated
+  // and returned the base owner itself, so the target's cells were never recorded on it and asserting
+  // them would read absence the construction never wrote. Only a reference that can carry the
+  // construction handle's recorded row is a member view.
+  if (expression.expression.kind !== 'identifier') return undefined;
+  const source = getIrExpressionTypeEvidenceCpp(expression.expression, context);
+  if (!source || isCppErasedDynamicValueTypeCpp(source)) return undefined;
+  if (isCppClassDeclarationCpp(source, context) || isCppClassDeclarationCpp(expression.type, context)) return undefined;
+  if (!getCppInterfaceDeclarationCpp(expression.type, context)) return undefined;
+  if (!getCppInterfaceDeclarationCpp(source, context)) return undefined;
+  if (!hasFlightReferenceRepresentationCpp(source, context)) return undefined;
+  return isCppInterfaceHeritageRelatedCpp(expression.type, source, context) ? source : undefined;
