+// The sentinels a conditional fallback can produce through a literal arm. `a ?? (c ? x : null)` is absent
+// when `a` is absent and `c` is false, but a conditional's own evidence is its first arm that has any, so the
+// `null` arm was dropped and the whole coalesce was taken as present: its result was built as the present
+// payload, a `nullptr` Ref wrapped as an engaged optional, and a later `if (t && t.width ...)` dereferenced it.
+// Only a literal `null` or `undefined` arm is counted -- it is the one arm with no evidence of its own to lose.
+function getCppConditionalAbsentArmTypesCpp(expression: Readonly<IrExpression>): readonly IrType[] {
+  if (expression.kind !== 'conditional') return [];
+  const arms = [expression.whenTrue, expression.whenFalse];
+  const types: IrType[] = [];
+  if (arms.some((arm) => arm.kind === 'literal' && arm.value === null)) types.push({ kind: 'null' });
+  if (
+    arms.some(
+      (arm) =>
+        arm.kind === 'undefinedValue' ||
+        (arm.kind === 'identifier' && arm.reference.kind === 'ambient' && arm.reference.name === 'undefined'),
+    )
+  ) {
+    types.push({ kind: 'undefined' });
+  }
+  return types;
+}
