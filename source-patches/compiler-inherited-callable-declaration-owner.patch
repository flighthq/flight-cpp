+// Source declarations, not emitted shape/name equivalence, decide which callable cell this is.
+function emit(
+  mode: 'direct' | 'barrel' | 'alias' | 'rebound' | 'alias-distinct' | 'distinct' | 'generic' | 'flattened' = 'direct',
+) {
+  const parameter =
+    mode === 'alias-distinct'
+      ? 'AliasA'
+      : mode === 'distinct'
+        ? 'A'
+        : mode === 'generic'
+          ? 'Box<A>'
+          : mode === 'alias'
+            ? 'Identity<RegistryAlias>'
+            : 'Registry';
+  const refined =
+    mode === 'alias-distinct' ? 'AliasB' : mode === 'distinct' ? 'B' : mode === 'generic' ? 'Box<B>' : undefined;
+  const sources = {
+    domain: `export enum Registry { First, Second }
+export interface Signals { count: number }
+export type AliasA = { marker: number };
+export type AliasB = { marker: number };
+export interface A { marker: number }
+export interface B { marker: number }
+export interface Box<T> { value: T }
+export type RegistryAlias = Registry;
+export type Identity<T> = T;`,
+    domainBarrel: `export * from './domain.ts';`,
+    base: `import type { ${mode === 'rebound' ? 'Registry as ReboundRegistry,' : 'Registry,'} Signals, A, B, AliasA, AliasB, Box, RegistryAlias, Identity } from './${mode === 'barrel' ? 'domainBarrel' : 'domain'}.ts';
+export interface Runtime { ${mode === 'flattened' ? 'mode: number | string;' : ''} callback: (((registry: ${mode === 'rebound' ? 'ReboundRegistry' : parameter}) => void) & { clear(): void; readonly signals: Signals }) | null }`,
+    baseBarrel: `export { type Runtime as RuntimeAlias } from './base.ts';`,
+    derived: `import type { ${mode === 'barrel' ? 'RuntimeAlias as Runtime' : 'Runtime'} } from './${mode === 'barrel' ? 'baseBarrel' : 'base'}.ts';
+import type { B, AliasB, Box, Signals } from './domain.ts';
+export interface GlRuntime extends Runtime { ${mode === 'flattened' ? 'mode: number;' : ''} ${refined ? `callback: (((registry: ${refined}) => void) & { clear(): void; readonly signals: Signals }) | null;` : ''} tag: number }`,
+  };
+  const moduleResolution: CompilerModuleResolutionPlan = {
+    schema: 'flight-compiler-module-resolution/1',
+    edges: Object.keys(sources).map((name) => ({
+      specifier: './' + name + '.ts',
+      target: { packageName: '@flighthq/callable-owner', source: 'packages/callable-owner/src/' + name + '.ts' },
+    })),
+  };
+  const lowered = lowerTypeScriptSources(
+    Object.entries(sources).map(([name, text]) => ({
