+// A callable object's type identity uses the declarations its named types denote, after generic alias
+// substitution. Inheritance introduces fresh import bindings for those SAME declarations; those importer
+// identities cannot make a second native owner for the inherited callable. Distinct native owner declarations and
+// distinct type arguments remain distinct. This changes only the semantic key, never the source IR.
+function hasCppAnonymousObjectInCallableAliasCpp(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(hasCppAnonymousObjectInCallableAliasCpp);
+  if (!value || typeof value !== 'object') return false;
+  const record = value as Record<string, unknown>;
+  return record['kind'] === 'object' || Object.values(record).some(hasCppAnonymousObjectInCallableAliasCpp);
+}
+
+function getCppCallableObjectDeclarationIdentityCpp(
+  value: unknown,
+  context: EmitContext,
+  aliases: ReadonlySet<string> = new Set(),
+  directObjects?: ReadonlySet<object>,
+): unknown {
+  // Only this callable's direct object part is emitted by this callable emitter. Other anonymous
+  // records have their own native-owner election; retain their raw key and package scope until that identity is proven.
+  const root = value as { kind?: string; types?: readonly unknown[] } | null;
+  const objects =
+    directObjects ??
+    new Set<object>(
+      root?.kind === 'intersection'
+        ? (root.types ?? []).flatMap((entry) =>
+            entry && typeof entry === 'object' && (entry as { kind?: string }).kind === 'object' ? [entry] : [],
+          )
+        : [],
+    );
+  if (Array.isArray(value))
+    return value.map((entry) => getCppCallableObjectDeclarationIdentityCpp(entry, context, aliases, objects));
+  if (!value || typeof value !== 'object') return value;
+  const record = value as Record<string, unknown>;
+  if (record['kind'] === 'object' && !objects.has(value)) {
+    return { nativeAnonymousPackage: context.module.packageName, anonymousType: value };
+  }
+  if (record['kind'] === 'named') {
+    const type = value as Readonly<IrTypeReference>;
+    if (type.reference.kind === 'binding' && type.reference.binding.kind !== 'typeParameter') {
+      const module = getCppNamedTypeBindingModuleCpp(type, context);
+      const owner = getCppNamedTypeDeclarationOwnerCpp(type, module, context);
+      if (owner?.declaration.kind === 'typeAlias') {
+        const key = `${getCppModuleIdentityKey(owner.module)}\0${owner.declaration.binding.id}\0${normalizeCompilerStructuralValueCanonical(type.typeArguments)}`;
+        if (!aliases.has(key)) {
+          const target = resolveIrTypeStructuralSubstitution(
+            owner.declaration.type,
+            createIrTypeParameterSubstitutionPlan(owner.declaration.typeParameters, type.typeArguments),
+          );
+          // A named object alias owns a native record. Equal fields do not make two such
+          // declarations the same native argument type; retain its declaration and instantiation.
+          if (hasCppAnonymousObjectInCallableAliasCpp(target)) {
+            return {
+              ...type,
+              reference: { ...type.reference, binding: owner.declaration.binding },
+              typeArguments: type.typeArguments.map((argument) =>
+                getCppCallableObjectDeclarationIdentityCpp(argument, context, aliases, objects),
+              ),
+            };
+          }
+          // Substituted arguments may name imports in the active inheritance-lowered module.
+          // Keep that context; every named reference still resolves through its own declaring module.
+          return getCppCallableObjectDeclarationIdentityCpp(target, context, new Set(aliases).add(key), objects);
+        }
+      } else if (
+        owner?.declaration.kind === 'interface' ||
+        owner?.declaration.kind === 'class' ||
+        owner?.declaration.kind === 'enum'
+      ) {
+        return {
+          ...type,
+          reference: { ...type.reference, binding: owner.declaration.binding },
+          typeArguments: type.typeArguments.map((argument) =>
+            getCppCallableObjectDeclarationIdentityCpp(argument, context, aliases, objects),
+          ),
+        };
+      }
+    }
+  }
+  return Object.fromEntries(
+    Object.entries(record).map(([key, entry]) => [
+      key,
+      getCppCallableObjectDeclarationIdentityCpp(entry, context, aliases, objects),
+    ]),
+  );
+}
