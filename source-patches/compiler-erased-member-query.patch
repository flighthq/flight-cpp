diff --git a/packages/compiler-backend-cpp/src/cppErasedMemberQuery.test.ts b/packages/compiler-backend-cpp/src/cppErasedMemberQuery.test.ts
new file mode 100644
index 0000000..040927c
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppErasedMemberQuery.test.ts
@@ -0,0 +1,46 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/erasedMemberQuery.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const adapter = 'export interface Adapter { adapt: () => void; cache: number; name: string }';
+
+it('asks the erased object, not the asserted declaration, for typeof of a member and for `in`', () => {
+  const output = emit(`${adapter}
+    export function isAdapter(value: unknown): boolean {
+      return typeof value === 'object' && value !== null &&
+        typeof (value as Adapter).adapt === 'function' && 'cache' in (value as Adapter);
+    }
+  `);
+
+  expect(output).toContain('flight::member_typeof(value, flight::String("adapt")) == flight::String("function")');
+  expect(output).toContain('flight::has_property(value, flight::String("cache"))');
+  expect(output).not.toContain('flight::String("function") == flight::String("function")');
+});
+
+it('answers `in` on a bare erased receiver, with a dynamic key too', () => {
+  const output = emit(`
+    export function hasKey(value: object, key: string): boolean { return key in value; }
+    export function hasName(value: unknown): boolean { return typeof value === 'object' && value !== null && 'name' in value; }
+  `);
+
+  expect(output).toContain('flight::has_property(value, flight::String("name"))');
+});
+
+it('registers each non-generic class prototype so erased queries see its methods', () => {
+  const output = emit(`
+    export class Reader { pos = 0; next(): number { return this.pos++; } get done(): boolean { return this.pos > 3; } }
+  `);
+
+  expect(output).toContain(
+    'inline const bool flight_class_prototype_Reader = flight::register_class_prototype<Reader>(flight::ClassPrototype{{"next"}, {"done"}, std::nullopt, false});',
+  );
+});
