+// The erased value a member query must ask: the receiver itself when it is held as `flight::Any`, or the
+// operand of an assertion (`value as T`) when that operand is. An assertion names a type the object is not
+// proven to have, so the question goes to the object, through the runtime's own-cell and prototype-chain
+// queries, rather than to the asserted declaration.
+function getCppErasedMemberReceiverCpp(
+  expression: Readonly<IrExpression>,
+  context: EmitContext,
+): Readonly<IrExpression> | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  const isErased = (candidate: Readonly<IrExpression>): boolean => {
+    const type = getIrExpressionTypeEvidenceCpp(candidate, context);
+    return type !== undefined && emitType(type, context) === 'flight::Any';
+  };
+  if (expression.kind === 'cast') return isErased(expression.expression) ? expression.expression : undefined;
+  return isErased(expression) ? expression : undefined;
