@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest';
+import ts from 'typescript';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const result = lowerTypeScriptSource(
+    ts.createSourceFile('/flight/packages/fixture/src/nullable.ts', source, ts.ScriptTarget.Latest, true),
+    { packageName: '@flighthq/fixture', upstreamDirectory: '/flight' },
+  );
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/fixture': { namespace: 'fixture', includePrefix: 'fixture' } },
+  }).contents;
+}
+
+describe('nullable indexed values and lazy nullish fallback', () => {
+  it('retains the original nullable easing selection and call', () => {
+    expect(() => emit(`
+      export type Easing = (alpha: number) => number;
+      export interface Track { segmentEasings: Array<Easing | null> | null; easing: Easing | null; }
+      export function sample(track: Readonly<Track>, i: number, time: number): number {
+        const easing = track.segmentEasings?.[i] ?? track.easing;
+        if (easing !== null) return easing(time);
+        return time;
+      }
+    `)).not.toThrow();
+  });
+  it('keeps a stored null distinct from an absent indexed value', () => {
+    expect(() => emit(`
+      export interface Values { values: Array<number | null> | null; }
+      export function kind(owner: Readonly<Values>, i: number): string {
+        const selected = owner.values?.[i];
+        if (selected === null) return 'null';
+        if (selected === undefined) return 'undefined';
+        return 'present';
+      }
+    `)).not.toThrow();
+  });
+  it('accepts readonly indexed values without acquiring mutable capability', () => {
+    expect(() => emit(`
+      export interface Values { values: readonly (number | null)[] | null; fallback: number | null; }
+      export function choose(owner: Readonly<Values>, i: number): number | null {
+        return owner.values?.[i] ?? owner.fallback;
+      }
+    `)).not.toThrow();
+  });
+  it('refuses an unindexable present receiver instead of inventing contextual evidence', () => {
+    expect(() => emit(`
+      export interface Values { values: Array<number | null> | number | null; fallback: number | null; }
+      export function choose(owner: Readonly<Values>, i: number): number | null {
+        return owner.values?.[i] ?? owner.fallback;
+      }
+    `)).toThrow();
+  });
+});
