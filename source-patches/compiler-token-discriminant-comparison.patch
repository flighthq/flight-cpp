+// A strict comparison between a union token and a String tests the token's String alternative, which is
+// the source's own discriminant: a stored null token and every non-string alternative mismatch, an equal
+// String matches, and a different String mismatches. Comparing the whole carrier with a String is what
+// C++ rejects (`optional<variant<...>> != String`), and a global operator or Any coercion would decide
+// comparisons the emitter already knows the alternative of. The operands are evaluated once, in source
+// order, and only their declared carriers are inspected -- no alternative is converted or dropped.
+function emitCppTokenStringDiscriminantComparisonCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'binary' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  if (expression.operator !== '!==' && expression.operator !== '===') return undefined;
+  const leftType = getIrExpressionTypeEvidenceCpp(expression.left, context);
+  const rightType = getIrExpressionTypeEvidenceCpp(expression.right, context);
+  const planFor = (type: Readonly<IrType> | undefined) => {
+    const union = type ? getIrUnionTypeCpp(type, context, new Set()) : undefined;
+    return union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  };
+  const isTokenPlan = (plan: ReturnType<typeof getCppUnionRepresentationPlan> | undefined): boolean =>
+    plan !== undefined &&
+    (plan.kind === 'optionalVariant' || plan.kind === 'dualSentinelVariant') &&
+    plan.valueSlots.filter((slot) => isIrStringTypeEvidenceCpp(slot.runtimeType)).length === 1;
+  // The string side may be a variable of string type or a string literal (the source's discriminant
+  // keys are both); anything else -- a nullable string, a template, an erased value -- keeps the
+  // ordinary comparison path rather than guessing what it means against a token.
+  const isStringOperand = (operand: Readonly<IrExpression>, type: Readonly<IrType> | undefined): boolean =>
+    isIrStringTypeEvidenceCpp(type) ||
+    (type?.kind === 'literal' && typeof type.value === 'string') ||
+    (operand.kind === 'literal' && typeof operand.value === 'string');
+  const leftPlan = planFor(leftType);
+  const rightPlan = planFor(rightType);
+  const tokenOnLeft = isTokenPlan(leftPlan) && isStringOperand(expression.right, rightType);
+  const tokenOnRight = !tokenOnLeft && isTokenPlan(rightPlan) && isStringOperand(expression.left, leftType);
+  if (!tokenOnLeft && !tokenOnRight) return undefined;
+  const plan = tokenOnLeft ? leftPlan : rightPlan;
+  if (!plan || (plan.kind !== 'optionalVariant' && plan.kind !== 'dualSentinelVariant')) return undefined;
+  const stringSlot = plan.valueSlots.find((slot) => isIrStringTypeEvidenceCpp(slot.runtimeType));
+  if (!stringSlot) return undefined;
+  // Generated names: the source may itself declare `token` or `key`, and a binding named after its own
+  // initializer would both shadow and fail to compile.
+  const tokenName = getGeneratedTargetName('tokenDiscriminant', context);
+  const keyName = getGeneratedTargetName('tokenDiscriminantKey', context);
+  const inspected = plan.kind === 'optionalVariant' ? `${tokenName}.value()` : tokenName;
+  const present = `std::holds_alternative<${stringSlot.targetType}>(${inspected}) && std::get<${stringSlot.targetType}>(${inspected}) == ${keyName}`;
+  const positive = plan.kind === 'optionalVariant' ? `${tokenName}.has_value() && ${present}` : present;
+  const decision = expression.operator === '===' ? positive : `!(${positive})`;
+  // Source order is left then right, each operand evaluated exactly once.
+  const tokenExpression = tokenOnLeft ? expression.left : expression.right;
+  const stringExpression = tokenOnLeft ? expression.right : expression.left;
+  const tokenBinding = `const auto& ${tokenName} = ${emitExpression(tokenExpression, context)};`;
+  const stringBinding = `const auto ${keyName} = ${emitExpression(stringExpression, context)};`;
+  const bindings = tokenOnLeft ? [tokenBinding, stringBinding] : [stringBinding, tokenBinding];
+  context.includes.add('optional');
+  context.includes.add('variant');
+  return `([&]() -> bool { ${bindings.join(' ')} return ${decision}; }())`;
+}
