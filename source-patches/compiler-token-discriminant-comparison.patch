   context: EmitContext,
diff --git a/packages/compiler-backend-cpp/src/cppTokenDiscriminantComparison.test.ts b/packages/compiler-backend-cpp/src/cppTokenDiscriminantComparison.test.ts
new file mode 100644
index 0000000..72aec64
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppTokenDiscriminantComparison.test.ts
@@ -0,0 +1,68 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const prelude = `
+  interface Matrix { a: number }
+  interface Texture { id: number }
+  export type Token = readonly number[] | Matrix | Texture | boolean | number | string | null;
+`;
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/tokenCompare.ts', prelude + source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('compares a token against a literal discriminant through its String alternative', () => {
+  const output = emit(`
+    export function f(commands: Token[], i: number): void { if (commands[i] !== 'beginFill') return; }
+  `);
+  expect(output).toContain('std::holds_alternative<flight::String>(');
+  expect(output).toContain('std::get<flight::String>(');
+  expect(output).toContain('== token_discriminant_key');
+  expect(output).toContain('!(token_discriminant.has_value()');
+});
+
+it('emits the positive form for strict equality', () => {
+  const output = emit(`
+    export function f(commands: Token[], i: number): void { if (commands[i] === 'beginFill') return; }
+  `);
+  expect(output).toContain('return token_discriminant.has_value()');
+  expect(output).not.toContain('!(token_discriminant.has_value()');
+});
+
+it('compares against a dynamic String without shadowing the source name', () => {
+  const output = emit(`
+    export function f(commands: Token[], i: number, key: string): void { if (commands[i] !== key) return; }
+  `);
+  expect(output).toContain('const auto token_discriminant_key = key;');
+  expect(output).not.toContain('const auto key = key;');
+});
+
+it('evaluates the string operand before the token when the source writes it first', () => {
+  const output = emit(`
+    export function f(commands: Token[], i: number, key: string): void { if (key !== commands[i]) return; }
+  `);
+  const key = output.indexOf('const auto token_discriminant_key');
+  const token = output.indexOf('const auto& token_discriminant');
+  expect(key).toBeGreaterThanOrEqual(0);
+  expect(token).toBeGreaterThan(key);
+});
+
+it('evaluates the token expression once', () => {
+  const output = emit(`
+    function tokenAt(commands: Token[], i: number): Token { return commands[i]; }
+    export function f(commands: Token[], i: number, key: string): void { if (tokenAt(commands, i) !== key) return; }
+  `);
+  expect(output.match(/token_at\(commands, i\)/gu)?.length).toBe(1);
+});
+
+it('leaves a comparison whose operands are not a union token and a String unchanged', () => {
+  const output = emit(`
+    export function f(a: number, b: number): boolean { return a !== b; }
+  `);
+  expect(output).not.toContain('holds_alternative');
+});
