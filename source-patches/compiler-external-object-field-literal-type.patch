@@ -167,6 +167,12 @@ export interface CppCompilerExternalBindingConstruction {
 }
 
 export interface CppCompilerExternalFieldBinding {
+  // The bound type an object literal written in this field constructs, when the profile knows it. With
+  // `sequence`, the field holds an array literal and each element is constructed as that type. A literal
+  // then becomes the bound type instead of an anonymous structural owner; any other value keeps its own
+  // evidence. The type must itself be a declared type-space binding.
+  readonly literalType?: string | undefined;
+  readonly sequence?: boolean | undefined;
