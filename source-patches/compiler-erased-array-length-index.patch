--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppErasedArrayLengthIndex.test.ts
@@ -0,0 +1,87 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/erasedArrayLengthIndex.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('reads length and elements through the runtime array accessors after an is_array guard', () => {
+  const output = emit(`
+    export function lengthOf(raw: unknown): number {
+      if (!Array.isArray(raw)) return 0;
+      return raw.length;
+    }
+    export function firstOf(raw: unknown): unknown {
+      if (!Array.isArray(raw)) return undefined;
+      return raw[0];
+    }
+  `);
+
+  expect(output).toContain('static_cast<double>(raw.array_size())');
+  expect(output).toContain('array_get(erased_array_index).value_or(flight::Any(flight::undefined))');
+  expect(output).not.toContain('get(flight::String("length"))');
+});
+
+it('proves the array through a compound disjunction guard, including its short-circuited length test', () => {
+  const output = emit(`
+    export function countSections(raw: unknown): number {
+      if (!Array.isArray(raw) || raw.length === 0) return 0;
+      return raw.length;
+    }
+  `);
+
+  // The right operand of `||` runs only when `!Array.isArray(raw)` was false, so its own length test
+  // is under the proof too; the post-guard read is the second one.
+  expect(output.match(/static_cast<double>\(raw\.array_size\(\)\)/g)).toHaveLength(2);
+  expect(output).not.toContain('get(flight::String("length"))');
+});
+
+it('proves the array across a continue guard, and withdraws the proof on assignment', () => {
+  const output = emit(`
+    export function guardedContinue(items: unknown[]): number {
+      let total = 0;
+      for (const item of items) {
+        if (!Array.isArray(item)) continue;
+        total += item.length;
+      }
+      return total;
+    }
+    export function reassigned(raw: unknown): number {
+      if (!Array.isArray(raw)) return 0;
+      raw = { a: 1 };
+      return (raw as Record<string, unknown>).length as number;
+    }
+  `);
+
+  expect(output).toContain('static_cast<double>(item.array_size())');
+  expect(output).toContain('named_properties(raw).get(flight::String("length"))');
+});
+
+it('keeps dynamic named reads when no array guard proves the receiver', () => {
+  const output = emit(`
+    export function dynamicLength(record: Record<string, unknown>): unknown {
+      return record.length;
+    }
+    export function dynamicIndex(record: Record<string, unknown>): unknown {
+      return record["a"];
+    }
+  `);
+
+  expect(output).toContain('get(flight::String("length"))');
+  expect(output).not.toContain('array_size()');
+  expect(output).not.toContain('array_get(');
+});
