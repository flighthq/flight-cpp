diff --git a/packages/compiler-backend-cpp/src/cppHostTimerLocalStorage.test.ts b/packages/compiler-backend-cpp/src/cppHostTimerLocalStorage.test.ts
new file mode 100644
index 0000000..d26cd6b
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppHostTimerLocalStorage.test.ts
@@ -0,0 +1,88 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// A host timer stored in a local. The library declaration is the only type evidence a local has when the
+// source writes no annotation, and the DOM's `setInterval` returns `number` -- the numeric token the
+// target's own timer contract forbids. The binding's `callResultType` is what the emitted call actually
+// returns, so it is what the local must be declared as.
+const domTimers = `
+  type ReturnType<T extends (...args: any) => any> = T extends (...args: any) => infer R ? R : any;
+  declare function setInterval(handler: () => void, timeout?: number): number;
+  declare function clearInterval(id: number | undefined): void;
+  declare function now(): number;
+`;
+
+const timerBindings = {
+  bindings: [
+    {
+      callResultType: 'host::TimerHandle',
+      headers: ['host/timer.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'borrowed' as const,
+      sourceName: 'setInterval',
+      space: 'value' as const,
+      targetName: 'host::set_interval',
+    },
+    {
+      headers: ['host/timer.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'borrowed' as const,
+      sourceName: 'clearInterval',
+      space: 'value' as const,
+      targetName: 'host::clear_interval',
+    },
+    {
+      headers: ['host/clock.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'borrowed' as const,
+      sourceName: 'now',
+      space: 'value' as const,
+      targetName: 'host::now',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(source: string, externalBindings?: typeof timerBindings): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/log/src/Timers.ts',
+    domTimers + source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/log', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(lowered.module, { externalBindings, runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe('a bound host timer stored in a local', () => {
+  it('declares the local as the binding result carrier rather than the library numeric token', () => {
+    const contents = emit(
+      `export function every(tick: () => void, ms: number): void {
+         const id = setInterval(tick, ms);
+         clearInterval(id);
+       }`,
+      timerBindings,
+    );
+    expect(contents).toContain('host::TimerHandle id = host::set_interval(tick, ms)');
+    expect(contents).toContain('host::clear_interval(id)');
+    expect(contents).not.toContain('double id');
+  });
+
+  it('keeps a local the binding does not name on its declared numeric domain', () => {
+    const contents = emit(
+      `export function elapsed(): number {
+         const started = now();
+         return started;
+       }`,
+      timerBindings,
+    );
+    // `now` has no callResultType, so its library result stands: the local stays a double and no host
+    // handle is invented for it.
+    expect(contents).toContain('const double started = host::now()');
+    expect(contents).not.toContain('TimerHandle started');
+  });
+});
