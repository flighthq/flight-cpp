--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppPrimitiveRecordNullishStorage.test.ts
@@ -0,0 +1,126 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import ts from 'typescript';
+
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const toolchain = findCppCompilerToolchain();
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+const source = `
+  export interface Holder { color: string }
+  export function named(values: Record<string, string>): string { return values.color ?? 'fallback'; }
+  export function nested(first: string | null, values: Record<string, string>): string { return first ?? values['color'] ?? 'fallback'; }
+  export function optional(first: Holder | undefined, values: Record<string, string>): string { return first?.color ?? values['color'] ?? 'fallback'; }
+  export function indexed(values: Record<string, string>): string { return values['color'] ?? 'fallback'; }
+  export function numeric(values: Record<string, number>): number { return values.count ?? 7; }
+  export function flag(values: Record<string, boolean>): boolean { return values.ready ?? true; }
+  export function local(first: string | null, values: Record<string, string>): string {
+    const selected = first ?? values['color']; return selected ?? 'fallback';
+  }
+  let trace = 0;
+  function receiver(values: Record<string, string>): Record<string, string> { trace = trace * 10 + 1; return values; }
+  function key(fail: boolean): string { trace = trace * 10 + 2; if (fail) throw 7; return 'color'; }
+  function fallback(): string { trace = trace * 10 + 3; return 'fallback'; }
+  export function ordered(values: Record<string, string>, fail: boolean): string {
+    trace = 0; return receiver(values)[key(fail)] ?? fallback();
+  }
+  export function readTrace(): number { return trace; }
+  export function nestedOrdered(first: string | null, values: Record<string, string>): string {
+    trace = 0; return first ?? receiver(values)[key(false)] ?? fallback();
+  }
+  type ReadDictionary = Readonly<Record<string, string>>;
+  export function readonlyNamed(values: ReadDictionary): string { return values.color ?? 'fallback'; }
+  function classify(value: string | null | undefined): number {
+    if (value === undefined) return 1;
+    if (value === null) return 2;
+    return value.length === 0 ? 3 : 4;
+  }
+  export function indexedArgument(values: Record<string, string>): number { return classify(values['color']); }
+  export function namedArgument(values: Record<string, string>): number { return classify(values.color); }
+  export function nullArgument(): number { return classify(null); }
+`;
+
+function emit(text = source): string {
+  const [result] = lowerTypeScriptSources([
+    {
+      packageName: '@flighthq/math',
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/math/src/recordDelete.ts', text, ts.ScriptTarget.Latest, true),
+    },
+  ]);
+  expect(result!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result!.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe('primitive Record nullish storage', () => {
+  it.skipIf(!toolchain || !includes.length)(
+    'retains dictionary absence and original present primitive values through named and nested coalesces',
+    () => {
+      if (!toolchain) throw new Error('toolchain missing');
+      const directory = mkdtempSync(path.join(tmpdir(), 'flight-record-nullish-'));
+      try {
+        const input = path.join(directory, 'record.cpp');
+        const binary = path.join(directory, getCppExecutableName(toolchain, 'record'));
+        writeFileSync(
+          input,
+          emit() +
+            `
+int main() {
+  namespace fixture = flighthq_math;
+  using flight::String;
+  flight::Record<String, String> empty;
+  if (fixture::named(empty) != String("fallback") || fixture::nested(std::nullopt, empty) != String("fallback") ||
+      fixture::optional(std::nullopt, empty) != String("fallback") || fixture::indexed(empty) != String("fallback")) return 1;
+  flight::Record<String, String> present{{String("color"), String("")}};
+  if (fixture::named(present) != String("") || fixture::nested(std::nullopt, present) != String("") ||
+      fixture::nested(String("first"), present) != String("first")) return 2;
+  auto holder = flight::make_ref<fixture::Holder>(fixture::Holder{.color = String("owner")});
+  if (fixture::optional(holder, present) != String("owner")) return 3;
+  flight::Record<String, double> numbers{{String("count"), -0.0}};
+  if (!std::signbit(fixture::numeric(numbers))) return 4;
+  numbers.set(String("count"), std::numeric_limits<double>::quiet_NaN());
+  if (!std::isnan(fixture::numeric(numbers))) return 5;
+  numbers.erase(String("count")); if (fixture::numeric(numbers) != 7) return 6;
+  flight::Record<String, bool> flags{{String("ready"), false}};
+  if (fixture::flag(flags)) return 7;
+  flags.erase(String("ready")); if (!fixture::flag(flags)) return 8;
+  if (fixture::local(std::nullopt, empty) != String("fallback") || fixture::local(std::nullopt, present) != String("")) return 9;
+  if (fixture::ordered(empty, false) != String("fallback") || fixture::read_trace() != 123 ||
+      fixture::ordered(present, false) != String("") || fixture::read_trace() != 12) return 10;
+  if (fixture::indexed_argument(empty) != 1 || fixture::named_argument(empty) != 1 ||
+      fixture::indexed_argument(present) != 3 || fixture::named_argument(present) != 3 || fixture::null_argument() != 2) return 13;
+  if (fixture::nested_ordered(String("first"), empty) != String("first") || fixture::read_trace() != 0 ||
+      fixture::nested_ordered(std::nullopt, present) != String("") || fixture::read_trace() != 12 ||
+      fixture::nested_ordered(std::nullopt, empty) != String("fallback") || fixture::read_trace() != 123 ||
+      fixture::readonly_named(empty) != String("fallback") || fixture::readonly_named(present) != String("")) return 14;
+  try { fixture::ordered(present, true); }
+  catch (double error) { return error == 7 && fixture::read_trace() == 12 ? 0 : 11; }
+  return 12;
+}
+`,
+        );
+        execFileSync(toolchain.command, createCppExecutableArguments(toolchain, input, binary, includes), {
+          encoding: 'utf8',
+          stdio: 'pipe',
+        });
+        execFileSync(binary, [], { encoding: 'utf8', stdio: 'pipe' });
+      } finally {
+        rmSync(directory, { recursive: true, force: true });
+      }
+    },
+    120000,
+  );
+});
