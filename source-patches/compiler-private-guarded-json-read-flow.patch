+function emit(source: string): string {
+  const file = ts.createSourceFile('/flight/packages/example/src/guardedJson.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(file, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+function attempt(source: string): { output?: string; rule?: string } {
+  try { return { output: emit(source) }; }
+  catch (error) {
+    if (typeof error !== 'object' || error === null || !('kind' in error) || error.kind !== 'backend-emission' || !('backend' in error) || error.backend !== 'cpp') throw error;
+    return { rule: 'rule' in error ? String(error.rule) : 'code' in error ? String(error.code) : 'backend-emission' };
+  }
+}
