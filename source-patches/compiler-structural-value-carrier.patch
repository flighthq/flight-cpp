@@ -0,0 +1,156 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { createCppCompilerBackend, emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// A narrowed derived-interface value may be any object declaring that type's members, not only one
+// allocated as it (render-wgpu's screen target binder: `if (isWgpuScreenRenderTarget(target))`). At the
+// declared sites of a `structuralValueCarriers` entry the value is carried as the same object through
+// flight::NominalOrStructuralView. The sites are parameters, fields (including a Pick alias of a declared
+// field), and callback parameters. Member reads, writes and optional calls on a carried value go through
+// the carrier by RowKey; a narrowed base reference entering a site is wrapped with `of`; a local initialized
+// from a carried value is carried. Every undeclared site keeps the nominal owner.
+const source = `export interface Ctx { id: number }
+export interface Target { context: Ctx | null; width: number }
+export interface Screen extends Target { readonly context: Ctx; presentationView: number | null; encodeCapture: ((target: Screen, n: number) => void) | null }
+export interface Runtime { frame: Screen | null }
+export function isScreen(t: Readonly<Target>): t is Screen { return t.context !== null; }
+export function bindScreen(t: Screen): number { if (t.presentationView === null) t.presentationView = 7; return t.presentationView; }
+export function endFrame(t: Screen): void { t.presentationView = null; }
+export function destroyScreen(t: Screen): void { t.presentationView = null; }
+export function bind(r: Runtime, t: Target): number { if (isScreen(t)) { const v = bindScreen(t); r.frame = t as Screen; return v; } return 0; }
+export function submit(r: Runtime): void { const screen = r.frame; if (screen !== null) { screen.encodeCapture?.(screen, 1); } if (screen !== null) endFrame(screen); r.frame = null; }
+export type Saved = Pick<Runtime, 'frame'>;
+export function saved(r: Runtime): Saved { return { frame: r.frame }; }
+`;
+
+const carrier = 'flight::NominalOrStructuralView<Screen, Target>';
+const carriers = [
+  {
+    base: 'Target',
+    callbackParameters: [{ field: 'encodeCapture', owner: 'Screen', position: 0 }],
+    fields: [
+      { field: 'frame', owner: 'Runtime' },
+      { field: 'frame', owner: 'Saved' },
+    ],
+    nominal: 'Screen',
+    parameters: [
+      { function: 'bindScreen', parameter: 't' },
+      { function: 'endFrame', parameter: 't' },
+    ],
+    target: carrier,
+  },
+];
+
+function emit(body: string, structuralValueCarriers: typeof carriers = carriers) {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/carrier.ts', body, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, {
+    runtimeProfile: 'flight-cpp',
+    ...(structuralValueCarriers.length > 0 ? { structuralValueCarriers } : {}),
+  }).contents;
+}
+
+describe('declared structural-value carrier sites', () => {
+  const contents = emit(source);
+
+  it('carries the declared parameters and reads and writes their members by RowKey', () => {
+    expect(contents).toContain(`inline double bind_screen(${carrier} t) {`);
+    expect(contents).toContain(
+      'if (!t.template read_optional<flight::RowKey<"presentationView">, std::optional<double>, &Screen::presentation_view>().has_value()) {',
+    );
+    expect(contents).toContain(
+      't.template write<flight::RowKey<"presentationView">, std::optional<double>, &Screen::presentation_view>(std::optional<double>{7.0});',
+    );
+    expect(contents).toContain(
+      'return t.template read_optional<flight::RowKey<"presentationView">, std::optional<double>, &Screen::presentation_view>().value();',
+    );
+    expect(contents).toContain(`inline void end_frame(${carrier} t) {`);
+  });
+
+  it('wraps the narrowed base reference as the same object where it enters a site', () => {
+    expect(contents).toContain(`const double v = bind_screen(${carrier}::of(t));`);
+    expect(contents).toContain(`(r->frame = ${carrier}::of(t));`);
+  });
+
+  it('carries a declared field, its Pick alias, and the callback parameter', () => {
+    expect(contents).toContain(`struct Runtime : public flight::ReferenceEnabled {\n  std::optional<${carrier}> frame;`);
+    expect(contents).toContain(`struct Saved : public flight::ReferenceEnabled {\n  std::optional<${carrier}> frame;`);
+    expect(contents).toContain(`std::optional<std::function<void(${carrier}, double)>> encode_capture;`);
+  });
+
+  it('carries a local initialized from a carried field, through presence narrowing and an optional call', () => {
+    expect(contents).toContain('auto screen = r->frame;');
+    expect(contents).toContain(
+      `auto optional_chain_receiver = screen.value().template read_optional<flight::RowKey<"encodeCapture">, std::optional<std::function<void(${carrier}, double)>>, &Screen::encode_capture>(); if (!optional_chain_receiver.has_value()) return; optional_chain_receiver.value()(screen.value(), 1.0);`,
+    );
+    expect(contents).toContain('end_frame(screen.value());');
+  });
+
+  it('keeps every undeclared site on the nominal owner', () => {
+    expect(contents).toContain('inline void destroy_screen(flight::Ref<Screen> t) {');
+    expect(contents).toContain('(t->presentation_view = std::nullopt);');
+    // Without a declared carrier nothing changes: the nominal owner is emitted, and the narrowed escape keeps
+    // the reference-assertion refusal it had.
+    const withoutBinder = source.split('\n').filter((line) => !/function (bind|submit|saved)\(|type Saved/u.test(line)).join('\n');
+    const nominal = emit(withoutBinder, []);
+    expect(nominal).not.toContain('NominalOrStructuralView');
+    expect(nominal).toContain('inline double bind_screen(flight::Ref<Screen> t) {');
+    let rule: string | undefined;
+    try {
+      emit(source, []);
+    } catch (error) {
+      if (isBackendEmissionFailure(error)) rule = error.rule;
+      else throw error;
+    }
+    expect(rule).toBe('cpp-reference-assertion-without-heritage');
+  });
+
+  it('carries a Readonly spelling of the nominal at a declared parameter and callback parameter', () => {
+    const readonlySource = source
+      .replace('encodeCapture: ((target: Screen, n: number) => void) | null', 'encodeCapture: ((target: Readonly<Screen>, n: number) => void) | null')
+      .replace('export function endFrame(t: Screen): void { t.presentationView = null; }', 'export function endFrame(t: Readonly<Screen>): number | null { return t.presentationView; }')
+      .replace('if (screen !== null) endFrame(screen);', 'if (screen !== null) { endFrame(screen); screen.presentationView = null; }');
+    const readonlyContents = emit(readonlySource);
+    expect(readonlyContents).toContain(`std::optional<std::function<void(${carrier}, double)>> encode_capture;`);
+    expect(readonlyContents).toContain(`inline std::optional<double> end_frame(${carrier} t) {`);
+    expect(readonlyContents).toContain('end_frame(screen.value());');
+  });
+
+  it('carries the declared sites in a salvaged module whose other declaration is refused', () => {
+    // A module with one refused declaration is emitted by salvage. Its retained declarations must be the
+    // same carrier-rewritten ones a whole module emits, or its carried sites disagree with the rewritten
+    // fields around them.
+    const body = `${source}export function grow(r: Runtime): void { const s = r.frame; if (s !== null) s.presentationView ??= 1; }`;
+    const sourceFile = ts.createSourceFile('/flight/packages/math/src/carrier.ts', body, ts.ScriptTarget.Latest, true);
+    const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+    expect(lowered.diagnostics).toEqual([]);
+    const session = createCppCompilerBackend().createEmissionSession!({
+      modules: [lowered.module],
+      options: { runtimeProfile: 'flight-cpp', structuralValueCarriers: carriers },
+    });
+    const salvaged = session.emitRefusalPlaceholder!(lowered.module, {
+      message: 'a compound write to a carried member',
+      rule: 'cpp-structural-value-carrier-compound-write',
+    })!.contents;
+    expect(salvaged).toContain('NOT GENERATED: function grow');
+    expect(salvaged).toContain(`inline double bind_screen(${carrier} t) {`);
+    expect(salvaged).toContain(`(r->frame = ${carrier}::of(t));`);
+    expect(salvaged).toContain(`std::optional<std::function<void(${carrier}, double)>> encode_capture;`);
+  });
+
+  it('refuses a compound write to a carried member', () => {
+    let rule: string | undefined;
+    try {
+      emit(`${source}export function bump(t: Screen): void {}\nexport function grow(r: Runtime): void { const s = r.frame; if (s !== null) s.presentationView ??= 1; }`);
+    } catch (error) {
+      if (isBackendEmissionFailure(error)) rule = error.rule;
+      else throw error;
+    }
+    expect(rule).toBe('cpp-structural-value-carrier-compound-write');
+  });
+});
