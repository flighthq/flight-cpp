+import type {
+  CppCompilerBackendOptions,
+  CppCompilerExternalBindingManifest,
+  CppCompilerStructuralValueCarrier,
+  IrDeclaration,
+  IrModule,
+  IrObjectTypeProperty,
+  IrType,
+  IrTypeReference,
+} from '../../compiler-types/src/index.js';
+
+// A value of a derived interface type that may be ANY object declaring that type's members, not only one
+// allocated as it -- the source admits it wherever a user predicate narrows the base (render-wgpu's screen
+// target). Such a value has no faithful `Ref<Nominal>`, so at an explicitly declared set of sites the
+// emitter carries it in a runtime view instead (flight::NominalOrStructuralView). The sites are declared,
+// never inferred: each one is a parameter, a field, or a callback parameter that the narrowed value flows
+// into, and every other use of the type keeps its nominal owner.
+//
+// The mechanism is a type substitution before emission. Each declared site's occurrence of the nominal type
+// becomes a synthetic ambient type bound to the carrier as an external value type, so every existing type
+// path -- parameters, fields, unions with null, callback signatures, and Pick or indexed reads of a declared
+// field -- spells the carrier with no special case. Member access on a carrier receiver is lowered to the
+// carrier's checked read and write (see the C++ backend).
+
+const cppStructuralValueCarrierPrefix = '__flight_structural_value_carrier__';
+
+export interface CppStructuralValueCarrierPlan {
+  readonly carrier: Readonly<CppCompilerStructuralValueCarrier>;
+  // The nominal type as the source names it, used to resolve member types on a carrier receiver.
+  readonly nominal: Readonly<IrTypeReference>;
+  readonly sourceName: string;
+}
+
+export interface CppStructuralValueCarrierRewrite {
+  readonly modules: readonly Readonly<IrModule>[];
+  readonly options: Readonly<CppCompilerBackendOptions>;
+  readonly original: ReadonlyMap<Readonly<IrModule>, Readonly<IrModule>>;
+  readonly plans: ReadonlyMap<string, Readonly<CppStructuralValueCarrierPlan>>;
+}
+
+// The plans of one rewrite, keyed by the options object the rewrite returned, which is the object every
+// module of that emission receives as its options.
+const cppStructuralValueCarrierPlans = new WeakMap<object, ReadonlyMap<string, Readonly<CppStructuralValueCarrierPlan>>>();
+
+export function getCppStructuralValueCarrierPlanCpp(
+  options: Readonly<CppCompilerBackendOptions>,
+  type: Readonly<IrType> | undefined,
+): Readonly<CppStructuralValueCarrierPlan> | undefined {
+  if (type?.kind !== 'named' || type.reference.kind !== 'ambient') return undefined;
+  return cppStructuralValueCarrierPlans.get(options)?.get(type.reference.name);
+}
+
+export function getCppStructuralValueCarrierSourceNameCpp(nominal: string): string {
+  return `${cppStructuralValueCarrierPrefix}${nominal}`;
+}
+
+export function isCppStructuralValueCarrierSourceNameCpp(name: string): boolean {
+  return name.startsWith(cppStructuralValueCarrierPrefix);
+}
+
+function isNominalReference(type: Readonly<IrType>, nominal: string): type is Readonly<IrTypeReference> {
+  return (
+    type.kind === 'named' &&
+    type.reference.kind === 'binding' &&
+    type.reference.path.length === 0 &&
+    type.reference.binding.name === nominal &&
+    type.typeArguments.length === 0
+  );
+}
+
+// `Readonly<Nominal>` at a declared site is the same carried value: the source cannot write through it, so
+// carrying it as the writable view admits nothing the checker did not already reject.
+function carriedNominalReference(type: Readonly<IrType>, nominal: string): Readonly<IrTypeReference> | undefined {
+  if (
+    type.kind === 'named' &&
+    type.reference.kind === 'ambient' &&
+    type.reference.name === 'Readonly' &&
+    type.typeArguments.length === 1 &&
+    isNominalReference(type.typeArguments[0]!, nominal)
+  ) {
+    return type.typeArguments[0] as Readonly<IrTypeReference>;
+  }
+  return isNominalReference(type, nominal) ? type : undefined;
+}
+
+// Replaces the nominal type at ONE declared site: the type itself, or its member of a union with absence.
+function substitute(
+  type: Readonly<IrType>,
+  nominal: string,
+  found: (reference: Readonly<IrTypeReference>) => void,
+): Readonly<IrType> {
+  const synthetic: Readonly<IrType> = {
+    kind: 'named',
+    reference: { kind: 'ambient', name: getCppStructuralValueCarrierSourceNameCpp(nominal) },
+    typeArguments: [],
+  };
+  const carried = carriedNominalReference(type, nominal);
+  if (carried) {
+    found(carried);
+    return synthetic;
+  }
+  if (type.kind === 'union') {
+    let changed = false;
+    const types = type.types.map((member) => {
+      const reference = carriedNominalReference(member, nominal);
+      if (!reference) return member;
+      found(reference);
+      changed = true;
+      return synthetic;
+    });
+    return changed ? ({ ...type, types } as unknown as Readonly<IrType>) : type;
+  }
+  return type;
+}
+
+// A declared FIELD site's present payload is, by declaration, the carried value, however the field's type
+// was spelled once a mapped type such as Pick expanded it. Exactly one present member is required; anything
+// else is not a single carried value and is left alone.
+function substituteFieldPayload(
+  type: Readonly<IrType>,
+  nominal: string,
+  found: (reference: Readonly<IrTypeReference>) => void,
+): Readonly<IrType> {
+  const named = substitute(type, nominal, found);
+  if (named !== type) return named;
+  const synthetic: Readonly<IrType> = {
+    kind: 'named',
+    reference: { kind: 'ambient', name: getCppStructuralValueCarrierSourceNameCpp(nominal) },
+    typeArguments: [],
+  };
+  const isAbsent = (member: Readonly<IrType>) => member.kind === 'null' || member.kind === 'undefined';
+  if (type.kind === 'object') return synthetic;
+  if (type.kind !== 'union') return type;
+  const present = type.types.filter((member) => !isAbsent(member));
+  if (present.length !== 1 || present[0]!.kind !== 'object') return type;
+  return { ...type, types: type.types.map((member) => (isAbsent(member) ? member : synthetic)) } as unknown as Readonly<IrType>;
+}
+
+function substituteCallbackParameter(
+  type: Readonly<IrType>,
+  position: number,
+  nominal: string,
+  found: (reference: Readonly<IrTypeReference>) => void,
+): Readonly<IrType> {
+  if (type.kind === 'function') {
+    const parameter = type.parameters[position];
+    if (!parameter) return type;
+    const parameters = type.parameters.map((candidate, index) =>
+      index === position ? { ...candidate, type: substitute(candidate.type, nominal, found) } : candidate,
+    );
+    return { ...type, parameters } as Readonly<IrType>;
+  }
+  if (type.kind === 'union') {
+    return {
+      ...type,
+      types: type.types.map((member) => substituteCallbackParameter(member, position, nominal, found)),
+    } as unknown as Readonly<IrType>;
+  }
+  return type;
+}
+
+function matchesPackage(site: Readonly<{ package?: string | undefined }>, module: Readonly<IrModule>): boolean {
+  return site.package === undefined || site.package === module.packageName;
+}
+
+export function applyCppStructuralValueCarriersCpp(
+  modules: readonly Readonly<IrModule>[],
+  options: Readonly<CppCompilerBackendOptions>,
+): CppStructuralValueCarrierRewrite {
+  const carriers = options.structuralValueCarriers ?? [];
+  if (carriers.length === 0) {
+    return { modules, options, original: new Map(modules.map((module) => [module, module])), plans: new Map() };
+  }
+  const nominals = new Map<string, Readonly<IrTypeReference>>();
+  const original = new Map<Readonly<IrModule>, Readonly<IrModule>>();
+  const rewritten = modules.map((module) => {
+    const declarations = module.declarations.map((declaration): IrDeclaration => {
+      let next: IrDeclaration = declaration;
+      for (const carrier of carriers) {
+        const found = (reference: Readonly<IrTypeReference>) => {
+          if (!nominals.has(carrier.nominal)) nominals.set(carrier.nominal, reference);
+        };
+        if (next.kind === 'function') {
+          const functionName = next.binding.name;
+          const site = (carrier.parameters ?? []).filter(
+            (candidate) => candidate.function === functionName && matchesPackage(candidate, module),
+          );
+          if (site.length > 0) {
+            const names = new Set(site.map((candidate) => candidate.parameter));
+            const fn = next;
+            next = {
+              ...fn,
+              parameters: fn.parameters.map((parameter) =>
+                names.has(parameter.binding.name)
+                  ? { ...parameter, type: substitute(parameter.type, carrier.nominal, found) }
+                  : parameter,
+              ),
+            };
+          }
+        }
+        if (next.kind === 'interface') {
+          const owner = next.binding.name;
+          const fields = new Set(
+            (carrier.fields ?? [])
+              .filter((candidate) => candidate.owner === owner && matchesPackage(candidate, module))
+              .map((candidate) => candidate.field),
+          );
+          const callbacks = (carrier.callbackParameters ?? []).filter(
+            (candidate) => candidate.owner === owner && matchesPackage(candidate, module),
+          );
+          if (fields.size > 0 || callbacks.length > 0) {
+            const iface = next;
+            next = {
+              ...iface,
+              properties: iface.properties.map((property): IrObjectTypeProperty => {
+                let type = property.type;
+                if (fields.has(property.name)) type = substitute(type, carrier.nominal, found);
+                for (const callback of callbacks) {
+                  if (callback.field === property.name) {
+                    type = substituteCallbackParameter(type, callback.position, carrier.nominal, found);
+                  }
+                }
+                return type === property.type ? property : { ...property, type };
+              }),
+            };
+          }
+        }
+        // A field site on a type alias names a member of the object type the alias resolves to, as
+        // `type Saved = Pick<Runtime, 'frame'>` does: the saved copy of a declared field is the same carried
+        // value, so the picked member carries it too.
+        if (next.kind === 'typeAlias' && next.type.kind === 'object') {
+          const owner = next.binding.name;
+          const fields = new Set(
+            (carrier.fields ?? [])
+              .filter((candidate) => candidate.owner === owner && matchesPackage(candidate, module))
+              .map((candidate) => candidate.field),
+          );
+          if (fields.size > 0) {
+            const alias = next;
+            const object = alias.type as Extract<IrType, { kind: 'object' }>;
+            next = {
+              ...alias,
+              type: {
+                ...object,
+                properties: object.properties.map((property) =>
+                  fields.has(property.name)
+                    ? { ...property, type: substituteFieldPayload(property.type, carrier.nominal, found) }
+                    : property,
+                ),
+              },
+            };
+          }
+        }
+      }
+      return next;
+    });
+    const result = declarations.some((declaration, index) => declaration !== module.declarations[index])
+      ? { ...module, declarations }
+      : module;
+    original.set(module, result);
+    return result;
+  });
+  const plans = new Map<string, Readonly<CppStructuralValueCarrierPlan>>();
+  const synthetic: CppCompilerExternalBindingManifest['bindings'][number][] = [];
+  for (const carrier of carriers) {
+    const nominal = nominals.get(carrier.nominal);
+    if (!nominal) continue;
+    const sourceName = getCppStructuralValueCarrierSourceNameCpp(carrier.nominal);
+    plans.set(sourceName, { carrier, nominal, sourceName });
+    synthetic.push({
+      headers: ['flight/nominal_or_structural_view.hpp'],
+      nullability: 'non-null',
+      ownership: 'value',
+      sourceName,
+      space: 'type',
+      targetName: carrier.target,
+    });
+  }
+  const externalBindings: CppCompilerExternalBindingManifest = {
+    bindings: [...(options.externalBindings?.bindings ?? []), ...synthetic],
+    schema: options.externalBindings?.schema ?? 'flight-cpp-external-bindings/1',
+  };
+  const rewrittenOptions = { ...options, externalBindings };
+  cppStructuralValueCarrierPlans.set(rewrittenOptions, plans);
+  return { modules: rewritten, options: rewrittenOptions, original, plans };
+}
