 // The interface declaration a named type names, wherever it was declared. Interfaces flatten into
 // independent C++ structs, so this declaration is the heritage evidence the member-view lowering
 // reads; a class, an unresolved import, or any other type yields undefined and keeps the refusal.
+// An interface value handed to a parameter declared as the class it was written from: the caller
+// holds the same object, and the concrete owner is recovered from the control-block record. Only a
+// DECLARED pair and site adopt, and every interface member must be compatible with the class member of
+// the same name (type, readonly and optionality; parameters and result for methods) -- matching names
+// alone prove nothing. Values that were not allocated as that class throw the native escape at the
+// call, never a copy and never an empty reference; that is the honest partial boundary.
+function emitCppInterfaceToClassOwnerAdoptionCpp(
+  argument: Readonly<IrExpression>,
+  emitted: string,
+  expectedType: Readonly<IrType> | undefined,
+  context: EmitContext,
+  call: Readonly<Extract<IrExpression, { kind: 'call' }>>,
+  argumentIndex: number,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expectedType === undefined) return undefined;
+  const expected = getCppNonNullableType(expectedType, context, new Set()) ?? expectedType;
+  const classDeclaration = resolveCppClassForTypeCpp(expected, context);
+  if (!classDeclaration) return undefined;
+  const argumentType = getIrExpressionTypeEvidenceCpp(argument, context);
+  if (argumentType === undefined) return undefined;
+  const argumentPresent = getCppNonNullableType(argumentType, context, new Set()) ?? argumentType;
+  if (emitType(argumentPresent, context) === emitType(expected, context)) return undefined;
+  const interfaceDeclaration = getCppInterfaceDeclarationCpp(argumentPresent, context);
+  if (!interfaceDeclaration) return undefined;
+  const declared = (context.options.classInterfaceAdoptions ?? []).find(
+    (candidate) =>
+      candidate.interface === interfaceDeclaration.binding.name &&
+      candidate.class === classDeclaration.declaration.binding.name,
+  );
+  if (!declared) return undefined;
+  if (call.callee.kind !== 'identifier') return undefined;
+  const calleeReference = call.callee.reference;
+  if (calleeReference.kind === 'super' || calleeReference.kind === 'this') return undefined;
+  const calleeName = calleeReference.kind === 'ambient' ? calleeReference.name : calleeReference.binding.name;
+  const calleeBindingId = calleeReference.kind === 'binding' ? calleeReference.binding.id : undefined;
+  const calleeDeclaration = calleeBindingId
+    ? getCppFunctionDeclarationForBindingCpp(calleeBindingId, context)
+    : undefined;
+  const parameterName = calleeDeclaration?.parameters[argumentIndex]?.binding.name;
+  if (parameterName === undefined) return undefined;
+  const siteDeclared = declared.parameters.some(
+    (site) =>
+      site.package === context.module.packageName && site.function === calleeName && site.parameter === parameterName,
+  );
+  if (!siteDeclared) return undefined;
+  if (
+    !interfaceDeclaration.properties.every((property) =>
+      isCppClassInterfaceMemberCompatibleCpp(property, classDeclaration, context),
+    )
+  ) {
+    return undefined;
+  }
+  context.includes.add('flight/reference.hpp');
+  // `require_owner<Target>` returns Ref<Target>, so the template argument is the OBJECT type the
+  // reference names, not the emitted reference type.
+  const referenceType = emitType(expected, context);
+  const objectType =
+    referenceType.startsWith('flight::Ref<') && referenceType.endsWith('>')
+      ? referenceType.slice('flight::Ref<'.length, -1)
+      : referenceType;
+  return `flight::require_owner<${objectType}>(${emitted})`;
+}
+
+// One interface member against the class's same-named member. A data property needs a field with the
+// same readonly and optionality and a representation-equivalent type; a method needs a class method
+// whose parameter types and result are representation-equivalent. A member with no compatible partner
+// makes the pair undeclarable.
+function isCppClassInterfaceMemberCompatibleCpp(
+  property: Readonly<IrObjectTypeProperty>,
+  classDeclaration: Readonly<{ declaration: Readonly<IrClassDeclaration> }>,
+  context: EmitContext,
+): boolean {
+  const declaration = classDeclaration.declaration;
+  if (property.type.kind === 'function') {
+    const method = declaration.methods.find((candidate) => candidate.name === property.name);
+    if (!method) return false;
+    if (property.type.parameters.length !== method.parameters.length) return false;
+    if (
+      !property.type.parameters.every((parameter, index) => {
+        const target = method.parameters[index];
+        return target !== undefined && areCppTypesRepresentationEquivalent(parameter.type, target.type, context);
+      })
+    ) {
+      return false;
+    }
+    return areCppTypesRepresentationEquivalent(property.type.returns, method.returns, context);
+  }
+  const field = declaration.fields.find((candidate) => candidate.name === property.name);
+  if (!field) return false;
+  if (field.optional !== property.optional || field.readonly !== property.readonly) return false;
+  return areCppTypesRepresentationEquivalent(field.type, property.type, context);
+}
