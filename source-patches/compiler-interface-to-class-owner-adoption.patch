diff --git a/packages/compiler-backend-cpp/src/cppInterfaceToClassOwnerAdoption.test.ts b/packages/compiler-backend-cpp/src/cppInterfaceToClassOwnerAdoption.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppInterfaceToClassOwnerAdoption.test.ts
@@ -0,0 +1,84 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import type { CppCompilerBackendOptions } from '../../compiler-types/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+type Adoption = NonNullable<CppCompilerBackendOptions['classInterfaceAdoptions']>[number];
+
+function adoption(interfaceName: string, className: string, parameter = 'c', functionName = 'take'): Adoption {
+  return {
+    class: className,
+    interface: interfaceName,
+    parameters: [{ function: functionName, package: '@flighthq/example', parameter }],
+  };
+}
+
+function emit(source: string, adoptions: readonly Adoption[] = []): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/interfaceToClassOwnerAdoption.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp', classInterfaceAdoptions: adoptions }).contents;
+}
+
+const compatible = `
+  interface R { pos: number; read(): number }
+  class C { pos = 0; read(): number { this.pos += 1; return 1; } }
+  export function take(c: C): number { return c.pos + c.read(); }
+  export function run(r: R): number { return take(r); }
+`;
+
+it('recovers the concrete class owner at a declared site', () => {
+  const output = emit(compatible, [adoption('R', 'C')]);
+  expect(output).toContain('flight::require_owner<C>(r)');
+  expect(output).toContain('#include <flight/reference.hpp>');
+});
+
+it('does not adopt an undeclared pair', () => {
+  const output = emit(compatible);
+  expect(output).toContain('return take(r);');
+  expect(output).not.toContain('require_owner');
+});
+
+it('does not adopt a declared pair at an undeclared site', () => {
+  const output = emit(compatible, [adoption('R', 'C', 'other', 'other')]);
+  expect(output).not.toContain('require_owner');
+});
+
+it('does not adopt a class method whose signature is not representation-compatible', () => {
+  // TypeScript accepts a method with fewer parameters; the adoption still requires the signatures to
+  // agree, because the recovered owner is called through the class's own method.
+  const output = emit(
+    `
+      interface R { pos: number; read(marker: number): number }
+      class C { pos = 0; read(): number { return 1; } }
+      export function take(c: C): number { return c.pos + c.read(); }
+      export function run(r: R): number { return take(r); }
+    `,
+    [adoption('R', 'C')],
+  );
+  expect(output).not.toContain('require_owner');
+});
+
+it('leaves an argument already declared as the class untouched', () => {
+  const output = emit(
+    `
+      interface R { pos: number; read(): number }
+      class C { pos = 0; read(): number { return 1; } }
+      export function take(c: C): number { return c.pos; }
+      export function run(c: C): number { return take(c); }
+    `,
+    [adoption('R', 'C')],
+  );
+  expect(output).toContain('return take(c);');
+  expect(output).not.toContain('require_owner');
+});
