+const cppCheckedRecordMemberOwners = new WeakMap<
+  CompilerCppReferenceRepresentationPlanner,
+  ReadonlyMap<string, Readonly<IrType> | null>
+>();
+
+// A checked Record table may choose a named owner at each fresh member allocation. Its
+// inferred anonymous scalar shape has one representation everywhere in the emission graph,
+// including imported table reads and indexed type queries. Never convert an existing owner:
+// all allocations and retained storage use this same elected owner from the start.
+function getCppCheckedRecordMemberOwnerCpp(
+  type: Readonly<Extract<IrType, { kind: 'object' }>>,
+  context: EmitContext,
+): Readonly<IrType> | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  let checkedOwners = cppCheckedRecordMemberOwners.get(context.referenceRepresentationPlanner);
+  if (!checkedOwners) {
+    const owners = new Map<string, Readonly<IrType> | null>();
+    cppCheckedRecordMemberOwners.set(context.referenceRepresentationPlanner, owners);
+    checkedOwners = owners;
+    for (const module of context.sourceModules) {
+      for (const declaration of module.declarations) {
+        if (declaration.kind !== 'variable' || declaration.mutable || declaration.initializer?.kind !== 'object')
+          continue;
+        const table = declaration.initializer;
+        const target = table.type;
+        if (
+          target?.kind !== 'named' ||
+          target.reference.kind !== 'ambient' ||
+          target.reference.name !== 'Record' ||
+          target.typeArguments.length !== 2
+        )
+          continue;
+        const key = target.typeArguments[0];
+        const value = target.typeArguments[1];
+        if (
+          key?.kind !== 'primitive' ||
+          key.name !== 'string' ||
+          value?.kind !== 'named' ||
+          value.reference.kind !== 'binding' ||
+          value.typeArguments.length !== 0
+        )
+          continue;
+        const owner = getCppNamedTypeDeclarationOwnerCpp(value, module, context);
+        if (
+          owner?.declaration.kind !== 'interface' ||
+          owner.declaration.typeParameters.length !== 0 ||
+          owner.declaration.extends.length !== 0
+        )
+          continue;
+        const valuePlan = context.referenceRepresentationPlanner.plan(value, module);
+        if (
+          valuePlan.kind !== 'represented' ||
+          valuePlan.category !== 'interface' ||
+          valuePlan.valueRepresentation !== 'flightReference'
+        )
+          continue;
+        const targetProperties = context.referenceRepresentationPlanner.resolveObjectShape(value, module);
+        if (
+          !targetProperties?.length ||
+          targetProperties.some(
+            (property) =>
+              property.optional ||
+              property.computedKey ||
+              property.phantom ||
+              property.type.kind !== 'primitive' ||
+              !['boolean', 'number', 'string'].includes(property.type.name),
+          )
+        )
+          continue;
+        const properties = new Map(targetProperties.map((property) => [property.name, property]));
+        const canonical: Readonly<IrType> = {
+          kind: 'named',
+          reference: { kind: 'binding', binding: owner.declaration.binding, path: [] },
+          typeArguments: [],
+        };
+        for (const member of table.members) {
+          if (member.kind !== 'property' || member.value.kind !== 'object' || member.value.type?.kind !== 'object')
+            continue;
