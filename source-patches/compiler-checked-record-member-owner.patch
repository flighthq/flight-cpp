+          const shape = member.value.type;
+          if (
+            literal.members.some((field) => field.kind !== 'property') ||
+            literal.members.length !== shape.properties.length ||
+            new Set(literal.members.map((field) => (field.kind === 'property' ? field.name : ''))).size !==
+              literal.members.length ||
+            shape.properties.length !== properties.size
