+// Widens one nullable readonly structural view to a nullable view of a proven base shape. StructuralRef's
+// converting constructor keeps the same native object and row owner, while std::optional's converting
+// constructor carries absence unchanged. The compiler's generated-row proof is the same proof required by
+// the runtime constructor, so no unchecked cast, materialized row, or replacement owner is involved.
+function emitCppOptionalStructuralReferenceWideningCpp(
+  expression: Readonly<IrExpression>,
+  expressionType: Readonly<IrType>,
+  sourcePlan: ReturnType<typeof getCppUnionRepresentationPlan>,
+  targetUnion: Readonly<Extract<IrType, { kind: 'union' }>>,
+  targetPlan: ReturnType<typeof getCppUnionRepresentationPlan>,
+  context: EmitContext,
+): string | undefined {
+  if (
+    sourcePlan.kind !== 'optionalSingle' ||
+    targetPlan.kind !== 'optionalSingle' ||
+    sourcePlan.valueSlots.length !== 1 ||
+    targetPlan.valueSlots.length !== 1 ||
+    sourcePlan.sentinels.null !== targetPlan.sentinels.null ||
+    sourcePlan.sentinels.undefined !== targetPlan.sentinels.undefined
+  ) {
+    return undefined;
+  }
+  const sourceRow = context.referenceRepresentationPlanner.resolveStructuralRow(
+    sourcePlan.valueSlots[0]!.runtimeType,
+    context.module,
+  );
+  const targetRow = context.referenceRepresentationPlanner.resolveStructuralRow(
+    targetPlan.valueSlots[0]!.runtimeType,
+    context.module,
+  );
+  if (!sourceRow || !targetRow) return undefined;
+  if (isCppStructuralRowSchemaReadonlyCpp(sourceRow) && !isCppStructuralRowSchemaReadonlyCpp(targetRow)) {
+    return undefined;
+  }
+  const sourceObject = getCppStructuralRowObjectTypeCpp(sourceRow);
+  const targetObject = getCppStructuralRowObjectTypeCpp(targetRow);
+  if (
+    !sourceObject ||
+    !targetObject ||
+    getCppStructuralRowObjectWideningProofCpp(sourceObject, targetObject, context) !== 'proven'
+  ) {
+    return undefined;
+  }
+  const target = qualifyCppDeclaringModuleTypeCpp(emitUnionTypeCpp(targetUnion, context), context);
+  return `${target}(${emitExpression(expression, context, expressionType, false)})`;
+}
