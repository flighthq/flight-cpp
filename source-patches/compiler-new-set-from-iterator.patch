+// Whether an expression is `collection.values()` or `.keys()` on a Set, Map or Array receiver: an iterator call
+// whose result is never null or undefined. entries() is left out: flight::Set has no entries(), and a Set built
+// from entries holds a fresh [key, value] array per element, which is a different construction.
+function isCppCollectionIteratorCallCpp(expression: Readonly<IrExpression>, context: EmitContext): boolean {
+  if (expression.kind !== 'call' || expression.optional || expression.arguments.length !== 0) return false;
+  const callee = expression.callee;
+  if (callee.kind !== 'property' || callee.optional) return false;
+  if (callee.name !== 'values' && callee.name !== 'keys') return false;
+  const receiverType = getIrExpressionBindingTypeCpp(callee.object, context) ?? getIrExpressionTypeEvidenceCpp(callee.object, context);
+  if (!receiverType) return false;
+  if (receiverType.kind === 'array') return true;
+  const collection = getIrAmbientCollectionTypeCpp(receiverType, context, new Set());
+  return (
+    collection?.reference.name === 'Set' ||
+    collection?.reference.name === 'ReadonlySet' ||
+    collection?.reference.name === 'Map' ||
+    collection?.reference.name === 'ReadonlyMap'
+  );
+}
