@@ -0,0 +1,77 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/recordMissingKeyGuard.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const table = `const DEFAULTS: Record<string, Record<string, unknown>> = { a: { x: 1 } };
+const SCALE: Record<string, number> = { a: 2, z: 0 };`;
+
+it('tests a missing typed Record key before binding the local when a falsiness guard leaves', () => {
+  const output = emit(`${table}
+    export function getDefaults(kind: string): Record<string, unknown> {
+      const entry = DEFAULTS[kind];
+      if (!entry) return {};
+      return { ...entry };
+    }
+    export function truthyScale(kind: string): number {
+      const s = SCALE[kind];
+      if (!s) return -1;
+      return s;
+    }
+  `);
+
+  expect(output).toContain('auto entry_record_lookup = defaults.get(kind);');
+  expect(output).toContain('if (!entry_record_lookup.has_value()) {');
+  expect(output).toContain('flight::Record<flight::String, flight::Any> entry = (*entry_record_lookup);');
+  expect(output).not.toContain('defaults.get(kind).value()');
+  // The source guard still tests the present value, so a present falsy number takes the branch.
+  expect(output).toContain('const double s = (*s_record_lookup);');
+  expect(output).toMatch(/if \(!flight::to_boolean\(s\)\)|if \(!\(s != 0/);
+});
+
+it('keeps the existing lowering where the pair is not exactly a leaving falsiness guard', () => {
+  const output = emit(`${table}
+    export function readsInBranch(kind: string): unknown {
+      const entry = DEFAULTS[kind];
+      if (!entry) return entry;
+      return entry;
+    }
+    export function interveningStatement(kind: string, log: string[]): boolean {
+      const entry = DEFAULTS[kind];
+      log.push(kind);
+      if (!entry) return false;
+      return true;
+    }
+    export function noLeave(kind: string): number {
+      const s = SCALE[kind];
+      if (!s) {
+        void 0;
+      }
+      return 0;
+    }
+    export function comparedToUndefined(kind: string): number {
+      const s = SCALE[kind];
+      if (s === undefined) return 1;
+      return s;
+    }
+  `);
+
+  expect(output).not.toContain('record_lookup');
+  expect(output).toContain('const std::optional<double> s = scale.get(kind);');
+});
