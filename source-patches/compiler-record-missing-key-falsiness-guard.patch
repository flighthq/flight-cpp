+// `const entry = DEFAULTS[kind]; if (!entry) return ...;` reads a typed Record whose value type has no
+// absence, so the read is typed present -- but a key the dictionary does not hold is `undefined` in the
+// source, and the guard right after it is the source saying so. The pair is lowered exactly: the lookup is
+// evaluated once into the runtime's own optional, the guard's abrupt branch runs when it is disengaged, and
+// only then is the local bound to the engaged value. The original guard still follows, so a present value
+// is tested by the condition the source wrote, so a present falsy value still takes the branch. Kept to
+// this immediate pair: no statement may run between
+// the read and the guard, the guard must leave, and its branch must not read the local, so the local is
+// never observed absent.
+interface CppRecordMissingKeyGuard {
+  readonly element: Readonly<Extract<IrExpression, { kind: 'element' }>>;
+  readonly guard: Readonly<Extract<IrStatement, { kind: 'if' }>>;
+  readonly lookupName: string;
+}
+
+function getCppImmediateRecordMissingKeyGuardCpp(
+  statement: Readonly<IrStatement>,
+  next: Readonly<IrStatement> | undefined,
+  context: EmitContext,
+): CppRecordMissingKeyGuard | undefined {
+  if (
+    getCppRuntimeProfile(context.options) !== 'flight-cpp' ||
+    statement.kind !== 'variable' ||
+    statement.declarations.length !== 1 ||
+    next?.kind !== 'if' ||
+    next.otherwise ||
+    !isCppAbruptCompletionStatement(next.consequent)
+  ) {
+    return undefined;
+  }
+  const declaration = statement.declarations[0]!;
+  if (!('binding' in declaration) || declaration.mutable || !declaration.initializer) return undefined;
+  const element = declaration.initializer;
+  if (element.kind !== 'element' || element.optional) return undefined;
+  const objectType = getIrExpressionTypeEvidenceCpp(element.object, context);
+  const record = getCppRecordTypeArgumentsCpp(objectType, context, new Set());
+  if (
+    !record ||
+    getCppNamedPropertiesViewExpressionCpp(element.object, context) ||
+    isCppAliasResolvedErasedDynamicValueTypeCpp(record.value, context) ||
+    isCppRecordValueAbsenceCapableCpp(record.value)
+  ) {
+    return undefined;
+  }
+  const bindingId = declaration.binding.id;
+  if (!isCppBindingAbsenceTestCpp(next.condition, bindingId)) return undefined;
+  if (JSON.stringify(next.consequent).includes(JSON.stringify(bindingId))) return undefined;
+  return {
+    element,
+    guard: next,
+    lookupName: `${getBindingTargetName(declaration.binding, context)}_record_lookup`,
+  };
+}
+
+function emitCppRecordMissingKeyGuardPrologueCpp(
+  plan: CppRecordMissingKeyGuard,
+  context: EmitContext,
+): string[] {
+  const lookupContext: EmitContext = {
+    ...context,
+    recordLookupElements: new Map(context.recordLookupElements).set(plan.element, ''),
+  };
+  const lookup = emitExpression(plan.element, lookupContext);
+  return [
+    `auto ${plan.lookupName} = ${lookup};`,
+    `if (!${plan.lookupName}.has_value()) {`,
+    ...indentSourceLines(emitStatementBody(plan.guard.consequent, context)),
+    '}',
+  ];
+}
+
+function isCppRecordValueAbsenceCapableCpp(value: Readonly<IrType>): boolean {
+  if (value.kind === 'undefined' || value.kind === 'null' || value.kind === 'unknown') return true;
+  if (value.kind === 'union') return value.types.some((member) => isCppRecordValueAbsenceCapableCpp(member));
+  return false;
+}
+
+// `!x`: the source tests the local's truthiness, which is where a missing key surfaces for a value type
+// with no absence of its own. A comparison with `undefined` or `null` already elects optional storage for
+// the local and reads the lookup once, so it is not taken here.
+function isCppBindingAbsenceTestCpp(condition: Readonly<IrExpression>, bindingId: string): boolean {
+  return (
+    condition.kind === 'unary' &&
+    !condition.postfix &&
+    condition.operator === '!' &&
+    condition.operand.kind === 'identifier' &&
+    condition.operand.reference.kind === 'binding' &&
+    condition.operand.reference.binding.id === bindingId
+  );
+}
