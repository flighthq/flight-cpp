+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// The console the program sees: the library's variadic, void-returning methods.
+const consoleLibrary = `
+  declare const console: {
+    debug(...data: unknown[]): void; error(...data: unknown[]): void; info(...data: unknown[]): void;
+    log(...data: unknown[]): void; warn(...data: unknown[]): void; table(...data: unknown[]): void;
+    count(label: string): number;
+  };
+`;
+
+const members = ['debug', 'error', 'info', 'log', 'warn'] as const;
+const consoleBinding = {
+  bindings: [
+    {
+      headers: ['host/console.hpp'],
+      members: [
+        ...members.map((member) => ({ sourceMember: member, targetName: `host::console_${member}` })),
+        { sourceMember: 'count', targetName: 'host::console_count' },
+      ],
+      nullability: 'non-null' as const,
+      ownership: 'borrowed' as const,
+      sourceName: 'console',
+      space: 'value' as const,
+      targetName: 'host::console',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/log/src/Console.ts', consoleLibrary + source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/log', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { externalBindings: consoleBinding, runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function failure(source: string): { rule?: string } | undefined {
+  try {
+    emit(source);
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error as { rule?: string };
+    throw error;
+  }
+  return undefined;
+}
+
+describe('finite-key call on a bound host object', () => {
+  it('dispatches every member of the full console method family selected through a closed key union', () => {
+    const contents = emit(
+      `type Method = 'debug' | 'error' | 'info' | 'log' | 'warn';
+       function methodFor(level: number): Method {
+         return level === 0 ? 'debug' : level === 1 ? 'error' : level === 2 ? 'info' : level === 3 ? 'log' : 'warn';
+       }
+       export function write(level: number, line: string): void { console[methodFor(level)](line); }`,
+    );
+    for (const member of members) {
+      expect(contents).toContain(`== flight::String("${member}")) { host::console_${member}(`);
+    }
+    expect(contents).toContain('throw flight::TypeError(flight::String("console[key] is not a function"))');
+  });
+
+  it('dispatches a subset family and evaluates the key before the argument, each once', () => {
+    const contents = emit(
+      `export function report(severe: boolean, line: string): void { console[severe ? 'error' : 'warn'](line); }`,
+    );
+    expect(contents).toMatch(/const auto member_key[^;]*= \(severe \? [^;]*; const auto member_argument[^;]*= line;/u);
+    expect(contents).toContain('host::console_error(');
+    expect(contents).toContain('host::console_warn(');
+    expect(contents).not.toContain('host::console_debug(');
+  });
+
+  it('forwards a template-literal message, which is always a string', () => {
+    const contents = emit(`export function tagged(k: 'log' | 'warn', tag: string, n: number): void { console[k](\`[\${tag}] \${n}\`); }`);
+    expect(contents).toContain('host::console_log(member_argument');
+    expect(contents).toContain('host::console_warn(member_argument');
+  });
+
+  it('refuses an open string key', () => {
+    // A plain string key proves no member set, so this lane does not dispatch it.
+    const open = failure(`export function any(name: string, line: string): void { (console as never as Record<string, (m: string) => void>)[name]!(line); }`);
+    expect(open?.rule).not.toBe('cpp-closed-key-external-member-result');
+    // keyof the whole host object is not a key set this lane proves: it never dispatches it.
+    let openContents = '';
+    try {
+      openContents = emit(`export function open(name: keyof typeof console, line: string): void { console[name](line); }`);
+    } catch {
+      openContents = '';
+    }
+    expect(openContents).not.toContain('member_key');
+  });
+
+  it('refuses forwarding arguments the members do not declare', () => {
+    expect(
+      failure(`export function two(k: 'log' | 'warn', prefix: string, detail: string): void { console[k](prefix, detail); }`)?.rule,
+    ).toBe('cpp-closed-key-external-member-arguments');
+    expect(failure(`export function num(k: 'log' | 'warn', value: number): void { console[k](value); }`)?.rule).toBe(
+      'cpp-closed-key-external-member-arguments',
+    );
+  });
+
+  it('refuses a key set that reaches a member the binding does not declare', () => {
+    expect(failure(`export function t(k: 'log' | 'table', line: string): void { console[k](line); }`)?.rule).toBe(
+      'cpp-closed-key-external-member-unbound',
+    );
+  });
+
+  it('refuses a non-void result rather than unifying member results', () => {
+    expect(failure(`export function c(k: 'count', label: string): number { return console[k](label); }`)?.rule).toBe(
+      'cpp-closed-key-external-member-result',
+    );
+  });
+
+  it('leaves dynamic indexing of an unbound object to the existing path', () => {
+    const result = failure(
+      `export function d(sinks: Record<string, (m: string) => void>, k: string, line: string): void { sinks[k]!(line); }`,
+    );
+    expect(result?.rule).not.toBe('cpp-closed-key-external-member-unbound');
+  });
+});
