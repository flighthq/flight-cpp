+// The dual-sentinel form of a chained call. The plain chain lowering returns `std::optional<payload>`,
+// which erases whether absence came from a missing link or from the callee's own null return; assigning
+// that to the dual-sentinel variant the source type declares has no converting constructor and also
+// loses the authored sentinel. This path evaluates the same receiver projection and the same
+// invocation once, and returns each state with the destination's own carrier: a missing link keeps
+// `undefined`, an empty callee result keeps `null`, and a present result constructs its value slot.
+// It applies only when the destination represents BOTH sentinels with exactly one value slot, so the
+// ambiguous optional form is never chosen for a source that distinguishes them.
+function emitCppDualSentinelOptionalChainCallCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'call' }>>,
+  union: Readonly<Extract<IrType, { kind: 'union' }>>,
+  plan: ReturnType<typeof getCppUnionRepresentationPlan>,
+  context: EmitContext,
+): string | undefined {
+  const semantics = expression.semantics.optionalChain;
+  if (!semantics || semantics.receiverNullish === 'excluded') return undefined;
+  if (plan.kind !== 'dualSentinelVariant' || plan.valueSlots.length !== 1) return undefined;
+  if (plan.sentinels.null === 'absent' || plan.sentinels.undefined === 'absent') return undefined;
+  const receiverProjection = getCppOptionalChainReceiverProjectionCpp(semantics.receiverType, context);
+  const receiverType = emitOptionalChainPayloadIrTypeCpp(semantics.receiverType, context);
+  const callee = emitOptionalChainReceiverCpp(expression.callee, context);
+  const arguments_ = appendCppOmittedInvocationArguments(
+    expression,
+    expression.arguments.map((argument) => emitExpression(argument, context)),
+    context,
+  ).join(', ');
+  const invocation = getCppCallableObjectIrTypeCpp(receiverType, context, new Set())
+    ? `(*${receiverProjection.value})(${arguments_})`
+    : `${receiverProjection.value}(${arguments_})`;
+  const resultType = qualifyCppDeclaringModuleTypeCpp(emitUnionTypeCpp(union, context), context);
+  const slot = plan.valueSlots[0]!;
+  const targetType = qualifyCppDeclaringModuleTypeCpp(slot.targetType, context);
+  const undefinedSentinel = emitCppUnionSentinelConstruction('undefined', union, plan.kind, context);
+  const nullSentinel = emitCppUnionSentinelConstruction('null', union, plan.kind, context);
+  const result = getGeneratedTargetName('optionalChainResult', context);
+  // `getCppOptionalChainReceiverProjectionCpp` spells its projections with this local's name; the
+  // receiver is held once for the absence test and the invocation, never re-evaluated.
+  const present = emitCppUnionValueConstruction(`${result}.value()`, targetType, union, plan.kind, context);
+  context.includes.add('optional');
+  return `([&]() -> ${resultType} { auto optional_chain_receiver = ${callee}; if (${receiverProjection.absent}) return ${undefinedSentinel}; auto ${result} = ${invocation}; if (!${result}.has_value()) return ${nullSentinel}; return ${present}; }())`;
+}
+
