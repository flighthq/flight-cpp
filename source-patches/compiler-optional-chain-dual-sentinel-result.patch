   expression: Readonly<Extract<IrExpression, { kind: 'call' }>>,
   context: EmitContext,
diff --git a/packages/compiler-backend-cpp/src/cppOptionalChainResultVariant.test.ts b/packages/compiler-backend-cpp/src/cppOptionalChainResultVariant.test.ts
new file mode 100644
index 0000000..62489b3
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppOptionalChainResultVariant.test.ts
@@ -0,0 +1,72 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/optionalChain.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+// The source shape is `@flighthq/swf`'s placement-node helper: a callback reached through two
+// optional links returns `Node2D | null`, and the chained call's result is declared
+// `Node2D | null | undefined`. The absent link is `undefined`; the callee's own return may be `null`;
+// and a present character is the node. Both sentinels must survive into the declared variant.
+const dualSentinel = `
+  interface Node2D { x: number }
+  interface Instantiate { createPlacementNode?(parsed: number): Node2D | null }
+  interface Handler { instantiate?: Instantiate }
+  export function create(handlers: readonly Handler[]): number {
+    for (const handler of handlers) {
+      const node: Node2D | null | undefined = handler.instantiate?.createPlacementNode?.(1);
+      void node;
+    }
+    return 0;
+  }
+`;
+
+it('keeps both chain sentinels when the declared result distinguishes null from undefined', () => {
+  const output = emit(dualSentinel);
+  // The declared carrier is the dual-sentinel variant, and the initializer must construct that same
+  // carrier rather than an optional it has no converting constructor from.
+  expect(output).toContain(
+    'std::variant<flight::Ref<Node2D>, flight::Null, flight::Undefined> node = ([&]() -> std::variant<',
+  );
+  // An absent link is undefined, never a collapsed absence.
+  expect(output).toContain('std::in_place_type<flight::Undefined>, flight::undefined');
+  // The callee's own null result stays null.
+  expect(output).toContain('std::in_place_type<flight::Null>, flight::null');
+  // A present result is the value slot, and the receiver is evaluated once for both the absence test
+  // and the invocation.
+  expect(output).toContain('.value()');
+  expect(output.match(/auto optional_chain_receiver =/gu)?.length).toBe(2);
+  expect(output.match(/->create_placement_node/gu)?.length).toBe(1);
+});
+
+it('leaves a chain whose declared result has only one sentinel on the ordinary optional carrier', () => {
+  const output = emit(`
+    interface Node2D { x: number }
+    interface Instantiate { createPlacementNode?(parsed: number): Node2D | null }
+    interface Handler { instantiate?: Instantiate }
+    export function create(handlers: readonly Handler[]): number {
+      for (const handler of handlers) {
+        const node: Node2D | undefined = handler.instantiate?.createPlacementNode?.(1);
+        void node;
+      }
+      return 0;
+    }
+  `);
+  expect(output).toContain('std::optional<flight::Ref<Node2D>> node = ([&]() -> std::optional<');
+  expect(output).not.toContain('std::in_place_type<flight::Undefined>');
+});
