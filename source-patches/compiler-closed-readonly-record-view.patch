+        input,
+        `#include "record.hpp"
+#include <iostream>
+int main(){int checks=0,failures=0;auto check=[&](bool ok){++checks;if(!ok)++failures;};
+flight::Record<flight::String,std::variant<double,flight::String>> source;source.set(flight::String("text"),flight::String("original"));
+flight::Array<flight::Ref<probe::Diagnostic>> sink;probe::forward(sink,source);check(sink.size()==1);check(sink.element(0)->detail.has_value());
+auto detail=sink.element(0)->detail.value();check(detail.identity()==source.identity());source.set(flight::String("text"),flight::String("changed"));check(std::get<flight::String>(detail.get(flight::String("text")).value())==flight::String("changed"));
+source.erase(flight::String("text"));check(!detail.get(flight::String("text")));auto escaped=probe::escape(source);check(escaped.identity()==source.identity());source.set(flight::String("number"),4.0);check(std::get<double>(escaped.get(flight::String("number")).value())==4);
+probe::forward(sink,std::nullopt);check(!sink.element(1)->detail.has_value());auto fresh=probe::fresh();check(std::get<flight::String>(fresh.get(flight::String("text")).value())==flight::String("kept"));check(std::get<double>(fresh.get(flight::String("value")).value())==3);
+std::cout<<checks<<" checks, "<<failures<<" failures\\n";return failures?1:0;}
