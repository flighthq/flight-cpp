+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+const toolchain = findCppCompilerToolchain();
+const source = `
+export type Data=boolean|number|string;
+export interface Diagnostic{ detail?:Readonly<Record<string,Data>> }
+function report(sink:Diagnostic[],detail?:Readonly<Record<string,Data>>):void{sink.push({detail});}
+export function forward(sink:Diagnostic[],detail?:Record<string,number|string>):void{report(sink,detail);}
+export function escape(detail:Record<string,number|string>):Readonly<Record<string,Data>>{return detail;}
+export function fresh():Readonly<Record<string,Data>>{return {text:'kept',value:3};}
+`;
+function emit(text = source): string {
+  const [lowered] = lowerTypeScriptSources([
+    {
+      sourceFile: ts.createSourceFile('/flight/packages/example/src/filter.ts', text, ts.ScriptTarget.Latest, true),
+      packageName: '@flighthq/example',
+      upstreamDirectory: '/flight',
+    },
+  ]);
+  expect(lowered!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered!.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/example': { namespace: 'probe', includePrefix: 'probe' } },
+  }).contents;
+}
+
+it('retains explicit readonly closed record contracts in parameters and stored fields', () => {
+  const output = emit();
+  expect(output).toContain('flight::ReadonlyRecordView<Data>');
+  expect(output).not.toContain('NOT GENERATED');
+});
+it('leaves mutable, generic, numeric-keyed and erased records outside the new facade', () => {
+  for (const text of [
+    'export function keep(value:Record<string,boolean|number|string>):void{}',
+    'export function keep<T>(value:Readonly<Record<string,T>>):void{}',
+    'export function keep(value:Readonly<Record<number,boolean|number|string>>):void{}',
+    'export function keep(value:Readonly<Record<string,unknown>>):void{}',
+  ])
+    expect(emit(text)).not.toContain('ReadonlyRecordView');
+});
+it('rejects a writable escape from a readonly widened view', () => {
+  expect(() =>
+    emit(
+      'export function escape(value:Readonly<Record<string,boolean|number|string>>):Record<string,boolean|number|string>{return value;}',
+    ),
+  ).toThrow('readonly record view cannot escape into writable Record storage');
+});
