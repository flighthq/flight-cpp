+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const result = lowerTypeScriptSource(ts.createSourceFile(
+    '/flight/packages/projection/src/projection.ts', source, ts.ScriptTarget.Latest, true,
+  ), { packageName: '@flighthq/projection', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const source = `
+interface Curve { points: number[][]; closed: boolean; }
+interface Neighbor { points: number[][]; }
+export function project(value: unknown): Readonly<Curve> | undefined {
+  if (value === null || typeof value !== 'object' || !('points' in value)) return undefined;
+  return value as Readonly<Curve>;
+}
+export function sink(a: number, b: number): number { return a + b; }
+export function consume(curve: Readonly<Curve>): number {
+  return sink(curve.points[0][0], curve.points[0][1]);
+}
+export function flatten(curve: Readonly<Curve>): number[] {
+  const out: number[] = [];
+  for (const points of [curve.points]) {
+    for (const point of points) out.push(point[0] ?? 0, point[1] ?? 0);
+  }
+  return out;
+}
+export function nativeNeighbor(value: Readonly<Neighbor>): number { return value.points.length; }
+`;
+
+describe('emitIrModuleCpp', () => {
+  it('projects only the elected readonly schema and reads nested values lazily', () => {
+    const output = emit(source);
+    expect(output).toContain('flight::json_assertion_row<');
+    expect(output).toContain('flight::read_json_scalar_property(');
+    expect(output).toContain('flight::json_scalar_values(');
+    expect(output).toContain('flight::Array<double> flatten(');
+    const neighbor = output.slice(output.lastIndexOf('native_neighbor('));
+    expect(neighbor).toContain('flight::row_get<');
+    expect(neighbor).not.toContain('read_json_scalar_property');
+  });
+
+  it('captures both source arguments before either native conversion', () => {
+    const output = emit(source);
+    const consumer = output.slice(output.lastIndexOf('double consume('), output.lastIndexOf('flight::Array<double> flatten('));
+    const firstConversion = consumer.indexOf('.as_native_number()');
+    expect(firstConversion).toBeGreaterThan(0);
+    expect(consumer.slice(0, firstConversion).match(/const auto json_call_argument/g)?.length).toBe(2);
+    expect(consumer.slice(firstConversion).match(/\.as_native_number\(\)/g)?.length).toBe(2);
+  });
+
+  it('keeps mutable assertions outside the raw election and callable schemas refused', () => {
+    expect(emit(`interface Curve { points:number[][]; }
+      export function project(value:unknown): Curve { return value as Curve; }`)).not.toContain('json_assertion_row<');
+    expect(() => emit(`interface Curve { run:()=>number; }
+      export function project(value:unknown): Readonly<Curve> { return value as Readonly<Curve>; }`)).toThrow();
+  });
+  it('emits a separate checked getter value callback without changing metadata presence', () => {
+    const output = emit(`export class Reader { reads:number=0;
+      get v():unknown { this.reads++; return 7; } }`);
+    expect(output).toContain('register_class_property_readers<Reader>');
+    expect(output).toContain('value.object_reference_if<Reader>()');
+    expect(output).toContain('flight::json_property_value(object->v())');
+    expect(output).toContain('flight::ClassPrototype{{}, {"v"},');
+  });
+
+});
