+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource, lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { createCppCompilerBackend, emitIrModuleCpp } from './cppCompilerBackend.js';
+function emit(source: string): string {
+  const result = lowerTypeScriptSource(ts.createSourceFile('/flight/packages/example/src/result.ts', source, ts.ScriptTarget.Latest, true), { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+function attempt(source: string): string | undefined {
+  try { return emit(source); } catch (error) {
+    if (typeof error !== 'object' || error === null || !('kind' in error) || error.kind !== 'backend-emission') throw error;
+    return undefined;
+  }
+}
+const prefix = `interface Config{size:number}interface Diagnostic{code:number}interface Document{size:number}interface Result{config:Config;diagnostics:Diagnostic[];document:Document}interface Options{size?:number;width?:number}`;
+const selected = prefix + `interface Codec{parse(text:string,options?:Readonly<Options>):Required<{config:Config;diagnostics:Diagnostic[]}>}export function parse(text:string):Result{return {config:{size:1},diagnostics:[],document:{size:2}}}export const codec:Codec={parse};`;
+it('projects the exact result owner inside the existing one-to-two arity wrapper', () => {
+  const output = emit(selected);
+  expect(output).toContain('inline flight::Ref<Result> parse(flight::String text)');
+  expect(output).toContain('::from<&parse>');
+  expect(output).toContain('flight::StructuralRef<flight::RowWritable<flight::RowOf<flight::Ref<Result>>>>(parse(contextual_callable_argument0))');
+  expect(output).not.toContain('_flight_readonly_options_');
+  expect(output).not.toContain('structural_ref_cast');
+  expect(output).not.toMatch(/make_ref<config_diagnostics_/);
+});
+it('also retains an owner with exactly the two required base fields', () => {
+  const source = selected.replace(';document:Document', '').replace(',document:{size:2}', '');
+  expect(emit(source)).toContain('::from<&parse>');
+});
+it('compares the stored result wrapper to the original named declaration', () => {
+  expect(emit(selected + `export function same():boolean{return codec.parse===parse}`)).toContain('callable_identity_equal_named<&parse>');
+});
