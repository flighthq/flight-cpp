--- a/packages/types/src/ImageResourceReference.ts
+++ b/packages/types/src/ImageResourceReference.ts
@@ -88,6 +88,34 @@ export interface ExternalImageResourceReference extends ImageResourceReferenceBa
 
 export type ImageResourceReference = EmbeddedImageResourceReference | ExternalImageResourceReference;
 
+export function findEmbeddedImageResourceReference(
+  resources: readonly ImageResourceReference[] | undefined,
+  bytes: Uint8Array,
+  mimeType: string | null,
+): EmbeddedImageResourceReference | undefined {
+  if (resources === undefined) return undefined;
+  for (const candidate of resources) {
+    if (candidate.kind === 'Embedded' && candidate.bytes === bytes && candidate.mimeType === mimeType) {
+      return candidate;
+    }
+  }
+  return undefined;
+}
+
+export function findExternalImageResourceReference(
+  resources: readonly ImageResourceReference[] | undefined,
+  uri: string,
+  basePath: string | null,
+): ExternalImageResourceReference | undefined {
+  if (resources === undefined) return undefined;
+  for (const candidate of resources) {
+    if (candidate.kind === 'External' && candidate.uri === uri && candidate.basePath === basePath) {
+      return candidate;
+    }
+  }
+  return undefined;
+}
+
 // The swappable fetch seam an External reference resolves through. The web backend fetches a URL; a
 // native host substitutes its own. This boundary deliberately remains ImageResource-only: External means fetching
 // a URI into a host-drawable handle, while Embedded has bytes in hand and may decode to any TextureSource.
