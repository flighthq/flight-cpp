+// The owned carrier a hoisted catch body reads its binding through.
+//
+// `std::exception_ptr` in the emitted code: it OWNS the thrown object for as long as it is held, which is
+// what lets the value outlive the handler the body was hoisted out of. It is deliberately a plain mutable
+// local with no initializer and no declared type -- the shape the target already recognises as a caught
+// exception recorded for a rethrow -- so nothing new has to be represented, only carried further.
+function createIrCaughtCarrierBinding(
+  origin: Readonly<IrDeclaration>['origin'],
+  counter: { value: number },
+): IrBindingIdentity {
+  const index = counter.value++;
+  return {
+    ...origin,
+    id: `binding:${JSON.stringify([origin.packageName, origin.source, origin.line, origin.column, 'caught-value', index])}`,
+    kind: 'variable',
+    name: 'caught',
+    scope: 'block',
+    space: 'value',
+  };
+}
+
+// The binding the hoisted body reads its caught value through. It is a NEW identity, not the handler's
+// binding re-declared: an identity is introduced once, and the handler's belongs to the handler. It keeps
+// the source name, so everything the body already wrote reads the same, and the body's references to the
+// handler's binding are rewritten onto it below.
+function createIrCaughtValueBinding(
+  origin: Readonly<IrDeclaration>['origin'],
+  binding: IrBindingIdentity,
+  counter: { value: number },
+): IrBindingIdentity {
+  const index = counter.value++;
+  return {
+    ...origin,
+    id: `binding:${JSON.stringify([origin.packageName, origin.source, origin.line, origin.column, 'caught-value-binding', index])}`,
+    kind: 'variable',
+    name: binding.name ?? 'error',
+    scope: 'block',
+    space: 'value',
+  };
+}
+
+// Every reference to one binding identity, rewritten onto another. The IR is plain data, so the rewrite is
+// a walk that rebuilds only the identifier nodes it targets and leaves every other field as it was -- which
+// keeps this safe for constructs this pass does not otherwise understand.
+function replaceIrBindingReferences<T>(node: T, fromId: string, to: IrBindingIdentity): T {
+  if (Array.isArray(node)) return node.map((item) => replaceIrBindingReferences(item, fromId, to)) as T;
+  if (node === null || typeof node !== 'object') return node;
+  const record = node as Record<string, unknown>;
+  if (record.kind === 'identifier') {
+    const reference = record.reference as Readonly<{ binding?: Readonly<{ id?: string }>; kind?: string }> | undefined;
+    if (reference?.kind === 'binding' && reference.binding?.id === fromId) {
+      return { ...record, reference: { ...reference, binding: { ...reference.binding, ...to } } } as T;
+    }
+  }
+  const rebuilt: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(record)) rebuilt[key] = replaceIrBindingReferences(value, fromId, to);
+  return rebuilt as T;
+}
