--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppCatchAwaitCarrier.test.ts
@@ -0,0 +1,132 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// A catch body that awaits is hoisted out of the handler. A body that also READS its binding cannot be hoisted
+// as a flag alone: the handler's `const std::exception&` is gone by the time the body runs. The handler now
+// records an OWNED `std::exception_ptr` -- which keeps the thrown object alive across the suspension -- and the
+// hoisted body re-binds the same caught object from it, so the body reads what the handler caught, with the
+// representation every non-awaiting `catch (error)` already has.
+//
+// The measured site is `@flighthq/loader`'s `resourceLoader.ts` `runEntry`, which retries after
+// `await delay(delayMs)` and passes the caught `error` to `entry.reject(error)` and to
+// `error instanceof DOMException`. The runtime half is pinned in tests/caught_exception_test.cpp.
+function emit(source: string) {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/catch.ts', source, ts.ScriptTarget.Latest, true);
+  return emitIrModuleCpp(
+    lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' }).module,
+    { runtimeProfile: 'flight-cpp' },
+  ).contents;
+}
+
+const AWAITING_READ = `export async function run(load: () => Promise<number>, retry: () => Promise<void>, reject: (e: unknown) => void): Promise<void> {
+  try {
+    await load();
+  } catch (error) {
+    if (Math.random() < 0.5) {
+      await retry();
+      return;
+    }
+    reject(error);
+  }
+}`;
+
+describe('a caught value that survives an await', () => {
+  it('owns the caught object and re-binds it in the hoisted body', () => {
+    const contents = emit(AWAITING_READ);
+    expect(contents).toContain('std::exception_ptr');
+    expect(contents).toContain('std::current_exception()');
+    expect(contents).toContain('const std::exception& error = flight::caught_exception(');
+    // The body's own uses keep reading `error`; nothing else about them moved.
+    expect(contents).toContain('reject(error)');
+  });
+
+  it('keeps the handler narrow, because the re-bound value must be a class exception', () => {
+    const contents = emit(AWAITING_READ);
+    // The carrier is re-bound rather than rethrown, so the handler may not widen to `catch (...)`: a thrown
+    // value that is not a class exception has no `const std::exception&` to re-bind, and the source's own
+    // narrowing never admits one.
+    expect(contents).toContain('catch (const std::exception& error)');
+    expect(contents).not.toContain('catch (...)');
+  });
+
+  it('re-binds from the very carrier the handler recorded', () => {
+    const contents = emit(AWAITING_READ);
+    const recorded = /catch \(const std::exception& error\) \{\n\s*(\w+) = std::current_exception\(\);/.exec(
+      contents,
+    )?.[1];
+    expect(recorded).toBeDefined();
+    expect(contents).toContain(`flight::caught_exception(${String(recorded)})`);
+  });
+
+  it('carries nothing when the hoisted body never reads its binding', () => {
+    const contents = emit(`export async function run(load: () => Promise<number>, retry: () => Promise<void>): Promise<void> {
+      try {
+        await load();
+      } catch (error) {
+        await retry();
+      }
+    }`);
+    // The flag alone is still the whole lowering: no carrier, no re-binding -- and the handler may widen,
+    // because nothing downstream has to name the caught value.
+    expect(contents).not.toContain('std::exception_ptr');
+    expect(contents).not.toContain('caught_exception');
+    expect(contents).toContain('catch (...)');
+  });
+
+  it('leaves a catch that never awaits alone', () => {
+    const contents = emit(`export function run(load: () => number, reject: (e: unknown) => void): void {
+      try {
+        load();
+      } catch (error) {
+        reject(error);
+      }
+    }`);
+    expect(contents).not.toContain('std::exception_ptr');
+    expect(contents).not.toContain('caught_exception');
+    expect(contents).toContain('catch (const std::exception& error)');
+  });
+
+  it('gives each competing suspension its own carrier', () => {
+    const contents = emit(`export async function run(a: () => Promise<number>, b: () => Promise<number>, reject: (e: unknown) => void): Promise<void> {
+      try {
+        await a();
+      } catch (first) {
+        await b();
+        reject(first);
+      }
+      try {
+        await b();
+      } catch (second) {
+        await b();
+        reject(second);
+      }
+    }`);
+    expect(contents.match(/std::exception_ptr/g)?.length).toBe(2);
+    expect(contents.match(/flight::caught_exception\(/g)?.length).toBe(2);
+    expect(contents).toContain('reject(first)');
+    expect(contents).toContain('reject(second)');
+  });
+
+  it('keeps a nested catch inside a hoisted body on its own carrier', () => {
+    const contents = emit(`export async function run(load: () => Promise<number>, inner: () => Promise<number>, reject: (e: unknown) => void): Promise<void> {
+      try {
+        await load();
+      } catch (outer) {
+        try {
+          await inner();
+        } catch (nested) {
+          await inner();
+          reject(nested);
+        }
+        reject(outer);
+      }
+    }`);
+    expect(contents.match(/std::exception_ptr/g)?.length).toBe(2);
+    expect(contents).toContain('reject(nested)');
+    expect(contents).toContain('reject(outer)');
+  });
+});
