+import type { BlinnPhongMaterial } from './BlinnPhongMaterial.ts';
+import type { CustomShaderMaterial } from './CustomShaderMaterial.ts';
+import type { DepthMaterial } from './DepthMaterial.ts';
+import type { EmissiveMaterial } from './EmissiveMaterial.ts';
+import type { ExtendedPbrMaterial } from './ExtendedPbrMaterial.ts';
+import type { LambertMaterial } from './LambertMaterial.ts';
+import type { MatcapMaterial } from './MatcapMaterial.ts';
+import type { Material3D } from './Material3D.ts';
+import type { NormalMaterial } from './NormalMaterial.ts';
+import type { PhongMaterial } from './PhongMaterial.ts';
+import type { ShadedMaterial } from './ShadedMaterial.ts';
+import type { SpecularGlossinessPbrMaterial } from './SpecularGlossinessPbrMaterial.ts';
+import type { StandardPbrMaterial } from './StandardPbrMaterial.ts';
+import type { ToonMaterial } from './ToonMaterial.ts';
+import type { UnlitMaterial } from './UnlitMaterial.ts';
+import type { VertexColorMaterial } from './VertexColorMaterial.ts';
+import type { WireframeMaterial } from './WireframeMaterial.ts';
+
+// The 3D material family is open: vendor materials implement Material3D, while the built-ins extend it
+// with their own maps, scalars and literal kinds. Storing the values through the flattened Material3D
+// owner alone discards which native owner was stored, so a renderer that reads a built-in's fields
+// asserts them back out of a carrier the emitter must flatten into an unrelated owner. Naming the
+// built-ins as redundant arms BESIDE the open one keeps the same TypeScript value domain -- every arm
+// already extends Material3D, so vendor kinds stay accepted through the open arm -- while giving the
+// exact-owner union rule one concrete owner to select.
+//
+// StandardMaterial is deliberately NOT an arm: at this pin it extends Material2D with the incompatible
+// MaterialDimensionKey phantom, so admitting it would let a 2D material reach a 3D mesh.
+export type Material3DValue =
+  | Material3D
+  | BlinnPhongMaterial
+  | CustomShaderMaterial
+  | DepthMaterial
+  | EmissiveMaterial
+  | ExtendedPbrMaterial
+  | LambertMaterial
+  | MatcapMaterial
+  | NormalMaterial
+  | PhongMaterial
+  | ShadedMaterial
+  | SpecularGlossinessPbrMaterial
+  | StandardPbrMaterial
+  | ToonMaterial
+  | UnlitMaterial
+  | VertexColorMaterial
+  | WireframeMaterial;
