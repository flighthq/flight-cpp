+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { createCppSyntaxGate } from '../../../scripts/cppSyntaxGate.js';
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// `x instanceof T` is a runtime kind test, and C++ has no such operator. Emitted as source text the
+// keyword reaches the translation unit and the header stops at the parse -- which is neither the
+// source's answer nor a refusal. These controls hold the lowering on both sides of that: every shape
+// whose carrier can answer the question emits a test on that carrier, and every shape whose carrier
+// cannot refuses with the rule that says so. The one assertion every positive case shares is that the
+// keyword is gone, because a single unlowered `instanceof` is a header nobody can use.
+//
+// The measured sites are `@flighthq/audio`'s `audioResourceFrom.ts` and `@flighthq/loader`'s `load.ts`,
+// whose operand is the property `response.body` of `NetResponseBody`. They are reproduced here exactly,
+// including the `unknown` segment that the emitter stores as the erased arm beside the named ones --
+// see the loader-shape case, whose comment records what the same source still needs.
+
+const repositoryRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const cppSyntaxGate = createCppSyntaxGate(repositoryRoot);
+
+function lower(file: string, source: string) {
+  const sourceFile = ts.createSourceFile(
+    `/flight/packages/math/src/${file}`,
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  return lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+}
+
+// `NetResponseBody`'s carrier names `Blob`, which this profile represents through a declared external
+// binding rather than through its own table, so the manifest that names it is part of the fixture.
+const externalBindings = {
+  bindings: [
+    {
+      headers: ['flight/blob.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'Blob',
+      space: 'type' as const,
+      targetName: 'flight::Blob',
+    },
+    {
+      headers: ['flight/blob.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'Blob',
+      space: 'value' as const,
+      targetName: 'flight::Blob',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(file: string, source: string) {
+  return emitIrModuleCpp(lower(file, source).module, { externalBindings, runtimeProfile: 'flight-cpp' })
+    .contents;
+}
+
+function captureBackendEmissionFailure(run: () => unknown) {
+  try {
+    run();
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error;
+    throw error;
+  }
+  throw new Error('expected C++ emission to refuse and it did not');
+}
+
+// The source shape both measured packages write, minus their own imports: a property read whose
+// declared union names an `ArrayBuffer` beside alternatives that are not one, guarded by `instanceof`.
+const NET_RESPONSE_BODY = 'string | unknown | ArrayBuffer | Blob | null';
+
+describe('C++ instanceof lowering', () => {
+  it('lowers an instanceof property test to the carried alternative, and the guarded read projects', () => {
+    const contents = emit(
+      'runtime-kind-property.ts',
+      `export interface Obj { body: string | ArrayBuffer | URL | null; }
+       export function f(o: Obj): Uint8Array | null {
+         return o.body instanceof ArrayBuffer ? new Uint8Array(o.body) : null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    // The operand is materialized once, then asked about by the slot its alternative holds.
+    expect(contents).toContain(
+      'const auto& kind_test_value = o->body; return (kind_test_value.has_value() && kind_test_value.value().index() == 0);',
+    );
+    // The narrowing the source wrote is the proof the read projects through, so the guard and the read
+    // are one answer rather than a test beside a value nobody narrowed.
+    expect(contents).toContain('flight::Uint8Array(std::get<0>(o->body.value()))');
+    expect(contents).toContain('std::optional<std::variant<flight::ArrayBuffer, flight::Url, flight::String>>');
+  });
+
+  it('answers the erased arm of the union the source spelled `unknown`', () => {
+    const contents = emit(
+      'runtime-kind-erased-arm.ts',
+      `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): boolean {
+         return response.ok && response.body instanceof ArrayBuffer;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    // The carrier the test indexes into, so the two arm numbers below are read against it rather than
+    // against a remembered order: `unknown` is the fourth alternative, and it is the erased one.
+    expect(contents).toContain(
+      'std::optional<std::variant<flight::ArrayBuffer, flight::Blob, flight::String, flight::Any>> body;',
+    );
+    expect(contents).toContain('kind_test_value.value().index() == 0');
+    // A value the runtime boxed in the erased arm is the same value this test is about, so it is asked
+    // through the erased carrier's own checked projection rather than counted false.
+    expect(contents).toContain(
+      'std::get<3>(kind_test_value.value()).external_if<flight::ArrayBuffer>() != nullptr',
+    );
+  });
+
+  it('answers the same source shape through a binding, where the union evidence already reaches', () => {
+    const contents = emit(
+      'runtime-kind-binding.ts',
+      `export function f(body: ${NET_RESPONSE_BODY}): Uint8Array | null {
+         return body instanceof ArrayBuffer ? new Uint8Array(body) : null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('(body.has_value() && body.value().index() == 0)');
+    expect(contents).toContain('flight::Uint8Array(std::get<0>(body.value()))');
+  });
+
+  it('selects by the alternative the target names, not by the order the union was written in', () => {
+    const contents = emit(
+      'runtime-kind-typed-arrays.ts',
+      `export function f(source: Uint8Array | Uint32Array): boolean {
+         return source instanceof Uint32Array;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('std::variant<flight::Uint32Array, flight::Uint8Array> source');
+    expect(contents).toContain('return source.index() == 0;');
+  });
+
+  it('reads the matched position out of the carrier the target emitted, not out of source order', () => {
+    const contents = emit(
+      'runtime-kind-second-alternative.ts',
+      `export interface Obj { body: URL | ArrayBuffer | null; }
+       export function f(o: Obj): boolean { return o.body instanceof URL; }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    // The declaration is the authority for the arm numbers, so the expectation is read from the same
+    // carrier the emitted index refers to rather than from the order the union was written in.
+    const carrier = /std::optional<std::variant<([^>]*)>> body;/.exec(contents)?.[1] ?? '';
+    const positions = carrier.split(', ');
+    expect(positions[1]).toBe('flight::Url');
+    expect(contents).toContain(`kind_test_value.value().index() == 1`);
+    expect(contents).toContain('const auto& kind_test_value = o->body');
+  });
+
+  it('answers a nullable single alternative by its presence', () => {
+    const contents = emit(
+      'runtime-kind-optional.ts',
+      `export function f(value: ArrayBuffer | null): boolean { return value instanceof ArrayBuffer; }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return value.has_value();');
+  });
+
+  it('keeps the polarity the source wrote', () => {
+    const contents = emit(
+      'runtime-kind-negated.ts',
+      `export interface R { body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): boolean { return !(response.body instanceof Blob); }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return !([&]() { const auto& kind_test_value = response->body;');
+    expect(contents).toContain('kind_test_value.value().index() == 1');
+    expect(contents).toContain('.external_if<flight::Blob>() != nullptr');
+  });
+
+  it('lowers an instanceof over an erased operand to that carrier checked projection', () => {
+    const contents = emit(
+      'runtime-kind-erased.ts',
+      `export function f(value: unknown): boolean { return value instanceof ArrayBuffer; }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return value.external_if<flight::ArrayBuffer>() != nullptr;');
+  });
+
+  it('keeps the checked Error view for an erased Error test', () => {
+    const contents = emit(
+      'runtime-kind-error.ts',
+      `export function f(cause: unknown): string | null {
+         if (cause instanceof Error) return cause.message;
+         return null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('cause.error_if() != nullptr');
+    expect(contents).toContain('cause.error_if()->message()');
+  });
+
+  it('emits C++ the target compiler accepts for the lowered guard', () => {
+    if (!cppSyntaxGate.available) return;
+    const contents = emit(
+      'runtime-kind-syntax.ts',
+      `export interface Obj { body: string | ArrayBuffer | URL | null; }
+       export function f(o: Obj): Uint8Array | null {
+         return o.body instanceof ArrayBuffer ? new Uint8Array(o.body) : null;
+       }`,
+    );
+    expect(cppSyntaxGate.checkCppSourceSyntax(contents, 'instanceof-property').ok).toBe(true);
+  });
+
+  it('refuses a target that names a source-declared class', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-local-class.ts',
+        `class Widget { n = 1; }
+         export function f(value: unknown): boolean { return value instanceof Widget; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-target-unavailable');
+    expect(failure.message).toContain('must name a runtime type this profile carries');
+  });
+
+  it('refuses an ambient name with no runtime carrier', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit('runtime-kind-object.ts', `export function f(value: unknown): boolean { return value instanceof Object; }`),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-target-unavailable');
+  });
+
+  it('refuses an operand whose recorded type is neither an erased carrier nor a union', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-concrete.ts',
+        `export function f(value: ArrayBuffer): boolean { return value instanceof Uint8Array; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-operand-unresolved');
+    expect(failure.message).toContain('answers from an erased carrier or from a union');
+  });
+
+  it('refuses a union that does not carry the alternative the target names', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-absent.ts',
+        `export function f(value: string | number): boolean { return value instanceof ArrayBuffer; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-member-unresolved');
+    expect(failure.message).toContain('ArrayBuffer matched none');
+  });
+
+  it('stops at the binding check for an ambient name the profile carries no binding for', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-unbound.ts',
+        `export function f(value: unknown): boolean { return value instanceof EventTarget; }`,
+      ),
+    );
+    // The refusal is the module-wide binding contract rather than the lowering's own rule: a name with
+    // no carrier at all never reaches a question the target could answer.
+    expect(failure.rule).toBe('cpp-runtime-external-symbol-binding-incomplete');
+  });
+});
