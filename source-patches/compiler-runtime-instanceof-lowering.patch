+// failures here as there, rather than a second rule that could disagree with it.
+function doesCppUnionSlotCarryInstanceOfTargetCpp(
+  slot: Readonly<{
+    representationKey: string;
+    runtimeType: Readonly<IrType>;
+    sourceAlternatives: readonly Readonly<IrType>[];
+    targetType: string;
