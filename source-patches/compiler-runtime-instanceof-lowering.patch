+    return undefined;
+  }
+  const target = getCppInstanceOfTargetCpp(expression.right, context);
+  if (!target) {
+    emissionError(
+      context,
+      'an instanceof test must name a runtime type this profile carries, because the question it asks is which carried kind the operand holds; a source-declared class, an unbound name, and a standard-library mapping with no runtime carrier all leave nothing to ask about, and the source operator is not C++',
