+
+// The constructor an `instanceof` test names, resolved to the carrier this profile provides for it.
+//
+// Only a name with a carrier can be asked about. A local binding keeps a source-declared identity the
+// target has no view of; a name no binding mentions is one the runtime does not carry; and a
+// standard-library mapping -- `Number` to `double`, `Array` to `std::vector` -- names a value with no
+// identity to test at all. All three are the same refusal, because all three would otherwise emit a
+// question with no answer behind it.
+function getCppInstanceOfTargetCpp(
+  expression: Readonly<IrExpression>,
+  context: EmitContext,
+): Readonly<{ name: string; targetName: string; type: Readonly<IrType> }> | undefined {
+  if (expression.kind !== 'identifier' || expression.reference.kind !== 'ambient') return undefined;
+  const name = expression.reference.name;
+  const runtimeProfile = getCppRuntimeProfile(context.options);
+  const targetName = getCompilerRuntimeExternalSymbolTargetCpp(
+    name,
+    'type',
+    runtimeProfile,
+    context.options.externalBindings,
+  );
+  if (targetName === undefined) return undefined;
+  const declaredExternally =
+    context.options.externalBindings?.bindings.some(
+      (binding) => binding.sourceName === name && binding.space === 'type',
+    ) ?? false;
+  if (!declaredExternally && !isCompilerRuntimeExternalSymbolProvidedCpp(name, 'type', runtimeProfile, context.options.externalBindings)) {
+    return undefined;
+  }
+  return {
+    name,
+    targetName,
+    type: { kind: 'named', reference: { kind: 'ambient', name }, typeArguments: [] },
+  };
+}
+
+// A named target answers a union alternative by the same matching a union member test uses, so a target
