+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { createCppSyntaxGate } from '../../../scripts/cppSyntaxGate.js';
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource, lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// `x instanceof T` is a runtime kind test, and C++ has no such operator: emitted as source text the keyword
+// reaches the translation unit and the header stops at the parse, which is neither the source's answer nor a
+// refusal. The guard lowers onto `flight::union_kind_if`, and the projection the guard proves lowers onto
+// `flight::union_kind_or_throw` -- ONE mechanism, so a guard can never admit a value the projection behind it
+// cannot produce. The runtime arms of that mechanism are pinned in tests/union_kind_test.cpp; this file pins
+// what the emitter does with it.
+//
+// The measured sites are `@flighthq/audio`'s `audioResourceFrom.ts` and `@flighthq/loader`'s `load.ts`, whose
+// operand is the property `response.body` of `NetResponseBody` = `string | unknown | ArrayBuffer | Blob |
+// null`. They are reproduced here exactly, including the `unknown` segment the emitter stores as the erased
+// arm beside the named ones.
+
+const repositoryRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const cppSyntaxGate = createCppSyntaxGate(repositoryRoot);
+
+function lower(file: string, source: string, profileTypeNames?: readonly string[]) {
+  const sourceFile = ts.createSourceFile(
+    `/flight/packages/math/src/${file}`,
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  return lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/math',
+    upstreamDirectory: '/flight',
+    ...(profileTypeNames === undefined ? {} : { profileTypeNames }),
+  });
+}
+
+// `Blob` is a type the profile provides through a declared external binding rather than through the
+// compiler's own runtime table, so the manifest that names it is part of the fixture AND the explicit input
+// the analysis is given. `NetResponseBody` names it without importing it, exactly as the source does.
+const externalBindings = {
+  bindings: [
+    {
+      headers: ['flight/blob.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'Blob',
+      space: 'type' as const,
+      targetName: 'flight::Blob',
+    },
+    {
+      headers: ['flight/blob.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'Blob',
+      space: 'value' as const,
+      targetName: 'flight::Blob',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(file: string, source: string, profileTypeNames?: readonly string[]) {
+  return emitIrModuleCpp(lower(file, source, profileTypeNames).module, {
+    externalBindings,
+    runtimeProfile: 'flight-cpp',
+  }).contents;
+}
+
+function captureBackendEmissionFailure(run: () => unknown) {
+  try {
+    run();
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error;
+    throw error;
+  }
+  throw new Error('expected C++ emission to refuse and it did not');
+}
+
+const NET_RESPONSE_BODY = 'string | unknown | ArrayBuffer | Blob | null';
+
+describe('C++ instanceof lowering', () => {
+  it('lowers the guard and the projection onto one carrier-kind question', () => {
+    const contents = emit(
+      'runtime-kind-property.ts',
+      `export interface Obj { body: string | ArrayBuffer | URL | null; }
+       export function f(o: Obj): Uint8Array | null {
+         return o.body instanceof ArrayBuffer ? new Uint8Array(o.body) : null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('(flight::union_kind_if<flight::ArrayBuffer>(o->body) != nullptr)');
+    // No erased arm in this union, so the projection stays on the slot the source's own alternative holds.
+    expect(contents).toContain('flight::Uint8Array(std::get<0>(o->body.value()))');
+  });
+
+  it('projects a union that carries the erased arm through the throwing twin of the same question', () => {
+    const contents = emit(
+      'runtime-kind-erased-arm.ts',
+      `export interface Obj { body: string | unknown | ArrayBuffer | null; }
+       export function f(o: Obj): Uint8Array | null {
+         return o.body instanceof ArrayBuffer ? new Uint8Array(o.body) : null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('(flight::union_kind_if<flight::ArrayBuffer>(o->body) != nullptr)');
+    // `std::get` would throw for a value the guard admitted from the erased arm; the guard's own question
+    // answers it instead, which is the whole point of routing both through one function.
+    expect(contents).toContain('flight::Uint8Array(flight::union_kind_or_throw<flight::ArrayBuffer>(o->body))');
+    expect(contents).not.toContain('std::get<0>(o->body.value())');
+  });
+
+  it('answers the measured site: the guard and the projection for NetResponseBody', () => {
+    const source = `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`;
+    const contents = emit('runtime-kind-site.ts', source, ['Blob']);
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('(flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr)');
+    expect(contents).toContain('flight::union_kind_or_throw<flight::ArrayBuffer>(response->body)');
+    // The carrier kept the alternative the profile provides, which is what makes the union evidence whole.
+    expect(contents).toContain(
+      'std::optional<std::variant<flight::ArrayBuffer, flight::Blob, flight::String, flight::Any>> body;',
+    );
+  });
+
+  it('keeps no evidence for a name the loaded profiles do not provide', () => {
+    const source = `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`;
+    // The same source with nothing threaded: the analysis may not assume `Blob` is a type, so the union
+    // loses that alternative along with the proof every guard on the union reads -- and the guarded read
+    // has nothing to project through, which is what the two assertions below are: with the name the read
+    // is projected, without it the whole carrier is handed on.
+    //
+    // The consequence is a header the target refuses to compile, not a named emission refusal: the emitter
+    // spells the carrier from the declaration whether or not the analysis kept it, so there is nothing left
+    // at the emission site to detect. That boundary is recorded in the request.
+    const withoutNames = emit('runtime-kind-no-profiles.ts', source);
+    expect(withoutNames).toContain('flight::Uint8Array(response->body)');
+    expect(withoutNames).not.toContain('union_kind_or_throw');
+    const withNames = emit('runtime-kind-named-profiles.ts', source, ['Blob']);
+    expect(withNames).toContain('flight::Uint8Array(flight::union_kind_or_throw<flight::ArrayBuffer>(response->body))');
+  });
+
+  it('answers the measured site through the pipeline entry, not only the single-module one', () => {
+    // The two entries differ in where the per-module options come from, and the profile names have to reach
+    // the context through both: a control that only calls the single-module lowering cannot see the
+    // pipeline dropping them.
+    const fileName = '/flight/packages/math/src/runtime-kind-pipeline.ts';
+    const sourceFile = ts.createSourceFile(
+      fileName,
+      `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`,
+      ts.ScriptTarget.Latest,
+      true,
+    );
+    const emitted = lowerTypeScriptSources(
+      [{ packageName: '@flighthq/math', packageRoot: '/flight/packages/math', sourceFile, upstreamDirectory: '/flight' }],
+      undefined,
+      { profileTypeNames: ['Blob'] },
+    ).map((result) => emitIrModuleCpp(result.module, { externalBindings, runtimeProfile: 'flight-cpp' }).contents);
+    expect(emitted[0]).toContain('flight::union_kind_or_throw<flight::ArrayBuffer>(response->body)');
+  });
+
+  it('keeps the union-evidence path a binding already had', () => {
+    const contents = emit(
+      'runtime-kind-binding.ts',
+      `export function f(body: ${NET_RESPONSE_BODY}): Uint8Array | null {
+         return body instanceof ArrayBuffer ? new Uint8Array(body) : null;
+       }`,
+      ['Blob'],
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('body.has_value() && body.value().index() == 0');
+    expect(contents).toContain('flight::Uint8Array(std::get<0>(body.value()))');
+  });
+
+  it('selects by the alternative the target names, not by the order the union was written in', () => {
+    const contents = emit(
+      'runtime-kind-typed-arrays.ts',
+      `export function f(source: Uint8Array | Uint32Array): boolean {
+         return source instanceof Uint32Array;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return source.index() == 0;');
+  });
+
+  it('answers a nullable single alternative by its presence', () => {
+    const contents = emit(
+      'runtime-kind-optional.ts',
+      `export function f(value: ArrayBuffer | null): boolean { return value instanceof ArrayBuffer; }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return value.has_value();');
+  });
+
+  it('keeps the polarity the source wrote', () => {
+    const contents = emit(
+      'runtime-kind-negated.ts',
+      `export interface R { body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): boolean { return !(response.body instanceof Blob); }`,
+      ['Blob'],
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return !(flight::union_kind_if<flight::Blob>(response->body) != nullptr);');
+  });
+
+  it('lowers an instanceof over an erased operand onto the same mechanism', () => {
+    const contents = emit(
+      'runtime-kind-erased.ts',
+      `export function f(value: unknown): boolean { return value instanceof ArrayBuffer; }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('return (flight::union_kind_if<flight::ArrayBuffer>(value) != nullptr);');
+  });
+
+  it('keeps the checked Error view for an erased Error test', () => {
+    const contents = emit(
+      'runtime-kind-error.ts',
+      `export function f(cause: unknown): string | null {
+         if (cause instanceof Error) return cause.message;
+         return null;
+       }`,
+    );
+    expect(contents).not.toContain('instanceof');
+    expect(contents).toContain('cause.error_if() != nullptr');
+    expect(contents).toContain('cause.error_if()->message()');
+  });
+
+  it('emits C++ the target compiler accepts for the lowered guard', () => {
+    if (!cppSyntaxGate.available) return;
+    const contents = emit(
+      'runtime-kind-syntax.ts',
+      `export interface Obj { body: string | unknown | ArrayBuffer | null; }
+       export function f(o: Obj): Uint8Array | null {
+         return o.body instanceof ArrayBuffer ? new Uint8Array(o.body) : null;
+       }`,
+    );
+    expect(cppSyntaxGate.checkCppSourceSyntax(contents, 'instanceof-erased-arm').ok).toBe(true);
+  });
+
+  it('refuses a target that names a source-declared class', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-local-class.ts',
+        `class Widget { n = 1; }
+         export function f(value: unknown): boolean { return value instanceof Widget; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-target-unavailable');
+  });
+
+  it('refuses an ambient name with no runtime carrier', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit('runtime-kind-object.ts', `export function f(value: unknown): boolean { return value instanceof Object; }`),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-target-unavailable');
+  });
+
+  it('refuses an operand whose recorded type is neither an erased carrier nor a union', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-concrete.ts',
+        `export function f(value: ArrayBuffer): boolean { return value instanceof Uint8Array; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-operand-unresolved');
+  });
+
+  it('refuses a union that neither names the target nor carries the erased arm', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'runtime-kind-absent.ts',
+        `export function f(value: string | number): boolean { return value instanceof ArrayBuffer; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-member-unresolved');
+    expect(failure.message).toContain('needs the operand');
+  });
+});
