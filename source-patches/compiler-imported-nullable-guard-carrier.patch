+// The consumer calls an imported function whose declared return type is an interface the provider
+// does not export. `exported` controls only that visibility; the source shape is otherwise the same.
+function emitImportedNullableGuard(
+  file: string,
+  exported: boolean,
+  body = 'return widget !== null ? widget.value : -1;',
+  initializer = 'makePresent() : null',
+): string {
+  const providerSource = `${exported ? 'export ' : ''}interface Widget { value: number }
+     export function makePresent(): Widget { return { value: 1 }; }`;
+  const consumerSource = `import { makePresent } from './${file}.ts';
+     export function pick(cond: boolean): number {
+       const widget = cond ? ${initializer};
+       ${body}
+     }`;
+  const moduleResolution = freshImportedNullableGuardResolution();
+  const source = (name: string, text: string) => ({
+    packageName: '@flighthq/probe',
+    sourceFile: ts.createSourceFile(`/flight/packages/probe/src/${name}`, text, ts.ScriptTarget.Latest, true),
+    upstreamDirectory: '/flight',
+  });
+  const [provider, consumer] = lowerTypeScriptSources(
+    [source(`${file}.ts`, providerSource), source('consumer.ts', consumerSource)],
+    moduleResolution,
+  ).map((result) => result.module);
+  const session = createCppCompilerBackend().createEmissionSession!({
+    moduleResolution,
+    modules: [provider, consumer],
+    options: { runtimeProfile: 'flight-cpp' },
+  });
+  return session.emitModule(consumer!)[0]!.contents;
+}
