+ ['optional invocation', producer+`export function run(text:string):boolean{return parseJsonObject?.(text)!==null;}`],
+];
+it.each(exclusions)('retains the preceding nullable producer lane for %s', (_name, source) => {
+ const output=attempt(source); if(output) expect(output).not.toContain('std::optional<flight::NamedProperties> parse_json_object');
+});
+it.each([
