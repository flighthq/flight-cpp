+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const result = lowerTypeScriptSource(ts.createSourceFile('/flight/packages/example/src/registration.ts', source, ts.ScriptTarget.Latest, true), { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+function attempt(source: string): string | undefined {
+  try { return emit(source); } catch (error) {
+    if (typeof error !== 'object' || error === null || !('kind' in error) || error.kind !== 'backend-emission') throw error;
+    return undefined;
+  }
+}
+const producer = `function parseJsonObject(text:string):Record<string,unknown>|null{try{const value:unknown=JSON.parse(text);return value!==null&&typeof value==='object'&&!Array.isArray(value)?(value as Record<string,unknown>):null;}catch{return null;}}`;
+const read = `export function run(text:string):unknown{const obj=parseJsonObject(text);return obj!==null?obj.marker:undefined;}`;
+it.each([
+ ['guarded property', read],
+ ['guarded index', read.replace('obj.marker', "obj['marker']")],
+ ['opposite strict branch', read.replace('obj!==null?obj.marker:undefined', 'obj===null?undefined:obj.marker')],
+ ['short circuit', `export function run(text:string):boolean{const obj=parseJsonObject(text);return obj!==null&&obj.marker!==undefined;}`],
+ ['private reader', `function read(obj:Record<string,unknown>):unknown{return obj.marker;}export function run(text:string):unknown{const obj=parseJsonObject(text);return obj!==null?read(obj):undefined;}`],
+ ['direct null test', `export function run(text:string):boolean{return parseJsonObject(text)!==null;}`],
+] as const)('retains the original nullable JSON owner for %s', (_name, source) => {
+ const output=emit(producer+source);
