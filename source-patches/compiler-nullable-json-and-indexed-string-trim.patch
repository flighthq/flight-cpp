+ ['wrong branch', read.replace('obj!==null?obj.marker:undefined','obj===null?obj.marker:undefined')],
+] as const)('requires the original positive null guard: %s', (_name, source) => {expect(attempt(producer+source)).toBeUndefined();});
+it.each([
