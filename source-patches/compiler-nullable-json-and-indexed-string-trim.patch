+ expect(output).toContain('std::optional<flight::NamedProperties>{flight::named_properties(value)}');
+ expect(output).not.toContain('static_cast<flight::Record');
+});
+const exclusions: readonly (readonly [string,string])[] = [
+ ['public producer', producer.replace('function parseJsonObject','export function parseJsonObject')+read],
+ ['returned call', producer+`export function run(text:string):Record<string,unknown>|null{return parseJsonObject(text);}`],
+ ['returned local', producer+read.replace('return obj!==null?obj.marker:undefined','return obj')],
+ ['alias', producer+read.replace('return obj!==null?', 'const alias=obj;return obj!==null?')],
+ ['identity', producer+read.replace('return obj!==null?obj.marker:undefined', 'return obj===parseJsonObject(text)')],
+ ['capture', producer+read.replace('return obj!==null?obj.marker:undefined', 'return ()=>obj')],
+ ['mutable local', producer+read.replace('const obj=', 'let obj=')],
+ ['mutation', producer+read.replace('return obj!==null?', 'if(obj!==null)obj.marker=3;return obj!==null?')],
+ ['nested mutation', producer+read.replace('return obj!==null?', 'if(obj!==null)(obj.marker as Record<string,unknown>).x=3;return obj!==null?')],
+ ['opaque sink', producer+`export function sink(v:unknown):void{}`+read.replace('return obj!==null?', 'sink(obj);return obj!==null?')],
+ ['global', producer+`const obj=parseJsonObject('{}');export function run():boolean{return obj!==null;}`],
+ ['producer callback', producer+`export function run(){return parseJsonObject;}`],
+ ['missing array guard', producer.replace('&&!Array.isArray(value)', '')+read],
+ ['missing null guard', producer.replace('value!==null&&', '')+read],
+ ['missing typeof guard', producer.replace("typeof value==='object'&&", '')+read],
+ ['effectful guard', producer.replace('value!==null&&', 'effect()&&value!==null&&')+`export function effect():boolean{return true;}`+read],
+ ['extra parse', producer.replace('return value!==null', 'JSON.parse(text);return value!==null')+read],
+ ['catch rethrow', producer.replace('catch{return null;}', 'catch(e){throw e;}')+read],
