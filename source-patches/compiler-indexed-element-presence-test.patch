@@ -0,0 +1,71 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+// The single `return` line of the one function in `contents`.
+function returned(contents: string): string {
+  const line = contents.split('\n').find((candidate) => candidate.trim().startsWith('return '));
+  expect(line).toBeDefined();
+  return line!.trim();
+}
+
+const both = (test: string): string =>
+  `return ([&]() { const auto& presence_operand = s.get(i); return ${test}; }());`;
+
+// `Array<std::optional<T>>::get` answers `std::optional<std::optional<T>>`: the outer layer is the index
+// miss JavaScript reads as `undefined`, the inner layer the element's own null.
+describe('presence tests on a runtime array element', () => {
+  it.each([
+    ['!== null', '!presence_operand.has_value() || presence_operand.value().has_value()'],
+    ['=== null', 'presence_operand.has_value() && !presence_operand.value().has_value()'],
+    ['!= null', 'presence_operand.has_value() && presence_operand.value().has_value()'],
+    ['== null', '!presence_operand.has_value() || !presence_operand.value().has_value()'],
+    ['!== undefined', 'presence_operand.has_value()'],
+    ['=== undefined', '!presence_operand.has_value()'],
+  ])('tests both layers of a nullable element for %s', (operator, test) => {
+    const contents = emit(`export function t(s: (number | null)[], i: number): boolean { return s[i] ${operator}; }`);
+    expect(returned(contents)).toBe(both(test));
+  });
+
+  // A binding's declaration owns its storage, and a single-absence declaration may be flattened to one
+  // layer after emission, so the test dispatches on the carrier the binding actually has.
+  it('tests the same two layers through a binding that retained the element carrier', () => {
+    const contents = emit(
+      'export function t(s: (number | null)[], i: number): boolean { const v = s[i]; return v !== null; }',
+    );
+    expect(contents).toContain('const std::optional<std::optional<double>> v = s.get(i);');
+    expect(returned(contents)).toBe(
+      'return ([&](const auto& presence_operand) { if constexpr (flight::detail::optional_traits<std::remove_cvref_t<decltype(presence_operand.value())>>::optional) { return !presence_operand.has_value() || presence_operand.value().has_value(); } else { return presence_operand.has_value(); } }(v));',
+    );
+  });
+
+  it('reads a callable element the same way', () => {
+    const contents = emit(`export function t(s: ((() => void) | null)[], i: number): boolean { return s[i] !== null; }`);
+    expect(returned(contents)).toBe(both('!presence_operand.has_value() || presence_operand.value().has_value()'));
+  });
+
+  it('answers strict null from the type when both layers mean undefined, still evaluating the read', () => {
+    const contents = emit(`export function t(s: (number | undefined)[], i: number): boolean { return s[i] === null; }`);
+    expect(returned(contents)).toBe(both('static_cast<void>(presence_operand), false'));
+  });
+
+  it('tests either layer for undefined on an undefined element', () => {
+    const contents = emit(`export function t(s: (number | undefined)[], i: number): boolean { return s[i] !== undefined; }`);
+    expect(returned(contents)).toBe(both('presence_operand.has_value() && presence_operand.value().has_value()'));
+  });
+
+  it('never reads an index miss as null on an element with no absence of its own', () => {
+    const strict = emit(`export function t(s: number[], i: number): boolean { return s[i] !== null; }`);
+    expect(returned(strict)).toBe(both('static_cast<void>(presence_operand), true'));
+    const loose = emit(`export function t(s: number[], i: number): boolean { return s[i] != null; }`);
+    expect(returned(loose)).toBe(both('presence_operand.has_value()'));
+  });
+});
