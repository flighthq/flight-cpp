+interface CppIndexedNullableElementPresencePlan {
+  // The sentinel the element type stores as optional absence, i.e. what the inner layer means.
+  // `none` when the element type stores no absence: then only the outer layer exists.
+  readonly elementSentinel: 'null' | 'undefined' | 'none';
+  // The two-layer carrier: the `Array::get` read itself, or the binding that retained it.
+  readonly value: string;
+  // Whether `value` names a binding, whose declared storage may have been flattened to one layer.
+  readonly binding: boolean;
+}
+
+// Whether a presence test's operand is a runtime array element whose carrier has two absence layers:
+// `Array<std::optional<T>>::get` answers `std::optional<std::optional<T>>`. The read is either written
+// directly or retained by an immutable binding the array-element lane gave the same carrier. An element
+// type with no optional absence has one layer, and a RegExpExecArray capture has its own accessor, so
+// neither is claimed here.
+function getCppIndexedNullableElementPresencePlanCpp(
+  operand: Readonly<IrExpression>,
+  context: EmitContext,
+): CppIndexedNullableElementPresencePlan | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  let element: Readonly<Extract<IrExpression, { kind: 'element' }>> | undefined;
+  let value: (() => string) | undefined;
+  if (operand.kind === 'element') {
+    element = operand;
+    value = () => emitOptionalExpressionCpp(operand, context, undefined);
+  } else if (
+    operand.kind === 'identifier' &&
+    operand.reference.kind === 'binding' &&
+    context.arrayElementBindingIds.has(operand.reference.binding.id)
+  ) {
+    const initializer = context.bindingInitializers.get(operand.reference.binding.id);
+    if (initializer?.kind === 'element') element = initializer;
+    const reference = operand.reference;
+    value = () => emitIdentifierReference(reference, context);
+  }
+  if (
+    !element ||
+    !value ||
+    element.optional ||
+    hasCppRegExpExecArrayIndexedReceiverCpp(element, context) ||
+    !hasIndexedRuntimeReceiverCpp(element, context) ||
+    hasOnlyCppTypedArrayIndexedReceiversCpp(element, context)
+  ) {
+    return undefined;
+  }
+  const array = getIrArrayTypeCpp(getIrExpressionTypeEvidenceCpp(element.object, context), context, new Set());
+  const union = array ? getIrUnionTypeCpp(array.element, context, new Set()) : undefined;
+  if (!array) return undefined;
+  const plan = union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  // An element type that is not a union, or a union with neither sentinel, stores no absence of its own.
+  // Any other carrier for a sentinel (a tagged variant, a null-tagged owner) keeps its own lanes.
+  const elementSentinel = !plan
+    ? 'none'
+    : plan.sentinels.null === 'absent' && plan.sentinels.undefined === 'absent'
+      ? 'none'
+      : (plan.kind === 'optionalSingle' || plan.kind === 'optionalVariant') && plan.sentinels.null === 'optionalAbsence'
+        ? 'null'
+        : (plan.kind === 'optionalSingle' || plan.kind === 'optionalVariant') &&
+            plan.sentinels.undefined === 'optionalAbsence'
+          ? 'undefined'
+          : undefined;
+  return elementSentinel ? { binding: operand.kind === 'identifier', elementSentinel, value: value() } : undefined;
+}
