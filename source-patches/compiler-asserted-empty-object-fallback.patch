+// `(left ?? {}) as Target`, the shape of initializeHost's every group: `(capabilities.audio ?? {}) as Host['audio']`.
+// Two things go wrong when it is lowered piece by piece. `left` is often a read through a row over a type
+// parameter, whose storage is a std::optional for one instantiation and a required Ref for another, so the
+// `.value_or` chosen from the constraint does not exist on the Ref. And the empty literal, lowered with no
+// destination, becomes an anonymous struct that converts to nothing. The assertion names the destination: the
+// fallback is an empty `Target`, and `flight::nullish_or` tests absence in whatever storage `left` turns out to
+// have, evaluating the fallback only when it is needed.
+function emitCppAssertedEmptyObjectFallbackCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'cast' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  const inner = expression.expression;
+  if (inner.kind !== 'binary' || inner.operator !== '??') return undefined;
+  if (inner.right.kind !== 'object' || inner.right.members.length !== 0) return undefined;
+  if (!hasFlightReferenceRepresentationCpp(expression.type, context)) return undefined;
+  const target = emitType(expression.type, context);
+  const fallback = emitExpression(inner.right, context, expression.type);
+  const left = emitExpression(inner.left, context);
+  context.includes.add('flight/presence.hpp');
+  return `flight::nullish_or<${target}>(${left}, [&]() -> ${target} { return ${fallback}; })`;
+}
