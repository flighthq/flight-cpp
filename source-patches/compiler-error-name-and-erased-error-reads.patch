+// Lowering it here is also what lets the read inside the branch go straight through the projection --
+// the guard is the proof that it is present, so no value is invented and no proof is widened.
+function emitCppErasedErrorInstanceOfCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'binary' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expression.operator !== 'instanceof') {
+    return undefined;
