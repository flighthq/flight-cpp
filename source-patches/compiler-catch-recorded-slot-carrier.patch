@@ -0,0 +1,119 @@
+import { describe, expect, it } from 'vitest';
+import ts from 'typescript';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+
+import { createCppCompilerBackend } from './cppCompilerBackend.js';
+
+// The carrier a catch/attempt-all pattern records into.
+//
+// `let failure: unknown = null` is the "no failure yet" state of an attempt-all teardown, and an empty
+// `std::exception_ptr` already means exactly that. The rule that elects `std::exception_ptr` used to
+// require a slot with NO initializer, an `=` record, and no read other than the record and the rethrow,
+// so this shape -- initialized, recorded with `??=`, and tested with `!== null` -- stayed on the erased
+// `flight::Any` path, which cannot hold a caught exception at all.
+function emit(source: string): string {
+  const lowering = lowerTypeScriptSource(
+    ts.createSourceFile('/flight/packages/power/src/probe.ts', source, ts.ScriptTarget.Latest, true),
+    { packageName: '@flighthq/power', upstreamDirectory: '/flight' },
+  );
+  const module = lowering.module;
+  const session = createCppCompilerBackend().createEmissionSession!({
+    modules: [module],
+    options: {
+      packageTargets: { '@flighthq/power': { includePrefix: 'flight/power', namespace: 'flight::power' } },
+      runtimeProfile: 'flight-cpp',
+    },
+  });
+  return session.emitModule(module)[0]!.contents;
+}
+
+const ATTEMPT_ALL = `
+export function teardown(values: readonly number[]): void {
+  let failure: unknown = null;
+  for (const value of values) {
+    try {
+      if (value > 1) throw new Error('too big');
+    } catch (error) {
+      failure ??= error;
+      continue;
+    }
+  }
+  if (failure !== null) throw failure;
+}
+`;
+
+describe('the slot an attempt-all teardown records into', () => {
+  it('is the exception carrier, recorded once and rethrown', () => {
+    const contents = emit(ATTEMPT_ALL);
+    // The declaration keeps the source's `null` as an empty pointer, which is the same "no failure
+    // recorded yet" state.
+    expect(contents).toContain('std::exception_ptr failure = nullptr;');
+    expect(contents).not.toContain('flight::Any failure = nullptr;');
+    // The record keeps the FIRST failure: an empty pointer is the slot's nullish state, so a later
+    // caught error cannot overwrite the one already recorded.
+    expect(contents).toContain('if (!failure) failure = std::current_exception();');
+    expect(contents).toContain('std::rethrow_exception(failure)');
+  });
+
+  it('answers its nullish test with the pointer, not the erased carrier', () => {
+    const contents = emit(ATTEMPT_ALL);
+    // `failure !== null` asks whether a failure was recorded, so the pointer's own truth is the answer
+    // (and the reverse spelling emits its negation).
+    expect(contents).toContain('return presence_operand;');
+    expect(contents).not.toContain('is_null()');
+  });
+
+  it('leaves an ordinary unknown slot on the dynamic-value carrier', () => {
+    // The same declaration, initialized to null, but holding a plain value and never thrown: nothing
+    // about it is a caught-exception slot, so the erased carrier is right and must survive.
+    const contents = emit(`
+export function note(): unknown {
+  let note: unknown = null;
+  note = 'text';
+  return note;
+}
+`);
+    expect(contents).toContain('flight::Any note');
+    expect(contents).not.toContain('exception_ptr');
+  });
+
+  it('leaves a recorded slot that is never rethrown on the dynamic-value carrier', () => {
+    const contents = emit(`
+export function count(values: readonly number[]): unknown {
+  let failure: unknown = null;
+  for (const value of values) {
+    try {
+      if (value > 1) throw new Error('too big');
+    } catch (error) {
+      failure ??= error;
+    }
+  }
+  return failure;
+}
+`);
+    expect(contents).toContain('flight::Any failure');
+    expect(contents).not.toContain('exception_ptr');
+  });
+
+  it('leaves a slot that is read for anything but its presence on the dynamic-value carrier', () => {
+    // The extra read is what distinguishes a slot this rule may carry as an exception pointer from one
+    // whose value other code consumes: an exception pointer cannot supply the original value.
+    const contents = emit(`
+export function observed(values: readonly number[]): unknown {
+  let failure: unknown = null;
+  for (const value of values) {
+    try {
+      if (value > 1) throw new Error('too big');
+    } catch (error) {
+      failure ??= error;
+    }
+  }
+  if (failure !== null) throw failure;
+  return failure;
+}
+`);
+    expect(contents).toContain('flight::Any failure');
+    expect(contents).not.toContain('exception_ptr');
+  });
+});
