+// Keep the indexed local's undefined/null carrier intact until a member is actually evaluated.
+// A source null guard narrows its payload, but does not prove an unchecked Array index exists.
+function emitCppGuardedIndexedNullableMemberCpp(
+  expression: Readonly<IrExpression>,
+  context: EmitContext,
+  render: (next: EmitContext) => string,
+): string | undefined {
+  const access =
+    expression.kind === 'call' && expression.callee.kind === 'property'
+      ? expression.callee
+      : expression.kind === 'property' || expression.kind === 'element'
+        ? expression
+        : undefined;
+  if (
+    !access ||
+    access.optional ||
+    (access.kind === 'property' ? access.optionalChain !== undefined : access.semantics.optionalChain !== undefined) ||
+    context.indexedNullableReadExpressions?.has(access.object)
+  )
+    return undefined;
+  const receiver = access.object;
+  if (receiver.kind !== 'identifier' || receiver.reference.kind !== 'binding') return undefined;
+  const id = receiver.reference.binding.id;
+  if (
+    !context.immutableInitializerBindingIds.has(id) ||
+    context.lengthProvenNullableArrayElementBindingIds.has(id) ||
+    !hasCppPresentBindingStorageProofCpp(receiver, context)
+  )
+    return undefined;
+  const type = getIrExpressionTypeEvidenceCpp(receiver, context);
+  if (!type || hasIrTypeAbsentMember(type)) return undefined;
+  const plan = getCppIndexedNullableElementPresencePlanCpp(receiver, context);
+  if (!plan?.binding || plan.elementSentinel === 'none') return undefined;
+  const initializer = context.bindingInitializers.get(id);
+  if (initializer?.kind !== 'element') return undefined;
+  const array = getIrArrayTypeCpp(getIrExpressionTypeEvidenceCpp(initializer.object, context), context, new Set());
+  const union = array ? getIrUnionTypeCpp(array.element, context, new Set()) : undefined;
+  if (!union || getCppUnionRepresentationPlan(union, context).kind !== 'optionalSingle') return undefined;
+  context.includes.add('flight/error.hpp');
+  context.includes.add('flight/structural_ref.hpp');
+  context.includes.add('type_traits');
+  const project = (value: string): string =>
+    `([&](const auto& indexed_member) -> decltype(auto) { if (!indexed_member.has_value()) throw flight::TypeError("Cannot read properties of undefined"); if constexpr (flight::detail::optional_traits<std::remove_cvref_t<decltype(indexed_member.value())>>::optional) { if (!indexed_member.value().has_value()) throw flight::TypeError("Cannot read properties of ${plan.elementSentinel}"); return (indexed_member.value().value()); } else { return (indexed_member.value()); } }(${value}))`;
+  const substitutions = new Map(context.indexedNullableReadExpressions);
+  if (access.kind !== 'element') {
+    substitutions.set(receiver, project(plan.value));
+    return render({ ...context, indexedNullableReadExpressions: substitutions });
+  }
+  // JavaScript evaluates a computed key before requiring a non-nullish object. Cache both reads
+  // before the checked projection; a key's effects or exact exception must precede that TypeError.
+  const object = getGeneratedTargetName('indexedMemberObject', context);
+  const index = getGeneratedTargetName('indexedMemberKey', context);
+  const key = emitExpression(access.index, context);
+  substitutions.set(receiver, project(object));
+  substitutions.set(access.index, index);
+  const body = render({ ...context, indexedNullableReadExpressions: substitutions });
+  return `([&]() -> decltype(auto) { const auto& ${object} = ${plan.value}; const auto ${index} = ${key}; return ${body}; }())`;
+}
+
 interface CppIndexedNullableElementPresencePlan {
   // The sentinel the element type stores as optional absence, i.e. what the inner layer means.
   // `none` when the element type stores no absence: then only the outer layer exists.
