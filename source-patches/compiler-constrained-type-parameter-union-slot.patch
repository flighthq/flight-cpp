diff --git a/packages/compiler-backend-cpp/src/cppConstrainedTypeParameterStorage.test.ts b/packages/compiler-backend-cpp/src/cppConstrainedTypeParameterStorage.test.ts
new file mode 100644
index 0000000..ae9e684
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppConstrainedTypeParameterStorage.test.ts
@@ -0,0 +1,81 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+// The declaration line of local `name` in `contents`, trimmed.
+function declaration(contents: string, name: string): string {
+  const line = contents.split('\n').find((candidate) => new RegExp(`\\b${name} = `, 'u').test(candidate));
+  expect(line).toBeDefined();
+  return line!.trim();
+}
+
+const box = 'export interface Box<T> { items: (T | null)[]; one: T }\n';
+const callable = 'T extends (...args: any[]) => void';
+
+// A local whose type names a type parameter inside a union must store the parameter the values have, not
+// the carrier of its constraint, or the first copy from parameter-typed storage does not convert.
+describe('locals typed by a constrained type parameter', () => {
+  it.each([
+    ['inferred from a copy', 'const items = box.items.slice();', 'flight::Array<std::optional<T>> items = box->items.slice();'],
+    ['explicitly annotated', 'const items: (T | null)[] = box.items.slice();', 'flight::Array<std::optional<T>> items = box->items.slice();'],
+    ['read directly', 'const items = box.items;', 'flight::Array<std::optional<T>> items = box->items;'],
+  ])('keeps a callable-constrained parameter in an array local %s', (_, statement, expected) => {
+    const contents = emit(`${box}export function f<${callable}>(box: Box<T>): number { ${statement} return items.length; }`);
+    expect(declaration(contents, 'items')).toBe(expected);
+  });
+
+  it('keeps a callable-constrained parameter in an element local', () => {
+    const contents = emit(
+      `${box}export function f<${callable}>(box: Box<T>): number { const item = box.items[0]; return item === null ? 0 : 1; }`,
+    );
+    expect(declaration(contents, 'item')).toBe('std::optional<std::optional<T>> item = box->items.get(0.0);');
+  });
+
+  it('keeps an object-constrained parameter rather than erasing it', () => {
+    const contents = emit(
+      `${box}export function f<T extends object>(box: Box<T>): number { const items = box.items.slice(); return items.length; }`,
+    );
+    expect(declaration(contents, 'items')).toBe('flight::Array<std::optional<T>> items = box->items.slice();');
+  });
+
+  it('matches the unconstrained parameter, which already kept itself', () => {
+    const contents = emit(
+      `${box}export function f<T>(box: Box<T>): number { const items = box.items.slice(); return items.length; }`,
+    );
+    expect(declaration(contents, 'items')).toBe('flight::Array<std::optional<T>> items = box->items.slice();');
+  });
+
+  it('leaves a scalar constrained local as it was', () => {
+    const contents = emit(`${box}export function f<${callable}>(box: Box<T>): T { const one = box.one; return one; }`);
+    expect(declaration(contents, 'one')).toBe('T one = box->one;');
+  });
+
+  it('stores a parameter value into the parameter alternative it now has', () => {
+    const contents = emit(`${box}export function f<${callable}>(box: Box<T>, slot: T): void { box.items.push(slot); }`);
+    expect(contents).toContain('box->items.push(std::optional<T>{slot});');
+  });
+
+  it('still converts a parameter value into a union spelled with the constraint itself', () => {
+    const contents = emit(
+      `export interface Holder { items: (((...args: any[]) => void) | null)[] }\nexport function f<${callable}>(h: Holder, slot: T): void { h.items.push(slot); }`,
+    );
+    expect(contents).toContain('h->items.push(std::optional<std::function<void(flight::Array<flight::Any>)>>{slot});');
+  });
+
+  it('still opens a constraint that is itself a union of several domains', () => {
+    const contents = emit(
+      `${box}export function f<T extends string | number>(box: Box<T>): number { const items = box.items.slice(); return items.length; }`,
+    );
+    expect(declaration(contents, 'items')).toBe(
+      'flight::Array<std::optional<std::variant<double, flight::String>>> items = box->items.slice();',
+    );
+  });
+});
