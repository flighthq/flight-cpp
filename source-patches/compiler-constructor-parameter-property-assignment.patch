+// A constructor parameter property -- `constructor(readonly source: T)` -- declares a field AND assigns the
+// argument to it. The field is emitted with the other fields; this emits the assignment, at constructor body
+// entry after default parameter values are resolved, in field order, as the shared class-initialization plan
+// times it. A derived class's body already runs after its base initializer, which is TypeScript's
+// assign-after-super() order. A defaulted parameter is still its optional carrier here, now known present.
+function emitParameterPropertyAssignmentsCpp(declaration: Readonly<IrClassDeclaration>, context: EmitContext): string[] {
+  const constructor = declaration.classConstructor;
+  if (!constructor) return [];
+  const plan = createIrClassInitializationPlan(declaration);
+  const lines: string[] = [];
+  for (const initialization of plan.fields) {
+    if (initialization.value !== 'parameter' || initialization.parameterIndex === undefined) continue;
+    const field = declaration.fields[initialization.fieldIndex]!;
+    const parameter = constructor.parameters[initialization.parameterIndex]!;
+    const parameterTargetName = getBindingTargetName(parameter.binding, context);
+    const value = parameter.initializer ? `${parameterTargetName}.value()` : parameterTargetName;
+    lines.push(`this->${safeCppName(field.name)} = ${value};`);
+  }
+  return lines;
+}
