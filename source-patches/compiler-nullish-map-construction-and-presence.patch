-// Whether a `new Map(argument)` argument is itself a Map: a ReadonlyMap or Map value, whose entries the new
-// map must copy rather than share.
-function isCppMapCopySourceCpp(argument: Readonly<IrExpression>, context: EmitContext): boolean {
-  const type = getIrExpressionBindingTypeCpp(argument, context) ?? getIrExpressionTypeEvidenceCpp(argument, context);
-  const collection = type ? getIrAmbientCollectionTypeCpp(type, context, new Set()) : undefined;
-  return collection?.reference.name === 'Map' || collection?.reference.name === 'ReadonlyMap';
+// A Map constructor accepts a closed Map payload plus nullish sentinels. Inspect the declaration,
+// since flow narrowing must not project a second source read before construction handles absence.
+function getCppMapConstructorSourceTypeCpp(
+  argument: Readonly<IrExpression>,
+  context: EmitContext,
+): Readonly<IrType> | undefined {
+  if (argument.kind === 'undefinedValue') return { kind: 'undefined' };
+  if (argument.kind === 'literal' && argument.value === null) return { kind: 'null' };
+  const type = getCppNullishComparisonOperandTypeCpp(argument, context);
+  if (!type) return undefined;
+  if (type.kind === 'null' || type.kind === 'undefined') return type;
+  const payload = getCppNonNullableType(type, context, new Set());
+  const collection = payload ? getIrAmbientCollectionTypeCpp(payload, context, new Set()) : undefined;
+  return collection?.reference.name === 'Map' || collection?.reference.name === 'ReadonlyMap' ? type : undefined;
+}
+
+function emitCppMapConstructorCopyCpp(
+  argument: Readonly<IrExpression>,
+  value: string,
+  target: string,
+  context: EmitContext,
+): string {
+  const source = getCppMapConstructorSourceTypeCpp(argument, context)!;
+  if (source.kind === 'null' || source.kind === 'undefined') {
+    return `([&]() { static_cast<void>(${value}); return ${target}{}; }())`;
+  }
+  const union = getIrUnionTypeCpp(source, context, new Set());
+  const plan = union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  if (!plan || plan.kind === 'singleValue') return `${target}(${value}).clone()`;
+  const sourceName = getGeneratedTargetName('mapConstructorSource', context);
+  if (plan.kind === 'optionalSingle') {
+    return `([&]() { const auto ${sourceName} = ${value}; if (!${sourceName}.has_value()) return ${target}{}; return ${target}(${sourceName}.value()).clone(); }())`;
+  }
+  if (plan.kind === 'dualSentinelVariant' && plan.valueSlots.length === 1) {
+    context.includes.add('variant');
+    const payloadName = getGeneratedTargetName('mapConstructorPayload', context);
+    return `([&]() { const auto ${sourceName} = ${value}; if (const auto* ${payloadName} = std::get_if<${plan.valueSlots[0]!.targetType}>(&${sourceName})) return ${target}(*${payloadName}).clone(); return ${target}{}; }())`;
+  }
+  emissionError(
+    context,
+    'Map constructor requires one represented Map payload and nullish sentinels',
+    'cpp-map-constructor-source-unrepresented',
+  );
 }
 
