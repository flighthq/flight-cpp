+export function copyNullableMap(input: ReadonlyMap<string, Entry> | null | undefined): Map<string, Entry> { return new Map(input); }
+export function copyRequiredMap(input: ReadonlyMap<string, Entry>): Map<string, Entry> { return new Map(input); }
+export function copyUndefinedMap(): Map<string, Entry> { return new Map<string,Entry>(undefined); }
+export function copyNullMap(): Map<string, Entry> { return new Map<string,Entry>(null); }
+export function copyDefaultMap(input: ReadonlyMap<string,Entry> | undefined = undefined): Map<string,Entry> { return new Map(input); }
+export function copyGuardedMap(options: Readonly<Options>): Map<string,Entry> { if(options.map !== undefined) return new Map(options.map); return new Map<string,Entry>(); }
+export function copyKeyedMap(input: ReadonlyMap<Entry,Entry> | undefined): Map<Entry,Entry> { return new Map(input); }
+export function copyPasses(options: Readonly<Options>): Entry[] | null { return options.passes == null ? null : [...options.passes]; }
