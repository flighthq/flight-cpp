+// A generic helper reached through a readonly view: `@flighthq/signals` declares
+// `hasSignalSlots<T extends (...args: any[]) => void>(signal: Readonly<Signal<T>>): boolean`, and
+// `@flighthq/power` calls it with an `onIdleStateChange` narrowed to `Signal<() => void>`. The two
+// modules are separate because the helper has to be IMPORTED the way the real caller imports it: an
+// ambient `declare function` refuses earlier (`cpp-runtime-external-symbol-binding-incomplete`) and
+// never reaches the substitution this pins. `owner` names the interface the caller's argument is
+// declared as, so the same graph answers what happens when that owner and the parameter's differ.
+function lowerGenericReadonlyViewArgument(owner: string, argumentType: string) {
+  const signals = ts.createSourceFile(
+    '/flight/packages/signals/src/contract.ts',
+    `export interface Signal<T extends (...args: any[]) => void> { emit: T; data: object | null }
+     export interface Emitter<T extends (...args: any[]) => void> { emit: T; data: object | null }
+     export function hasSignalSlots<T extends (...args: any[]) => void>(
+       signal: Readonly<Signal<T>>,
+     ): boolean {
+       return signal.data !== null;
+     }`,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const consumer = ts.createSourceFile(
+    '/flight/packages/power/src/power.ts',
