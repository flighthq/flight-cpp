+  expression: Readonly<Extract<IrExpression, { kind: 'binary' }>>,
+  evidence: Readonly<IrMembershipTestEvidence>,
+  receiverType: Readonly<IrType>,
+  receiverCarrier: string,
+  context: EmitContext,
+): string {
+  const refuse = (why: string): never =>
+    emissionError(context, `a unique-symbol \`in\` ${why}`, 'cpp-membership-test-unrepresented');
