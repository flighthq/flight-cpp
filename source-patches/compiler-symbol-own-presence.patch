index 0000000..c3ea0e5
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppSymbolOwnPresence.test.ts
@@ -0,0 +1,70 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/symbolOwnPresence.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function refusal(source: string): string {
+  try {
+    emit(source);
+  } catch (error) {
+    return String(error);
+  }
+  throw new Error('expected a refusal');
+}
+
+const entity = `
+  export const RuntimeKey: unique symbol = Symbol('runtime');
+  export interface EntityRuntime { id: number }
+  export interface Entity { [RuntimeKey]: EntityRuntime | undefined }
+  export interface Material extends Entity { kind: string }
+  export type MaterialLike = Omit<Material, typeof RuntimeKey>;
+`;
+
+it('answers a unique-symbol `in` on a projected nominal receiver as written presence', () => {
+  const output = emit(`${entity}
+    export function isMaterialEntity(source: MaterialLike): boolean { return RuntimeKey in source; }
+  `);
+
+  expect(output).toContain('return flight::has_own_property(source, runtime_key);');
+  expect(output).not.toContain('runtime_key in source');
+});
+
+it('writes a literal computed-symbol member onto the constructed object, including undefined', () => {
+  const output = emit(`${entity}
+    export function withUndefined(): Material { return { [RuntimeKey]: undefined, kind: 'a' }; }
+    export function withValue(runtime: EntityRuntime): Material { return { [RuntimeKey]: runtime, kind: 'b' }; }
+  `);
+
+  expect(output).toContain(
+    'flight::row_set(flight::StructuralRef<flight::RowWritable<flight::RowOf<flight::Ref<Material>>>>(computed_construction), runtime_key, std::nullopt);',
+  );
+  expect(output).toMatch(/flight::row_set\(flight::StructuralRef<flight::RowWritable<flight::RowOf<flight::Ref<Material>>>>\(computed_construction_2\), runtime_key, [^;]*runtime[^;]*\);/);
+});
+
+it('refuses an asserted receiver, an optional declarer, and a side-effecting computed value', () => {
+  expect(
+    refusal(`${entity}
+      export function isEntity(value: unknown): boolean { return RuntimeKey in (value as Material); }
+    `),
+  ).toContain('ASSERTED receiver');
+  expect(
+    refusal(`${entity}
+      export interface Detached { [RuntimeKey]?: EntityRuntime; kind: string }
+      export function isAttached(source: MaterialLike): boolean { return RuntimeKey in source; }
+    `),
+  ).toContain('declares optional');
+  expect(
+    refusal(`${entity}
+      function makeRuntime(): EntityRuntime { return { id: 1 }; }
+      export function built(): Material { return { [RuntimeKey]: makeRuntime(), kind: 'c' }; }
+    `),
+  ).toContain('free of observable evaluation');
+});
