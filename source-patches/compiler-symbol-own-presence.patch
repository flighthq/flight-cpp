+// (`{ [EntityRuntimeKey]: runtime, kind }`) have no clause in it and were dropped: the value never reached
+// the object, and a member written with `undefined` was indistinguishable from one never written. Each
+// computed member is written onto the constructed object through the runtime's symbol write, which lands
+// on the member cell and records the write, so `key in object` afterwards is the source's answer. The
+// writes follow the construction, so a value whose evaluation could be observed is refused instead of
+// being reordered past the other members.
+function emitCppNominalComputedMemberConstructionCpp(
+  made: string,
+  storageType: string,
+  computedMembers: readonly Readonly<Extract<IrObjectMember, { kind: 'computedProperty' }>>[],
+  constructionProperties: readonly Readonly<IrObjectTypeProperty>[] | undefined,
+  context: EmitContext,
+): string {
+  const result = getGeneratedTargetName('computedConstruction', context);
