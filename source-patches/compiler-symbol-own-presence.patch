+// `uniqueSymbol in receiver`: the same three questions as a string key, answered by symbol identity. The
+// receiver's declaration is found by the unique symbol's property name; assignable declarers are the
+// analyzed computed property declarations whose key expression resolves to the same symbol.
+function getTypeScriptSymbolMembershipTestEvidence(
+  node: ts.BinaryExpression,
+  keyNode: ts.Expression,
+  keyType: ts.Type,
+  context: LoweringContext,
+): IrMembershipTestEvidence | undefined {
+  const keySymbol = resolveTypeScriptAliasedSymbol(context.checker.getSymbolAtLocation(keyNode), context);
+  if (!keySymbol) return undefined;
+  const receiverType = context.checker.getTypeAtLocation(node.right);
+  const escapedName = (keyType as ts.UniqueESSymbolType).escapedName;
+  const declared = context.checker.getPropertyOfType(receiverType, ts.unescapeLeadingUnderscores(escapedName));
+  let subtypes: IrMembershipTestEvidence['subtypes'] = 'none';
+  for (const declaration of getTypeScriptComputedPropertyDeclarationsFor(keySymbol, context)) {
+    const container = getTypeScriptPropertyContainerType(declaration, context);
+    if (!container || !isTypeScriptMembershipContainerAssignable(container, receiverType, context)) continue;
+    if (declaration.questionToken) {
+      subtypes = 'optional';
+      break;
+    }
+    subtypes = 'required';
+  }
+  return {
+    inherited: false,
+    key: { kind: 'symbol' },
+    receiver:
+      declared === undefined ? 'undeclared' : declared.flags & ts.SymbolFlags.Optional ? 'optional' : 'required',
+    subtypes,
+  };
+}
+
+function resolveTypeScriptAliasedSymbol(symbol: ts.Symbol | undefined, context: LoweringContext): ts.Symbol | undefined {
+  return symbol && symbol.flags & ts.SymbolFlags.Alias ? context.checker.getAliasedSymbol(symbol) : symbol;
+}
+
+function getTypeScriptComputedPropertyDeclarationsFor(
+  keySymbol: ts.Symbol,
+  context: LoweringContext,
+): readonly (ts.PropertyDeclaration | ts.PropertySignature)[] {
+  let index = typeScriptComputedPropertyDeclarationIndexes.get(context.checker);
+  if (!index) {
+    const built = new Map<ts.Symbol, (ts.PropertyDeclaration | ts.PropertySignature)[]>();
+    const visit = (candidate: ts.Node): void => {
+      if (
+        (ts.isPropertySignature(candidate) || ts.isPropertyDeclaration(candidate)) &&
+        ts.isComputedPropertyName(candidate.name)
+      ) {
+        const resolved = resolveTypeScriptAliasedSymbol(
+          context.checker.getSymbolAtLocation(candidate.name.expression),
+          context,
+        );
+        if (resolved) {
+          const entries = built.get(resolved);
+          if (entries) entries.push(candidate);
+          else built.set(resolved, [candidate]);
+        }
+      }
+      ts.forEachChild(candidate, visit);
+    };
