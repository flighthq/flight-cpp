+export function normalize(input: unknown, count: number): number[] {
+  const selected = Array.isArray(input) ? input : [input];
+  const alias = selected;
+  const result = new Array<number>(count);
+  for (let cursor = 0; cursor < count; cursor++) {
+    const numeric = Number(alias[cursor] ?? alias[0] ?? 9);
+    result[cursor] = Number.isFinite(numeric) ? numeric : -7;
+  }
