+export function guardedSize(value: number | number[]): number {
+  if (!Array.isArray(value) || value.length < 2) return -1;
+  return value.length;
+}
+export function conjunctionSize(value: number | number[]): number {
+  if (!(Array.isArray(value) && value.length >= 2)) return -1;
+  return value.length;
+}
