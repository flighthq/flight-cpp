+export function retained(input: unknown): unknown {
+  const selected = Array.isArray(input) ? input : [input];
+  const alias = selected;
+  return alias;
+}
+export function lazy(input: unknown, fallback: () => unknown): number {
+  const selected = Array.isArray(input) ? input : [input];
+  return Number(selected[0] ?? fallback());
+}
+export function zeroMap(values: number[], count: number): number[][] {
+  return values.map(() => new Array<number>(count).fill(4));
