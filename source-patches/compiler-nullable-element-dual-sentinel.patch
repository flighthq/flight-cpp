+// A source union with ONE sentinel is stored as a single std::optional: its empty state means that
+// sentinel and nothing else. A destination carrier that represents BOTH sentinels cannot take the
+// optional, because lifting it must name which arm the absence becomes -- null for a `T | null`
+// element, undefined for a `T | undefined` one -- and guessing or collapsing the two would change the
+// source's domain. Lift it without copying the owner: an engaged optional selects the value arm with
+// the same reference, an empty one selects exactly the source's own sentinel arm. The other sentinel
+// stays reachable only from source-level undefined code, which this conversion never produces.
+function emitCppSingleSentinelIntoDualSentinelCpp(
+  expression: Readonly<IrExpression>,
+  expectedUnion: Readonly<Extract<IrType, { kind: 'union' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  const sourceType = getIrExpressionTypeEvidenceCpp(expression, context);
+  const sourceUnion = sourceType ? getIrUnionTypeCpp(sourceType, context, new Set()) : undefined;
+  const sourcePlan = sourceUnion ? getCppUnionRepresentationPlan(sourceUnion, context) : undefined;
+  if (!sourceUnion || sourcePlan?.kind !== 'optionalSingle' || sourcePlan.valueSlots.length !== 1) return undefined;
+  const nullAbsence = sourcePlan.sentinels.null !== 'absent';
+  const undefinedAbsence = sourcePlan.sentinels.undefined !== 'absent';
+  if (nullAbsence === undefinedAbsence) return undefined;
+  const expectedPlan = getCppUnionRepresentationPlan(expectedUnion, context);
+  if (expectedPlan.kind !== 'dualSentinelVariant') return undefined;
+  const sentinel = nullAbsence ? 'null' : 'undefined';
+  const valueName = getGeneratedTargetName('liftedOptional', context);
+  const valueSlot = sourcePlan.valueSlots[0]!;
+  const present = emitCppUnionValueConstruction(
+    `${valueName}.value()`,
+    valueSlot.targetType,
+    expectedUnion,
+    expectedPlan.kind,
+    context,
+  );
+  const absence = emitCppUnionSentinelConstruction(sentinel, expectedUnion, expectedPlan.kind, context);
+  const resultType = emitUnionTypeCpp(expectedUnion, context);
+  context.includes.add('optional');
+  context.includes.add('variant');
+  return `([&]() -> ${resultType} { auto ${valueName} = ${emitExpression(expression, context)}; if (!${valueName}.has_value()) return ${absence}; return ${present}; }())`;
+}
+
+// A nullable array element has TWO distinct absences in the runtime: `Array::get(double)` answers an
+// empty OUTER optional for an index JavaScript reads as undefined (fractional, NaN, negative, or past
+// the end) and an engaged outer optional holding an empty INNER optional for a stored null element.
+// That is exactly the distinction the dual-sentinel destination needs, so lift the indexed read
+// directly instead of guessing from the declared `T | null`: evaluate the array then the index once
+// (JavaScript order), map an absent index to the Undefined arm, an empty stored element to the
+// element union's own sentinel arm, and a present element to the value arm with the same reference.
+function emitCppNullableElementIntoDualSentinelCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'element' }>>,
+  expectedUnion: Readonly<Extract<IrType, { kind: 'union' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expression.optional) return undefined;
+  const sourceType = getIrExpressionTypeEvidenceCpp(expression, context);
+  const sourceUnion = sourceType ? getIrUnionTypeCpp(sourceType, context, new Set()) : undefined;
+  const sourcePlan = sourceUnion ? getCppUnionRepresentationPlan(sourceUnion, context) : undefined;
+  if (!sourceUnion || sourcePlan?.kind !== 'optionalSingle' || sourcePlan.valueSlots.length !== 1) return undefined;
+  const expectedPlan = getCppUnionRepresentationPlan(expectedUnion, context);
+  if (expectedPlan.kind !== 'dualSentinelVariant') return undefined;
+  const nullAbsence = sourcePlan.sentinels.null !== 'absent';
+  const undefinedAbsence = sourcePlan.sentinels.undefined !== 'absent';
+  if (nullAbsence === undefinedAbsence) return undefined;
+  const sentinel = nullAbsence ? 'null' : 'undefined';
+  const arrayName = getGeneratedTargetName('liftedElementArray', context);
+  const indexName = getGeneratedTargetName('liftedElementIndex', context);
+  const elementName = getGeneratedTargetName('liftedElement', context);
+  const resultType = emitUnionTypeCpp(expectedUnion, context);
+  const missingArm = emitCppUnionSentinelConstruction('undefined', expectedUnion, expectedPlan.kind, context);
+  const storedAbsenceArm = emitCppUnionSentinelConstruction(sentinel, expectedUnion, expectedPlan.kind, context);
+  const presentArm = emitCppUnionValueConstruction(
+    `${elementName}.value().value()`,
+    sourcePlan.valueSlots[0]!.targetType,
+    expectedUnion,
+    expectedPlan.kind,
+    context,
+  );
+  context.includes.add('optional');
+  context.includes.add('variant');
+  return `([&]() -> ${resultType} { const auto& ${arrayName} = ${emitExpression(expression.object, context)}; const double ${indexName} = ${emitExpression(expression.index, context)}; auto ${elementName} = ${arrayName}.get(${indexName}); if (!${elementName}.has_value()) return ${missingArm}; if (!${elementName}.value().has_value()) return ${storedAbsenceArm}; return ${presentArm}; }())`;
+}
