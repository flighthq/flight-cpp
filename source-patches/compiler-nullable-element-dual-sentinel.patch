+// A source union with ONE sentinel is stored as a single std::optional: its empty state means that
+// sentinel and nothing else. A destination carrier that represents BOTH sentinels cannot take the
+// optional, because lifting it must name which arm the absence becomes -- null for a `T | null`
+// element, undefined for a `T | undefined` one -- and guessing or collapsing the two would change the
+// source's domain. Lift it without copying the owner: an engaged optional selects the value arm with
+// the same reference, an empty one selects exactly the source's own sentinel arm. The other sentinel
+// stays reachable only from source-level undefined code, which this conversion never produces.
+function emitCppSingleSentinelIntoDualSentinelCpp(
+  expression: Readonly<IrExpression>,
+  expectedUnion: Readonly<Extract<IrType, { kind: 'union' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  const sourceType = getIrExpressionTypeEvidenceCpp(expression, context);
+  const sourceUnion = sourceType ? getIrUnionTypeCpp(sourceType, context, new Set()) : undefined;
+  const sourcePlan = sourceUnion ? getCppUnionRepresentationPlan(sourceUnion, context) : undefined;
+  if (!sourceUnion || sourcePlan?.kind !== 'optionalSingle' || sourcePlan.valueSlots.length !== 1) return undefined;
+  const nullAbsence = sourcePlan.sentinels.null !== 'absent';
+  const undefinedAbsence = sourcePlan.sentinels.undefined !== 'absent';
+  if (nullAbsence === undefinedAbsence) return undefined;
+  const expectedPlan = getCppUnionRepresentationPlan(expectedUnion, context);
+  if (expectedPlan.kind !== 'dualSentinelVariant') return undefined;
+  const sentinel = nullAbsence ? 'null' : 'undefined';
+  const valueName = getGeneratedTargetName('liftedOptional', context);
+  const valueSlot = sourcePlan.valueSlots[0]!;
+  const present = emitCppUnionValueConstruction(
+    `${valueName}.value()`,
+    valueSlot.targetType,
+    expectedUnion,
+    expectedPlan.kind,
+    context,
+  );
+  const absence = emitCppUnionSentinelConstruction(sentinel, expectedUnion, expectedPlan.kind, context);
+  const resultType = emitUnionTypeCpp(expectedUnion, context);
+  context.includes.add('optional');
+  context.includes.add('variant');
+  return `([&]() -> ${resultType} { auto ${valueName} = ${emitExpression(expression, context)}; if (!${valueName}.has_value()) return ${absence}; return ${present}; }())`;
+}
+
+// A nullable array element can be lifted into a dual-sentinel destination only where the source has
+// already proved the index is in range. Without that proof an absent element is JavaScript's
+// `undefined` (a hole or a past-end index), not the element union's declared null: lifting an empty
+// optional to the Null arm from the declared `T | null` alone would assert a sentinel the read does
+// not carry. This bounded proof accepts exactly the guarded conditional the SDK writes -- a
+// conjunction that bounds the same index below that same array's length and at or above zero -- and
+// lifts the in-range branch; every other shape keeps its existing emission (and its diagnostic).
+function getCppGuardedConditionalBoundsCpp(
+  condition: Readonly<IrExpression>,
+  receiverBindingId: string,
+  indexBindingId: string,
+): boolean {
+  let upper = false;
+  let lower = false;
+  const visit = (branch: Readonly<IrExpression>): void => {
+    if (branch.kind === 'binary' && branch.operator === '&&') {
+      visit(branch.left);
+      visit(branch.right);
+      return;
+    }
+    if (branch.kind !== 'binary') return;
+    const isIndex = (candidate: Readonly<IrExpression>): boolean =>
+      candidate.kind === 'identifier' &&
+      candidate.reference.kind === 'binding' &&
+      candidate.reference.binding.id === indexBindingId;
+    const isReceiverLength = (candidate: Readonly<IrExpression>): boolean =>
+      candidate.kind === 'property' &&
+      candidate.name === 'length' &&
+      candidate.object.kind === 'identifier' &&
+      candidate.object.reference.kind === 'binding' &&
+      candidate.object.reference.binding.id === receiverBindingId;
+    if ((branch.operator === '<' || branch.operator === '<=') && isIndex(branch.left) && isReceiverLength(branch.right)) {
+      upper = true;
+    }
+    if (
+      (branch.operator === '>=' || branch.operator === '>') &&
+      isIndex(branch.left) &&
+      branch.right.kind === 'literal' &&
+      branch.right.value === 0
+    ) {
+      lower = true;
+    }
+  };
+  visit(condition);
+  return upper && lower;
+}
+
+function emitCppGuardedNullableElementConditionalCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'conditional' }>>,
+  context: EmitContext,
+  expectedType: Readonly<IrType> | undefined,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || !expectedType) return undefined;
+  const union = getIrUnionTypeCpp(expectedType, context, new Set());
+  const plan = union ? getCppUnionRepresentationPlan(union, context) : undefined;
+  if (!union || plan?.kind !== 'dualSentinelVariant') return undefined;
+  const element = expression.whenTrue;
+  if (element.kind !== 'element' || element.optional) return undefined;
+  if (element.object.kind !== 'identifier' || element.object.reference.kind !== 'binding') return undefined;
+  if (element.index.kind !== 'identifier' || element.index.reference.kind !== 'binding') return undefined;
+  if (
+    !getCppGuardedConditionalBoundsCpp(
+      expression.condition,
+      element.object.reference.binding.id,
+      element.index.reference.binding.id,
+    )
+  ) {
+    return undefined;
+  }
+  const lifted = emitCppSingleSentinelIntoDualSentinelCpp(element, union, context);
+  if (!lifted) return undefined;
+  const absent = emitExpression(expression.whenFalse, getCppConditionBranchContextCpp(expression.condition, false, context), expectedType);
+  return `(${emitCppTruthinessExpression(expression.condition, context)} ? ${lifted} : ${absent})`;
+}
+
 function emitCppConditionalBranchCpp(
   expression: Readonly<IrExpression>,
   context: EmitContext,
