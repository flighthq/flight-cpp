+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/nullableElementDualSentinel.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('lifts a guarded nullable array element into a dual-sentinel destination', () => {
+  const output = emit(`
+    interface Attachment { name: string }
+    interface Slot { attachment?: Attachment | null }
+    export function bind(slot: Slot, table: readonly (Attachment | null)[], index: number): void {
+      slot.attachment = index >= 0 && index < table.length ? table[index] : null;
+    }
+  `);
+
+  // The source's own bounds guard proves the read in range, so an empty optional is the element's
+  // declared null; it lifts into the Null arm and a present element keeps the same reference.
+  expect(output).toContain('has_value()');
+  expect(output).toContain('std::in_place_type<flight::Null>');
+  expect(output).toContain('std::in_place_type<flight::Ref<Attachment>>');
+});
+
+it('maps an undefined-only element to the undefined arm, never to null', () => {
+  const output = emit(`
+    interface Attachment { name: string }
+    interface Slot { attachment?: Attachment | null }
+    export function bindMaybe(slot: Slot, table: readonly (Attachment | undefined)[], index: number): void {
+      slot.attachment = index >= 0 && index < table.length ? table[index] : null;
+    }
+  `);
+
+  // The element's absence maps to the undefined arm; the source's own `: null` fallback still
+  // selects the null arm, and the two sentinels stay distinct.
+  expect(output).toContain('std::in_place_type<flight::Undefined>');
+  expect(output).toContain('std::in_place_type<flight::Null>');
+  expect(output).toContain('lifted_optional');
+});
+
+it('leaves an optional destination as an optional', () => {
+  const output = emit(`
+    interface Attachment { name: string }
+    export function bind(slot: { attachment: Attachment | null }, table: readonly (Attachment | null)[], index: number): void {
+      slot.attachment = index >= 0 && index < table.length ? table[index] : null;
+    }
+  `);
+
+  expect(output).toContain('table.element(index)');
+  expect(output).not.toContain('lifted_optional');
+});
+
+it('does not lift an unguarded element read, whose absence is undefined', () => {
+  const output = emit(`
+    interface Attachment { name: string }
+    interface Slot { attachment?: Attachment | null }
+    export function unguarded(slot: Slot, table: readonly (Attachment | null)[], index: number, flag: boolean): void {
+      slot.attachment = flag ? table[index] : null;
+    }
+    export function assign(slot: Slot, table: readonly (Attachment | null)[], index: number): void {
+      slot.attachment = table[index];
+    }
+  `);
+
+  // Without a bounds guard the indexed read's empty state is JavaScript's undefined (a hole or a
+  // past-end index), not the declared null; the lift must not assert the Null arm from the type alone.
+  expect(output).not.toContain('lifted_optional');
+});
