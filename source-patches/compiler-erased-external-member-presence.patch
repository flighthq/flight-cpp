+++ b/packages/compiler-backend-cpp/src/cppErasedExternalMemberPresence.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// An external type is erased to `any` in the program the lowering builds, and that erases the `| null`
+// beside it: `encoder: NativeEncoder | null` reaches the checker as `any`, so TypeScript's flow narrowing
+// of `pass.encoder` after `if (pass.encoder !== null)` is invisible and the member call refused. Binding
+// references already recover the narrowing syntactically; this is the same closed proof for the
+// `binding.member` path TypeScript narrows. The guard must exclude every absent kind the member's own
+// declaration admits, and a write to the member or its receiver before the read -- or anywhere in an
+// enclosing loop -- withdraws it. A write target is never itself narrowed.
+//
+// The measured site is @flighthq/render-wgpu's wgpuRenderPass.ts (`pass.encoder`, `runtime.renderPass`).
+const bindings = {
+  bindings: [
+    {
+      headers: ['host/encoder.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'NativeEncoder',
+      space: 'type' as const,
+      targetName: 'host::Encoder',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(source: string) {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/pass.ts', source, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { externalBindings: bindings, runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function refusal(source: string) {
+  try {
+    emit(source);
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error.rule;
+    throw error;
+  }
+  return undefined;
+}
+
+const pass = 'export interface Pass { encoder: NativeEncoder | null }\n';
+
+describe('a guarded member of erased external type', () => {
+  it('reads the payload inside a block guard and clears the storage, not the payload', () => {
+    const contents = emit(
+      `${pass}export function end(pass: Pass): void { if (pass.encoder !== null) { pass.encoder.end(); pass.encoder = null; } }`,
+    );
+    expect(contents).toContain('if (pass->encoder.has_value()) {');
+    expect(contents).toContain('pass->encoder.value().end();');
+    expect(contents).toContain('(pass->encoder = std::nullopt);');
+    expect(contents).not.toContain('encoder.value() = nullptr');
+  });
+
+  it('reads the payload after an early-return guard', () => {
+    const contents = emit(
+      `${pass}export function suspend(pass: Pass): void { if (pass.encoder === null) return; pass.encoder.end(); }`,
+    );
+    expect(contents).toContain('if (!pass->encoder.has_value()) {');
+    expect(contents).toContain('pass->encoder.value().end();');
+  });
+
+  it('accepts && and the else branch of an absent test', () => {
+    expect(
+      emit(`${pass}export function a(pass: Pass): boolean { return pass.encoder !== null && pass.encoder.finish(); }`),
+    ).toContain('pass->encoder.value().finish()');
+    expect(
+      emit(`${pass}export function b(pass: Pass): void { if (pass.encoder === null) { return; } else { pass.encoder.end(); } }`),
+    ).toContain('pass->encoder.value().end();');
+  });
+
+  it('needs a loose test when the declaration admits both null and undefined', () => {
+    const both = 'export interface Pass { encoder?: NativeEncoder | null }\n';
+    expect(
+      refusal(`${both}export function bad(pass: Pass): void { if (pass.encoder !== null) { pass.encoder.end(); } }`),
+    ).toBe('cpp-member-projection-without-present-storage');
+    expect(emit(`${both}export function ok(pass: Pass): void { if (pass.encoder != null) { pass.encoder.end(); } }`)).toContain(
+      '.end();',
+    );
+  });
+
+  it('withdraws the proof after a write, inside a loop that writes, and for another receiver', () => {
+    const rule = 'cpp-member-projection-without-present-storage';
+    expect(
+      refusal(
+        `${pass}export function a(pass: Pass, next: NativeEncoder | null): void { if (pass.encoder !== null) { pass.encoder = next; pass.encoder.end(); } }`,
+      ),
+    ).toBe(rule);
+    expect(
+      refusal(
+        `${pass}export function b(pass: Pass, next: () => NativeEncoder | null): void { if (pass.encoder === null) return; while (true) { pass.encoder.end(); pass.encoder = next(); } }`,
+      ),
+    ).toBe(rule);
+    expect(
+      refusal(`${pass}export function c(pass: Pass, other: Pass): void { if (other.encoder !== null) { pass.encoder.end(); } }`),
+    ).toBe(rule);
+    expect(
+      refusal(
+        `${pass}export function d(pass: Pass, swap: Pass): void { if (pass.encoder !== null) { pass = swap; pass.encoder.end(); } }`,
+      ),
+    ).toBe(rule);
+  });
+});
