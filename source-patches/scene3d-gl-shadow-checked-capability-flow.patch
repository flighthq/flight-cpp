@@ -398,4 +398,20 @@ describe('renderGlScene3DShadowMap', () => {
     expect(gl.calls.filter((call) => call.name === 'drawElements')).toHaveLength(1);
     expect(gl.calls.filter((call) => call.name === 'drawElementsInstanced')).toHaveLength(0);
   });
+
+  // The runtime witness for the typed mesh guard, which the rewrite moved from an assertion to a
+  // predicate. A descendant carrying no geometry is skipped before any upload or draw, and the rigid
+  // mesh behind it still produces exactly one non-instanced draw -- so the guard skips the right nodes
+  // without skipping the caster behind them.
+  it('skips a non-mesh descendant and still draws the rigid caster behind it', () => {
+    const { state, gl } = makeShadowState();
+    const scene = createNode3D(Node3DKind);
+    addNodeChild(scene, createNode3D(Node3DKind));
+    addNodeChild(scene, createMesh(createBoxMeshGeometry(), [null]));
+
+    renderGlScene3DShadowMap(state, scene, makeShadowCamera(), SHADOW_LIGHT);
+
+    expect(gl.calls.filter((call) => call.name === 'drawElements')).toHaveLength(1);
+    expect(gl.calls.filter((call) => call.name === 'drawElementsInstanced')).toHaveLength(0);
+  });
 });
