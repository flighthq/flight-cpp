diff --git a/packages/compiler-backend-cpp/src/cppInterfaceAbsenceRefinementHeritage.test.ts b/packages/compiler-backend-cpp/src/cppInterfaceAbsenceRefinementHeritage.test.ts
new file mode 100644
index 0000000..0e2ea64
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppInterfaceAbsenceRefinementHeritage.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// A derived interface may narrow a base member by ABSENCE alone: WgpuRenderTarget declares
+// `context: GPUCanvasContext | null`, and its screen and texture targets redeclare it as `GPUCanvasContext`
+// and `null`. Every value the narrower member admits is one the base cell holds, so the derived owner keeps
+// native C++ heritage and reads and writes that single base cell. No shadow member and no copy is made.
+// A present-only refinement reads the cell's payload (the refinement is the presence proof); a write
+// through either owner lands in the same cell; a null-only write empties it. A refinement that changes
+// the payload domain stays off native heritage (see cppCompilerBackend.test.ts).
+const declarations = `export interface Ctx { id: number }
+export interface Target { context: Ctx | null; width: number }
+export interface Screen extends Target { readonly context: Ctx; swap: number }
+export interface Texture extends Target { readonly context: null; view: number }
+`;
+
+function emit(body: string) {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/targets.ts', declarations + body, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe('absence-only interface refinements on native heritage', () => {
+  it('derives both refinements from the base and keeps the one base cell', () => {
+    const contents = emit('');
+    expect(contents).toContain('struct Target : public flight::ReferenceEnabled {\n  std::optional<flight::Ref<Ctx>> context;');
+    expect(contents).toContain('struct Screen : public Target {\n  double swap;\n};');
+    expect(contents).toContain('struct Texture : public Target {\n  double view;\n};');
+  });
+
+  it('widens each derived owner to the base as the same reference', () => {
+    expect(emit('export function f(s: Screen): Target { return s; }')).toContain('flight::Ref<Target> f(flight::Ref<Screen> s) {\n  return s;');
+    expect(emit('export function f(t: Texture): Target { return t; }')).toContain('flight::Ref<Target> f(flight::Ref<Texture> t) {\n  return t;');
+  });
+
+  it('reads a present-only refinement through the base cell payload', () => {
+    expect(emit('export function f(s: Screen): number { return s.context.id; }')).toContain('return s->context.value()->id;');
+  });
+
+  it('tests a null-only refinement against the base cell', () => {
+    expect(emit('export function f(t: Texture): boolean { return t.context === null; }')).toContain('return !t->context.has_value();');
+  });
+
+  it('writes through either owner into the base cell, never into its payload', () => {
+    const screen = emit('export function f(s: Screen, c: Ctx): void { s.context = c; }');
+    expect(screen).toContain('(s->context = std::optional<flight::Ref<Ctx>>{c});');
+    expect(screen).not.toContain('context.value() =');
+    expect(emit('export function f(t: Texture): void { t.context = null; }')).toContain('(t->context = std::nullopt);');
+  });
+
+  it('constructs a derived literal with its inherited cell written after its own members', () => {
+    const contents = emit('export function f(): Texture { return { context: null, width: 3, view: 7 }; }');
+    expect(contents).toContain('auto object_member_context = std::nullopt;');
+    expect(contents).toContain('Texture{.view = object_member_view}');
+    expect(contents).toContain('->context = object_member_context;');
+    expect(contents).toContain('->width = object_member_width;');
+  });
+});
