+// Only direct iteration of `knownArray ?? []` supplies this context. The left must resolve
+// to one closed array domain after removing sentinels; neither the loop binding nor an erased
+// receiver guesses an element type. Other fallback expressions and ambiguous unions keep their lane.
+function getCppTypedEmptyFallbackIterationArrayCpp(
+  expression: Readonly<IrExpression>, context: EmitContext,
+): Readonly<Extract<IrType, { kind: 'array' }>> | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expression.kind !== 'binary' ||
+      expression.operator !== '??' || expression.right.kind !== 'array' || expression.right.elements.length) return undefined;
+  const left = getIrExpressionBindingTypeCpp(expression.left, context) ?? getIrExpressionTypeEvidenceCpp(expression.left, context);
+  if (!left || (!hasIrTypeAbsentMember(left) && !hasCppAbsenceStorageCpp(expression.left, context))) return undefined;
+  const present = getCppNonNullableType(left, context, new Set());
+  const array = getIrArrayTypeCpp(present, context, new Set());
+  if (!array || getCppOpenTypeParameterName(array)) return undefined;
+  return array;
+}
