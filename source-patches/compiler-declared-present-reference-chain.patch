+// `group?.member` where the checker excluded nullishness from `group` -- its declared type is a required
+// reference -- still tests the receiver at run time in JavaScript. Upstream relies on that deliberately:
+// `host.audio?.device ?? null` must answer null for a hand-built Host whose `audio` group is missing. The
+// receiver is a flight::Ref, so a missing group is a null pointer here, and dropping the `?.` dereferenced it.
+//
+// The test is kept only where its absence has somewhere to go: the member's own storage must already be a
+// single std::optional, so the chain's result type is unchanged. A required member under a missing group
+// would need its result widened to admit absence; that is a different change and is left as it was.
+function emitCppDeclaredPresentReferenceChainCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'property' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  const receiverType = getIrExpressionTypeEvidenceCpp(expression.object, context);
+  if (!receiverType || hasIrTypeAbsentMember(receiverType)) return undefined;
+  if (!hasFlightReferenceRepresentationCpp(receiverType, context)) return undefined;
+  const memberType = getIrObjectPropertyTypeCpp(receiverType, expression.name, context);
+  if (!memberType) return undefined;
+  const memberUnion = getIrUnionTypeCpp(memberType, context, new Set());
+  const memberPlan = memberUnion ? getCppUnionRepresentationPlan(memberUnion, context) : undefined;
+  if (memberPlan?.kind !== 'optionalSingle' || memberPlan.valueSlots.length !== 1) return undefined;
+  const receiver = emitExpression(expression.object, context);
+  const member = getCppProjectedMemberNameCpp(expression, context);
+  // Only the nominal pointer read is guarded: the access the chain would otherwise emit must be exactly
+  // `receiver->member`. A structural row read, a variant projection or any other spelling is left as it was.
+  if (emitExpression({ ...expression, optional: false }, context) !== `${receiver}->${member}`) return undefined;
+  context.includes.add('optional');
+  return `([&]() -> std::optional<${memberPlan.valueSlots[0]!.targetType}> { auto optional_chain_receiver = ${receiver}; if (!optional_chain_receiver) return std::nullopt; return optional_chain_receiver->${member}; }())`;
+}
+
 function emitOptionalPropertyExpressionCpp(
   expression: Readonly<Extract<IrExpression, { kind: 'property' }>>,
   context: EmitContext,
@@ -29640,6 +29670,8 @@ function emitOptionalPropertyExpressionCpp(
