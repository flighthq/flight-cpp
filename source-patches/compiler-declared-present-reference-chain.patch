@@ -0,0 +1,41 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function returned(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  const contents = emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+  return contents.split('\n').find((line) => line.trim().startsWith('return '))?.trim() ?? '';
+}
+
+// upstream hostQuery.ts's shape: a required group declared present, read through `?.` so that a hand-built
+// stand-in with the group missing answers null rather than a TypeError.
+const host =
+  'export interface Device { id: number }\n' +
+  'export interface Group { device?: Device; count: number }\n' +
+  'export interface Host { readonly audio: Group; readonly maybe?: Group }\n';
+
+describe('an optional chain through a reference declared present', () => {
+  it('keeps the run-time receiver test when the member already admits absence', () => {
+    expect(returned(`${host}export function f(host: Host): Device | null { return host.audio?.device ?? null; }`)).toBe(
+      'return ([&]() -> std::optional<flight::Ref<Device>> { auto optional_chain_receiver = host->audio; if (!optional_chain_receiver) return std::nullopt; return optional_chain_receiver->device; }());',
+    );
+  });
+
+  it('leaves a required read without ?. as a plain read', () => {
+    expect(returned(`${host}export function f(host: Host): Device | null { return host.audio.device ?? null; }`)).toBe(
+      'return host->audio->device;',
+    );
+  });
+
+  it('leaves a required member under a required group as it was, since its result has no absent state', () => {
+    expect(returned(`${host}export function f(host: Host): number { return host.audio?.count; }`)).toBe('return host->audio->count;');
+  });
+
+  it('leaves a value receiver declared present unguarded', () => {
+    expect(returned('export function f(text: string): number { return text?.length; }')).not.toContain('optional_chain_receiver');
+  });
+});
