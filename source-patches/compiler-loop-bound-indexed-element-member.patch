+          expression.kind === 'element' &&
+          !expression.optional &&
+          isIrBindingIdentifierCpp(expression.index, indexBindingId) &&
+          areCppStableArrayReceiverExpressionsEqualCpp(expression.object, array, context)
+        ) {
+          result.add(expression);
+        }
+      },
+    });
+  };
+  const inspectStatements = (statements: readonly Readonly<IrStatement>[]): void => {
+    for (const [index, statement] of statements.entries()) {
+      // A `for (let i = 0; i < x.length; i++)` loop proves its own index in bounds.
