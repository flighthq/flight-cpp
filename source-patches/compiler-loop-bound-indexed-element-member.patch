+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return new Set();
+  const result = new Set<Readonly<IrExpression>>();
+  const markLoopBody = (body: Readonly<IrStatement>, indexBindingId: string, array: Readonly<IrExpression>): void => {
+    if (doesCppLoopLoseNonnegativeIntegerIndexCpp(body, indexBindingId)) return;
