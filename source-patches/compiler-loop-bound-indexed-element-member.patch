new file mode 100644
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppRequiredIndexedElementMember.test.ts
@@ -0,0 +1,50 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/requiredIndexedElementMember.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('applies a member to a required indexed element whose type has no absence', () => {
+  const output = emit(`
+    export function collect(source: string): Set<string> {
+      const found = new Set<string>();
+      const lines = source.split('\\n');
+      for (let i = 0; i < lines.length; i++) {
+        const line = lines[i].trim();
+        if (line.length === 0) continue;
+        found.add(line);
+      }
+      return found;
+    }
+  `);
+
+  // The element type is a plain string, so the only absence is the bounds check: the required
+  // accessor throws there exactly where the source's own undefined member use would throw.
+  expect(output).toContain('lines.element(i).trim()');
+  expect(output).not.toContain('lines.get(i)');
+});
+
+it('keeps a nullable element member refused without a presence proof', () => {
+  expect(() =>
+    emit(`
+      export function first(lines: readonly (string | null)[]): number {
+        return lines[0].length;
+      }
+    `),
+  ).toThrow(/proven present payload|member .* on optional C\+\+ storage/);
+});
