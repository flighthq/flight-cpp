diff --git a/packages/compiler-backend-cpp/src/cppReadonlyJsonRecordView.test.ts b/packages/compiler-backend-cpp/src/cppReadonlyJsonRecordView.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppReadonlyJsonRecordView.test.ts
@@ -0,0 +1,61 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/jsonView.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('keeps readonly erased Record reads in the owner-preserving named view and bare Any carrier', () => {
+  const output = emit(`export function read(record: Readonly<Record<string, unknown>>, key: string): unknown {
+    const value = record[key]; if (value === undefined || value === null) return 'missing'; return value;
+  } export function named(record: Readonly<Record<string, unknown>>): unknown { return record.missing; }`);
+  expect(output).toContain('flight::NamedProperties record');
+  expect(output).toContain('record.get(flight::String("missing"))');
+  expect(output).toContain('presence_operand.is_null()');
+  expect(output).toContain('presence_operand.is_undefined()');
+  expect(output).not.toContain('.value_or(');
+});
+
+it('constructs original Record literal storage once before taking a readonly view', () => {
+  const output = emit(`export function take(record: Readonly<Record<string, unknown>>): unknown { return record.n; }
+    export function direct(): unknown { return take({n: 3}); }
+    export function computed(key: string): unknown { return take({[key]: 4}); }
+    export function empty(): unknown { return take({}); }`);
+  expect(output).toContain('flight::Record<flight::String, flight::Any> record_construction');
+  expect(output).toContain('flight::NamedProperties(record_construction');
+  expect(output).not.toContain('flight::NamedProperties record_construction');
+});
+
+it('retains lazy nullish fallback and does not substitute truthiness', () => {
+  const output = emit(`export function fallback(record: Readonly<Record<string, unknown>>, next: () => unknown): unknown {
+    return record.drawOrder ?? next();
+  }`);
+  expect(output).toContain('.is_nullish()');
+  expect(output).toContain('return next();');
+  expect(output).not.toContain('.to_boolean()');
+});
+
+it('resolves readonly Record aliases without changing mutable or concrete Record carriers', () => {
+  const output = emit(`type R = Readonly<Record<string, unknown>>;
+    export function alias(record: R): unknown { return record.n; }
+    export function ordinary(record: Record<string, unknown>): unknown { return record.n; }
+    export function numeric(record: Readonly<Record<string, number>>): number { return record.n; }`);
+  expect(output).toContain('using R = flight::NamedProperties');
+  expect(output).toContain('flight::Record<flight::String, flight::Any> record');
+  expect(output).toContain('flight::Record<flight::String, double> record');
+});
+
+it('limits a string-only built-in parse catch to syntax failure and leaves other catches alone', () => {
+  const output = emit(`export function parse(text: string): unknown {
+    let doc: unknown; try { doc = JSON.parse(text); } catch { return null; } return doc;
+  } export function other(next: () => unknown): unknown { try { return next(); } catch { return null; } }`);
+  expect(output).toContain('flight::JsonValue doc');
+  expect(output).toContain('catch (const flight::JsonSyntaxError&)');
+  expect(output).toContain('catch (...)');
+});
