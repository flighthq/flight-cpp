@@ -0,0 +1,67 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/jsonView.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('selects a private direct-call reader without changing the public Record ABI', () => {
+  const output = emit(`function read(record: Readonly<Record<string, unknown>>, key: string): unknown {
+    const value = record[key]; if (value === undefined || value === null) return 'missing'; return value;
+  } export function run(record: Readonly<Record<string, unknown>>, key: string): unknown { return read(record, key); }`);
+  expect(output).toContain('flight::NamedProperties record');
+  expect(output).toContain('run(flight::Record<flight::String, flight::Any> record');
+  expect(output).toContain('presence_operand.is_null()');
+  expect(output).toContain('presence_operand.is_undefined()');
+});
+
+it('keeps readonly literal allocation in the original Record storage before a private read view', () => {
+  const output = emit(`function take(record: Readonly<Record<string, unknown>>): unknown { return record.n; }
+    export function direct(): unknown { return take({n: 3}); }
+    export function computed(key: string): unknown { return take({[key]: 4}); }
+    export function empty(): unknown { return take({}); }`);
+  expect(output).toContain('flight::NamedProperties record');
+  expect(output).toContain('flight::Record<flight::String, flight::Any>');
+  expect(output).not.toContain('flight::NamedProperties record_construction');
+});
+
+it('retains a private reader lazy nullish fallback without testing truthiness', () => {
+  const output = emit(`function fallback(record: Readonly<Record<string, unknown>>, next: () => unknown): unknown {
+    return record.drawOrder ?? next();
+  } export function run(record: Readonly<Record<string, unknown>>, next: () => unknown): unknown { return fallback(record, next); }`);
+  expect(output).toContain('.is_nullish()');
+  expect(output).toContain('return next();');
+  expect(output).not.toContain('.to_boolean()');
+});
+
+it('keeps aliases, returned owners, exported functions and callback-visible helper signatures unchanged', () => {
+  const output = emit(`type R = Readonly<Record<string, unknown>>;
+    function identity(record: R): R { return record; }
+    export function escape(record: R): R { return identity(record); }
+    function callback(record: R): unknown { return record.n; }
+    export function handler(): (record: R) => unknown { return callback; }`);
+  expect(output).toContain('using R = flight::Record<flight::String, flight::Any>');
+  expect(output).not.toContain('flight::NamedProperties');
+});
+
+it('retains numeric indexing for a private string-keyed readonly Record reader', () => {
+  const output = emit(`function numeric(record: Readonly<Record<string, unknown>>, key: number): unknown { return record[key]; }
+    export function run(record: Readonly<Record<string, unknown>>, key: number): unknown { return numeric(record, key); }`);
+  expect(output).toContain('flight::NamedProperties record');
+  expect(output).toContain('record.get(key)');
+});
+
+it('limits an already-string built-in parse-only catch to syntax failure', () => {
+  const output = emit(`export function parse(text: string): unknown {
+    let doc: unknown; try { doc = JSON.parse(text); } catch { return null; } return doc;
+  } export function other(next: () => unknown): unknown { try { return next(); } catch { return null; } }`);
+  expect(output).toContain('flight::JsonValue doc');
+  expect(output).toContain('catch (const flight::JsonSyntaxError&)');
+  expect(output).toContain('catch (...)');
+});
