+// `{ active, ...readRange(section, def) }`, with the range's fields named rather than spread.
+function readActiveRange(section: LibgdxSection, active: boolean, def?: Partial<LibgdxRangeValue>): LibgdxActiveRangeValue {
+  const range = readRange(section, def);
+  return {
+    active,
+    lowMin: range.lowMin,
+    lowMax: range.lowMax,
+    highMin: range.highMin,
+    highMax: range.highMax,
+    relative: range.relative,
+    scaling: range.scaling,
+    timeline: range.timeline,
+  };
+}
