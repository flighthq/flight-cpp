+++ b/packages/compiler-backend-cpp/src/cppNewMapCopy.test.ts
@@ -0,0 +1,43 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function returned(contents: string, name: string): string {
+  const lines = contents.split('\n');
+  const start = lines.findIndex((line) => line.includes(` ${name}(`));
+  const body = lines.slice(start + 1).find((line) => line.trim().startsWith('return '));
+  return body?.trim() ?? '';
+}
+
+describe('new Map(existingMap)', () => {
+  const contents = emit(`
+export function copyReadonly(map: ReadonlyMap<string, number>): Map<string, number> { return new Map(map); }
+export function copyTyped(map: Map<string, number>): Map<string, number> { return new Map<string, number>(map); }
+export function copyField(holder: { m: Map<string, number> }): Map<string, number> { return new Map(holder.m); }
+export function fromEntries(entries: [string, number][]): Map<string, number> { return new Map(entries); }
+export function fromIterator(map: Map<string, number>): Map<string, number> { return new Map(map.entries()); }
+export function fromLiteral(): Map<string, number> { return new Map([['a', 1]]); }
+export function empty(): Map<string, number> { return new Map<string, number>(); }
+`);
+
+  it('copies a Map argument into new storage instead of sharing the caller map', () => {
+    expect(returned(contents, 'copy_readonly')).toBe('return flight::Map<flight::String, double>(map).clone();');
+    expect(returned(contents, 'copy_typed')).toBe('return flight::Map<flight::String, double>(map).clone();');
+    expect(returned(contents, 'copy_field')).toBe('return flight::Map<flight::String, double>(holder->m).clone();');
+  });
+
+  it('leaves the constructor forms that already build a new map as they were', () => {
+    expect(returned(contents, 'from_entries')).toBe('return flight::Map<flight::String, double>(entries);');
+    expect(returned(contents, 'from_iterator')).toBe('return flight::Map<flight::String, double>(map.entries());');
+    expect(returned(contents, 'from_literal')).toBe('return flight::Map<flight::String, double>({{flight::String("a"), 1.0}});');
+    expect(returned(contents, 'empty')).toBe('return flight::Map<flight::String, double>();');
+  });
+});
