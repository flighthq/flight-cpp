       expect(syntax.ok).toBe(true);
     }
   });
+
+  it('recovers the exact native owner retained behind a widened structural union slot', () => {
+    const result = lower(
+      'structural-union-exact-native-owner.ts',
+      `interface NodeData { revision: number }
+       interface TextData extends NodeData { text: string }
+       interface Node { data: NodeData; kind: string }
+       interface Transform2D { x: number; y: number }
+       type Node2D = Node & Transform2D;
+       interface TextLabel extends Node, Transform2D { data: TextData }
+       interface RenderCache { kind: string; cached: boolean }
+       type Renderable = Readonly<Node2D> | RenderCache;
+       interface RenderProxy2D { source: Renderable }
+       export function draw(proxy: RenderProxy2D): string {
+         const source = proxy.source as TextLabel;
+         return source.data.text;
+       }`,
+    );
+    const emitted = emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+
+    expect(result.diagnostics).toEqual([]);
+    expect(emitted).toContain('flight::structural_ref_cast<flight::Ref<TextLabel>>');
+    expect(emitted).toContain('std::get<flight::StructuralRef<');
+    if (cppSyntaxGate.available) {
+      const syntax = cppSyntaxGate.checkCppSourceSyntax(emitted, 'structural-union-exact-native-owner');
+      expect(syntax.diagnostic).toBe('');
+      expect(syntax.ok).toBe(true);
+    }
+  });
 });
