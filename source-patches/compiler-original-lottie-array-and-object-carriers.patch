+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+const toolchain = findCppCompilerToolchain();
+const source = `
+export interface Item { name: string }
+export interface Source { items?: readonly Readonly<Item>[] }
+export function selected(source:Readonly<Source>):readonly Readonly<Item>[] { return source.items ?? []; }
+export function count(source:Readonly<Source>):number { return selected(source).length; }
+export interface Box { data?: unknown }
+export function fresh(next:()=>number):unknown { return {duration:next()}; }
+export function forwarded(next:()=>number):Box { return {data:{duration:next()}}; }
+export interface NullableName { name:string|null }
+export function options(value:string|undefined):Readonly<Partial<NullableName>> { return {name:value??null}; }
+export function omitted():Readonly<Partial<NullableName>> { return {}; }
+function make(options:{values:readonly number[]}):number { return options.values.length; }
+export function generic<T>(unused:T,values:readonly number[]):number { return make({values}); }
+export function typed<T>(value:T):{value:T} { return {value}; }
+export function nested<T>(value:T):{data:{value:T}} { return {data:{value}}; }
+`;
+function emit(text = source): string {
+  const [lowered] = lowerTypeScriptSources([
+    {
+      sourceFile: ts.createSourceFile('/flight/packages/example/src/filter.ts', text, ts.ScriptTarget.Latest, true),
+      packageName: '@flighthq/example',
+      upstreamDirectory: '/flight',
+    },
+  ]);
+  expect(lowered!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered!.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/example': { namespace: 'probe', includePrefix: 'probe' } },
+  }).contents;
+}
+it('retains the actual readonly array payload for the lazy empty fallback', () => {
+  const output = emit();
+  expect(output).toContain('empty_array_type');
+  expect(output).not.toContain('NOT GENERATED');
+});
+it('boxes a fresh source object once at an optional unknown boundary', () => {
+  const output = emit();
+  expect(output).toContain('flight::Any::object(');
+  expect(output).toContain('RowKey<"duration">');
+});
+
