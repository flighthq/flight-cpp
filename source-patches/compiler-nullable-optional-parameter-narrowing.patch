+  // `f(x?: T | null)` keeps three states: the outer optional is the parameter's own presence (omitted is
+  // undefined) and the inner optional is the declared `T | null`. A test that excluded only `undefined`
+  // proves the outer optional present and nothing more, so the narrowed value IS the inner `T | null`
+  // carrier -- null still null, a value still the value. Reading it is the outer `value()`; the inner
+  // optional is the declared storage of the narrowed type and is not unpacked here.
+  if (
+    narrowedType &&
+    !expression.narrowedMember &&
+    getCppOptionalParameterNullishStorageCpp(expression, context) === 'nestedNullable' &&
+    !isCppTypeAdmittingUndefinedCpp(narrowedType, context) &&
+    isCppTypeAdmittingNullCpp(narrowedType, context)
