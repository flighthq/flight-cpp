+// Converts a nominal-reference union to the corresponding readonly structural-view union without
+// erasing which declared owner each arm carries. Each source slot must name exactly the object stored
+// beneath one destination row, and the ordinary structural-reference converter must accept that pair.
+// The visit keeps the source owner alive and constructs the destination variant around a view of that
+// same object; no row or object is copied.
+function emitCppStructuralReferenceMultiVariantConversionCpp(
+  expression: Readonly<IrExpression>,
+  expressionType: Readonly<IrType>,
+  sourcePlan: ReturnType<typeof getCppUnionRepresentationPlan>,
+  targetUnion: Readonly<Extract<IrType, { kind: 'union' }>>,
+  targetPlan: ReturnType<typeof getCppUnionRepresentationPlan>,
+  context: EmitContext,
+): string | undefined {
+  if (sourcePlan.kind !== 'multiVariant' || targetPlan.kind !== 'multiVariant') return undefined;
+  const mappings = sourcePlan.valueSlots.map((sourceSlot) => {
+    const targets = targetPlan.valueSlots.flatMap((targetSlot) => {
+      const targetRow = context.referenceRepresentationPlanner.resolveStructuralRow(
+        targetSlot.runtimeType,
+        context.module,
+      );
+      const targetObject = targetRow ? getCppStructuralRowObjectTypeCpp(targetRow) : undefined;
+      if (!targetObject) return [];
+      const isolatedContext = { ...context, anonymousStructs: new Map(), includes: new Set<string>() };
+      const exactOwner = sourceSlot.targetType === emitType(targetObject, isolatedContext);
+      const sourceRow = context.referenceRepresentationPlanner.resolveStructuralRow(
+        sourceSlot.runtimeType,
+        context.module,
+      );
+      const converted = emitCppStructuralReferenceValueConversionCpp(
+        'source',
+        sourceSlot.runtimeType,
+        targetSlot.runtimeType,
+        isolatedContext,
+      );
+      if (
+        !exactOwner &&
+        !sourceRow &&
+        getCppStructuralRowObjectWideningProofCpp(sourceSlot.runtimeType, targetObject, isolatedContext) !== 'proven'
+      ) {
+        return [];
+      }
+      return converted
+        ? [{ exactOwner, source: sourceSlot, target: targetSlot }]
+        : [];
+    });
+    const exactTargets = targets.filter((target) => target.exactOwner);
+    if (exactTargets.length === 1) return exactTargets[0];
+    return exactTargets.length === 0 && targets.length === 1 ? targets[0] : undefined;
+  });
+  if (mappings.some((mapping) => mapping === undefined)) return undefined;
+  const resolved = mappings.filter((mapping) => mapping !== undefined);
+  if (new Set(resolved.map((mapping) => mapping.target.targetType)).size !== resolved.length) return undefined;
+
+  const resultType = qualifyCppDeclaringModuleTypeCpp(emitUnionTypeCpp(targetUnion, context), context);
+  const value = getGeneratedTargetName('contextualUnionValue', context);
+  const valueType = getGeneratedTargetName('contextualUnionValueType', context);
+  const branches = resolved.map((mapping, index) => {
+    const converted = emitCppStructuralReferenceValueConversionCpp(
+      value,
+      mapping.source.runtimeType,
+      mapping.target.runtimeType,
+      context,
+    );
