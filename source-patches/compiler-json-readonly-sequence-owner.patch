+      const input = path.join(directory, 'native.cpp'),
+        output = path.join(directory, getCppExecutableName(toolchain!, 'native'));
+      writeFileSync(
+        input,
+        `#include "fixture.hpp"
+#include <iostream>
+int main(){int checks=0,failures=0;auto check=[&](bool ok){++checks;if(!ok)++failures;};
+for(const char* text:{"{\\"layers\\":[]}","{\\"layers\\":null}","{\\"layers\\":{}}","{\\"layers\\":2}","{}"}){const auto doc=probe::parse(flight::String(text));check(probe::array(doc)==(flight::String(text)==flight::String("{\\"layers\\":[]}")));check(probe::ignored(doc)==5);}
+auto doc=probe::parse(flight::String("{\\"layers\\":[{\\"value\\":1},null,2]}"));check(probe::forward(doc)==3);
+const auto raw=flight::read_json_scalar_row_member(doc,flight::String("layers")).raw();auto owner=raw.array_owner_if<std::shared_ptr<flight::JsonArray>>();
+auto first=probe::forward_first(doc);check(first.identity()==(*owner)[0].object_owner().get());
+owner->push(flight::JsonValue(7));check(probe::forward(doc)==4);
+(*owner)[0]=flight::Json::parse(flight::String("{\\"value\\":9}"));auto replacement=probe::forward_first(doc);check(replacement.identity()!=first.identity());
+check(flight::read_json_scalar_row_member(first,flight::String("value")).as_native_number()==1);
+check(flight::read_json_scalar_row_member(replacement,flight::String("value")).as_native_number()==9);
+bool threw=false;try{(void)probe::forward(probe::parse(flight::String("{\\"layers\\":null}")));}catch(const flight::TypeError&){threw=true;}check(threw);
+std::cout<<checks<<" checks, "<<failures<<" failures\\n";return failures?1:0;}`,
+      );
+      execFileSync(
+        toolchain!.command,
+        createCppExecutableArguments(toolchain!, input, output, [directory, ...includes]),
+        { stdio: 'pipe' },
+      );
+      expect(execFileSync(output, [], { encoding: 'utf8', stdio: 'pipe' })).toContain('17 checks, 0 failures');
+    } finally {
+      rmSync(directory, { recursive: true, force: true });
+    }
+  },
+  120000,
+);
