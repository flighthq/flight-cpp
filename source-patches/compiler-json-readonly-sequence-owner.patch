+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+const toolchain = findCppCompilerToolchain();
+const source = `
+interface Layer { value:number }
+interface Document { layers:Layer[] }
+export function parse(source:string):Readonly<Document>{ return JSON.parse(source) as Readonly<Document>; }
+export function array(document:Readonly<Document>):boolean { return Array.isArray(document.layers); }
+export function count(layers:readonly Readonly<Layer>[]):number { let total=0; for(const layer of layers){total++;} return total; }
+export function first(layers:readonly Readonly<Layer>[]):Readonly<Layer>{ return layers[0]; }
+export function forward(document:Readonly<Document>):number { return count(document.layers); }
+export function forwardFirst(document:Readonly<Document>):Readonly<Layer> { return first(document.layers); }
+export function ignore(layers:readonly Readonly<Layer>[]):number { return 5; }
+export function ignored(document:Readonly<Document>):number { return ignore(document.layers); }
+`;
+function emit(text = source): string {
+  const [result] = lowerTypeScriptSources([
+    {
+      packageName: '@flighthq/probe',
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/probe/src/probe.ts', text, ts.ScriptTarget.Latest, true),
+    },
+  ]);
+  expect(result!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result!.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/probe': { namespace: 'probe', includePrefix: 'fixture' } },
+  }).contents;
+}
+it('inspects raw original members and passes a lazy view only at readonly structural sequence calls', () => {
+  const output = emit();
+  expect(output).toContain(
+    'flight::is_array(flight::read_json_scalar_row_member(document, flight::String("layers")).raw())',
+  );
+  expect(output).toContain('flight::json_readonly_sequence<flight::StructuralRef<flight::RowReadonly<');
+  expect(output).not.toContain('NOT GENERATED');
+  expect(output).not.toContain('row_get<flight::RowKey<"layers">>(document)');
+});
+it('does not manufacture a readonly view for owning array return storage', () => {
+  const output = emit(source + 'export function owning(document:Readonly<Document>):Layer[]{return document.layers;}');
+  const body = output.split(' owning(')[1]!.split('\n}')[0]!;
+  expect(body).not.toContain('json_readonly_sequence');
+});
+it.skipIf(!toolchain || includes.length === 0)(
+  'runs original array validation, forwarding and lazy error timing',
+  () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'flight-json-readonly-sequence-'));
