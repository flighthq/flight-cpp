index 0000000..c270bb6
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppLazyNullishFallback.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// `a ?? b` evaluates `b` only when `a` is null or undefined, and `a` exactly once. std::optional::value_or
+// evaluates its argument first, so the generic fallback lowers through the shared lazy primitive
+// flight::nullish_or (flight/presence.hpp), which takes the right operand as a thunk. Only a literal or `undefined` fallback -- no evaluation at all -- keeps value_or.
+// Identifiers and member reads are lazy too: a getter, a proxy or an ordering can observe them. A fallback
+// that may itself be absent, entering a slot declared as an opaque host handle, crosses through that
+// handle's declared absence carrier (flight::host_handle_or_absent; it does not compile for any other type).
+const declarations = `export interface Source { value: number | null; read(): number }
+export interface Screen { presentationView: View | null; acquireView: (() => View) | null }
+`;
+const bindings = {
+  bindings: [
+    {
+      headers: ['host/view.hpp'],
+      nullability: 'non-null' as const,
+      ownership: 'shared' as const,
+      sourceName: 'View',
+      space: 'type' as const,
+      targetName: 'host::View',
+    },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(body: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/coalesce.ts', declarations + body, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { externalBindings: bindings, runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe('lazy nullish-coalescing fallback', () => {
+  it('evaluates a call fallback only when the left is absent', () => {
+    const contents = emit(
+      'export function make(): View { throw new Error("make"); }\nexport function f(s: Screen): View | undefined { return s.acquireView?.() ?? make(); }',
+    );
+    expect(contents).toContain('#include <flight/presence.hpp>');
+    expect(contents).toContain('flight::nullish_or<host::View>(');
+    expect(contents).toContain('[&]() -> host::View { return make(); })');
+    expect(contents).not.toContain('.value_or(make())');
+  });
+
+  it('keeps identifier and member-read fallbacks lazy', () => {
+    expect(emit('export function f(s: Screen, other: View): View | undefined { return s.acquireView?.() ?? other; }')).toContain(
+      '[&]() -> host::View { return other; })',
+    );
+    expect(
+      emit('export function f(s: Screen, t: Screen): View | null | undefined { return s.acquireView?.() ?? t.presentationView; }'),
+    ).toContain('flight::nullish_or<std::optional<host::View>>(');
+  });
+
+  it('leaves the primitive coalesce lowering, which already tests presence first, unchanged', () => {
+    const contents = emit('export function f(s: Source): number { return s.value ?? s.read(); }');
+    expect(contents).toContain('if (nullish_coalesce_left.has_value()) return nullish_coalesce_left.value(); return s->read();');
+    expect(contents).not.toContain('nullish_or');
+  });
+
+  it('crosses an absent-capable fallback into a host-handle slot through its absence carrier', () => {
+    const contents = emit('export function f(s: Screen): View { return s.acquireView?.() ?? s.presentationView; }');
+    expect(contents).toContain('#include <flight/host_handle_absence.hpp>');
+    expect(contents).toContain('return flight::host_handle_or_absent(flight::nullish_or<std::optional<host::View>>(');
+  });
+});
