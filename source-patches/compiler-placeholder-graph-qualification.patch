diff --git a/packages/compiler-backend-cpp/src/cppRefusalPlaceholderQualification.test.ts b/packages/compiler-backend-cpp/src/cppRefusalPlaceholderQualification.test.ts
new file mode 100644
index 0000000..196df92
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppRefusalPlaceholderQualification.test.ts
@@ -0,0 +1,123 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import type { CompilerModuleResolutionPlan, IrModule } from '../../compiler-types/src/index.js';
+import { createCppCompilerBackend } from './cppCompilerBackend.js';
+
+// A partially refused module keeps the declarations it could lower. Those retained declarations must be
+// emitted exactly as they would be in a fully emitted module: imported names qualified, and the headers they
+// need included. Only what the RETAINED surface uses may be pulled in -- an import that only the refused
+// declaration used must not leak an include into the placeholder.
+describe('C++ refusal placeholder qualification', () => {
+  const typesPackage = '@flighthq/types';
+  const consumerPackage = '@flighthq/swf';
+  const options = {
+    packageTargets: {
+      [consumerPackage]: { includePrefix: 'flight/swf', namespace: 'flight::swf' },
+      [typesPackage]: { includePrefix: 'flight/types', namespace: 'flight::types' },
+    },
+    runtimeProfile: 'flight-cpp' as const,
+  };
+  // The refused declaration: an erased record assertion, which the C++ backend refuses on its own.
+  const refusedBody = '(target as unknown as Record<PropertyKey, unknown>)[prop] = value;';
+
+  function lowerGraph(consumerSource: string): { consumer: IrModule; moduleResolution: CompilerModuleResolutionPlan; modules: IrModule[] } {
+    const file = (path: string, text: string) => ts.createSourceFile(path, text, ts.ScriptTarget.Latest, true);
+    const sources = [
+      {
+        packageName: typesPackage,
+        sourceFile: file('/flight/packages/types/src/reader.ts', 'export interface Reader { pos: number }'),
+        upstreamDirectory: '/flight',
+      },
+      {
+        packageName: typesPackage,
+        sourceFile: file('/flight/packages/types/src/unrelated.ts', 'export interface Unrelated { extent: number }'),
+        upstreamDirectory: '/flight',
+      },
+      {
+        packageName: consumerPackage,
+        sourceFile: file('/flight/packages/swf/src/handler.ts', consumerSource),
+        upstreamDirectory: '/flight',
+      },
+    ];
+    const moduleResolution: CompilerModuleResolutionPlan = {
+      edges: [
+        { specifier: '@flighthq/types/reader', target: { packageName: typesPackage, source: 'packages/types/src/reader.ts' } },
+        {
+          specifier: '@flighthq/types/unrelated',
+          target: { packageName: typesPackage, source: 'packages/types/src/unrelated.ts' },
+        },
+      ],
+      schema: 'flight-compiler-module-resolution/1',
+    };
+    const results = lowerTypeScriptSources(sources, moduleResolution);
+    expect(results.flatMap((result) => result.diagnostics)).toEqual([]);
+    const modules = results.map((result) => result.module);
+    return { consumer: modules[2]!, moduleResolution, modules };
+  }
+
+  function placeholder(consumerSource: string): string {
+    const { consumer, moduleResolution, modules } = lowerGraph(consumerSource);
+    const session = createCppCompilerBackend().createEmissionSession!({ moduleResolution, modules, options });
+    expect(session.emitRefusalPlaceholder).toBeDefined();
+    return session.emitRefusalPlaceholder!(consumer, {
+      message: 'an erased assertion hides the represented source carrier',
+      rule: 'cpp-erased-record-assertion-unrepresented',
+    })!.contents;
+  }
+
+  it('qualifies and includes what a retained declaration imports', () => {
+    const contents = placeholder(
+      `import type { Reader } from '@flighthq/types/reader';
+       export function readPos(reader: Reader): number { return reader.pos; }
+       export function bad(target: object, prop: string, value: unknown): void { ${refusedBody} }`,
+    );
+    expect(contents).toContain('PARTIAL:');
+    expect(contents).toContain('NOT GENERATED: function bad');
+    // The retained function names the imported type the way a fully emitted module does.
+    expect(contents).toMatch(/double read_pos\(flight::Ref<flight::types::Reader> reader\)/u);
+    expect(contents).not.toMatch(/flight::Ref<Reader>/u);
+    expect(contents).toContain('#include <flight/types/reader.hpp>');
+  });
+
+  it('does not include an import that only the refused declaration used', () => {
+    const contents = placeholder(
+      `import type { Reader } from '@flighthq/types/reader';
+       import type { Unrelated } from '@flighthq/types/unrelated';
+       export function readPos(reader: Reader): number { return reader.pos; }
+       export function bad(target: object, prop: string, value: unknown, extent: Unrelated): void { ${refusedBody} }`,
+    );
+    expect(contents).toContain('#include <flight/types/reader.hpp>');
+    expect(contents).not.toContain('flight/types/unrelated.hpp');
+    expect(contents).not.toContain('Unrelated>');
+  });
+
+  it('includes no imported header when no retained declaration uses an import', () => {
+    const contents = placeholder(
+      `import type { Reader } from '@flighthq/types/reader';
+       export function twice(value: number): number { return value * 2; }
+       export function bad(target: object, prop: string, value: unknown, reader: Reader): void { ${refusedBody} }`,
+    );
+    expect(contents).toContain('double twice(double value)');
+    expect(contents).not.toContain('flight/types/reader.hpp');
+    expect(contents).not.toContain('flight/types/unrelated.hpp');
+  });
+
+  it('emits the same retained declaration as a fully emitted module does', () => {
+    // The control: the retained function, emitted on its own in a module with no refusal, is spelled exactly
+    // as the placeholder spells it.
+    const retained = 'export function readPos(reader: Reader): number { return reader.pos; }';
+    const { consumer, moduleResolution, modules } = lowerGraph(
+      `import type { Reader } from '@flighthq/types/reader';\n${retained}`,
+    );
+    const full = createCppCompilerBackend()
+      .createEmissionSession!({ moduleResolution, modules, options })
+      .emitModule(consumer)[0]!.contents;
+    const signature = /inline double read_pos\([^)]*\)/u;
+    const salvaged = placeholder(
+      `import type { Reader } from '@flighthq/types/reader';\n${retained}\nexport function bad(target: object, prop: string, value: unknown): void { ${refusedBody} }`,
+    );
+    expect(salvaged.match(signature)?.[0]).toBe(full.match(signature)?.[0]);
+  });
+});
