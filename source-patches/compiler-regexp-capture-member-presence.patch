+const source = String.raw`
+export function direct(value: string): string[] {
+  const match = /([^{}]+)\{([^{}]*)\}/.exec(value);
+  if (match === null) return [];
+  return match[1].split(',');
+}
+export function empty(value: string): number {
+  const match = /(a)?(b*)/.exec(value);
+  if (match === null) return -1;
+  return match[2].length;
+}
+export function guarded(value: string): string {
+  const match = /(a)?(b*)/.exec(value);
+  if (match === null) return 'none';
+  const capture = match[1];
+  if (capture === undefined) return 'missing';
+  return capture.trim();
+}
+export function coalesced(value: string): string {
+  const match = /(a)?(b*)/.exec(value);
+  if (match === null) return 'none';
+  const capture = match[1];
+  return capture ?? 'missing';
+}
+export function optional(value: string): string {
+  const match = /(a)?(b*)/.exec(value);
+  return match?.[1]?.trim() ?? 'missing';
+}
+let calls = 0;
+function receiver(match: RegExpExecArray): RegExpExecArray { calls = calls * 10 + 1; return match; }
+function key(): number { calls = calls * 10 + 2; return 1; }
+function separator(): string { calls = calls * 10 + 3; return ','; }
+export function reset(): void { calls = 0; }
+export function count(): number { return calls; }
+export function ordered(value: string): string[] {
+  const match = /(a)?(b*)/.exec(value);
+  if (match === null) return [];
+  return receiver(match)[key()].split(separator());
+}
+export function local(value: string): number {
+  const match = /(a)?(b*)/.exec(value);
+  if (match === null) return -1;
+  const capture = match[1];
+  return capture.length;
+}
+export function returned(value: string): string | undefined {
+  const match = /(a)?(b*)/.exec(value);
+  return match?.[1];
+}
+export function strictNull(value: string): boolean {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return false;
+  const capture = match[1];
+  return capture === null || match[1] === null;
+}
+export function continuation(value: string): string {
+  const match = /(a)?b/.exec(value);
+  return match?.[1].trim() ?? 'none';
+}
+export function stringify(value: string): string {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return 'none';
+  return match[1].toString();
+}
+export function captureOptional(value: string): string {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return 'none';
+  return match[1]?.trim() ?? 'missing';
+}
+export function continuationLength(value: string): number {
+  const match = /(a)?b/.exec(value);
+  return match?.[1].length ?? -1;
+}
+export function optionalLength(value: string): number {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return -1;
+  return match[1]?.length ?? -2;
+}
+export function guardedContinuation(value: string): string {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return 'none';
+  return match?.[1].trim() ?? 'missing';
+}
+export function presentContinuation(match: RegExpExecArray): string {
+  return match?.[1].trim();
+}
+export function guardedContinuationLength(value: string): number {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return -1;
+  return match?.[1].length;
+}
+export function localOptional(value: string): string {
+  const match = /(a)?b/.exec(value);
+  const capture = match?.[1];
+  return capture ?? 'missing';
+}
+export function localTyped(value: string): string {
+  const match = /(a)?b/.exec(value);
+  if (match === null) return 'none';
+  const capture: string | undefined = match[1];
+  return capture ?? 'missing';
+}
+export function localOptionalLength(value: string): number {
+  const match = /(a)?b/.exec(value);
+  const capture = match?.[1];
+  return capture?.length ?? -1;
+}
+export function localTypedMember(value: string): number {
+  const match = /(a)?b/.exec(value);
+  const capture: string | undefined = match?.[1];
+  return capture!.length;
+}
+export function localEmpty(value: string): string {
+  const match = /(a)?(b*)/.exec(value);
+  const capture: string | undefined = match?.[2];
+  return capture ?? 'missing';
+}
+`;
