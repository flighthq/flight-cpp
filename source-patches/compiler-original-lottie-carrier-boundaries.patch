+    {
+      packageName: '@flighthq/domain',
+      name: 'domain/src/contract.ts',
+      text: 'export interface Item{value:number}export interface Other{other:string}export type Value=Item|Other|Record<string,unknown>;',
+    },
+    {
+      packageName: '@flighthq/probe',
+      name: 'probe/src/probe.ts',
+      text: 'import type{Item,Value}from "@flighthq/domain/contract";export function view(value:Value):Readonly<Item>{return value as Readonly<Item>;}export function fromCallback(read:()=>Value):Readonly<Item>{return read() as Readonly<Item>;}export function optional(value:Value|undefined):Readonly<Item>|undefined{return value as Readonly<Item>|undefined;}',
+    },
+  ];
+  const results = lowerTypeScriptSources(
+    sources.map((source) => ({
+      packageName: source.packageName,
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/' + source.name, source.text, ts.ScriptTarget.Latest, true),
+    })),
