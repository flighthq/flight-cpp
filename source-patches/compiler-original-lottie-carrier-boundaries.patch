+      moduleResolution,
+      options: {
+        runtimeProfile: 'flight-cpp',
+        packageTargets: {
+          '@flighthq/domain': { namespace: 'domain', includePrefix: 'fixture/domain' },
+          '@flighthq/probe': { namespace: 'probe', includePrefix: 'fixture/probe' },
+        },
+      },
