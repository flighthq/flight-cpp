+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+export const source = `export interface Document{value?:0|1|2} export function align(document:Readonly<Document>):string{return document.value===1?'right':document.value===2?'center':'left';}`;
+function emit(text = source) {
+  const [result] = lowerTypeScriptSources([
+    {
+      packageName: '@flighthq/probe',
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/probe/src/probe.ts', text, ts.ScriptTarget.Latest, true),
+    },
+  ]);
+  expect(result!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result!.module, {
+    runtimeProfile: 'flight-cpp',
+    packageTargets: { '@flighthq/probe': { namespace: 'probe', includePrefix: 'fixture' } },
+  }).contents;
+}
+it('keeps undefined in the original optional carrier when only a literal value was excluded', () => {
+  const output = emit();
+  expect(output).not.toContain('.value()');
+  expect(output).not.toContain('NOT GENERATED');
+});
+it('still refuses strict null narrowing that leaves a different sentinel reachable', () => {
+  expect(() =>
+    emit(
+      'export interface Document{value?:number|null} export function read(document:Readonly<Document>):number|undefined{if(document.value!==null)return document.value;return 0;}',
+    ),
+  ).toThrow('still admits absence');
+});
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const toolchain = findCppCompilerToolchain();
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+it.skipIf(!toolchain || includes.length === 0)(
+  'matches source equality for absence, each literal and other physical numeric values',
+  () => {
+    const dir = mkdtempSync(path.join(tmpdir(), 'flight-optional-literal-range-'));
+    try {
+      writeFileSync(path.join(dir, 'probe.hpp'), emit());
+      const js = {} as { align: (document: { value?: number | undefined }) => string };
+      new Function(
+        'exports',
+        ts.transpileModule(source, {
+          compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+        }).outputText,
+      )(js);
+      const cases = [undefined, 0, 1, 2, 3, -1, NaN, Infinity]
+        .map(
+          (value) =>
+            `{${value !== undefined},${value === undefined ? '0' : Number.isNaN(value) ? 'std::numeric_limits<double>::quiet_NaN()' : value === Infinity ? 'std::numeric_limits<double>::infinity()' : value},${JSON.stringify(js.align({ value }))}}`,
+        )
+        .join(',');
+      const input = path.join(dir, 'native.cpp'),
+        binary = path.join(dir, getCppExecutableName(toolchain!, 'native'));
+      writeFileSync(
+        input,
+        `#include "probe.hpp"
+#include <iostream>
+#include <limits>
+int main(){int checks=0,failures=0;auto check=[&](bool ok){++checks;if(!ok)++failures;};auto owner=flight::make_ref<probe::Document>();
+using Row=flight::StructuralRef<flight::RowReadonly<flight::RowOf<flight::Ref<probe::Document>>>>;Row row(owner);
+struct Case{bool present;double value;const char* expected;};for(const auto& item:std::initializer_list<Case>{${cases}}){owner->value=item.present?std::optional<double>(item.value):std::nullopt;check(probe::align(row)==flight::String(item.expected));}
+owner->value=1;check(probe::align(row)==flight::String("right"));owner->value.reset();check(probe::align(row)==flight::String("left"));
+std::cout<<checks<<" checks, "<<failures<<" failures\\n";return failures?1:0;}`,
+      );
+      execFileSync(toolchain!.command, createCppExecutableArguments(toolchain!, input, binary, [dir, ...includes]), {
+        stdio: 'pipe',
+      });
+      expect(execFileSync(binary, [], { encoding: 'utf8' })).toContain('10 checks, 0 failures');
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  },
+  120000,
+);
