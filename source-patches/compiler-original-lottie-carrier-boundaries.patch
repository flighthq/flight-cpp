+  expect(output).toContain('flight::RowReadonly<flight::RowOf<flight::Ref<domain::Item>>>');
+  expect(output).not.toContain('static_pointer_cast');
+});
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const toolchain = findCppCompilerToolchain();
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+it.skipIf(!toolchain || includes.length === 0)(
+  'retains the exact imported owner, live values, lifetime and callback timing',
+  () => {
+    const dir = mkdtempSync(path.join(tmpdir(), 'flight-imported-readonly-owner-'));
+    try {
+      const output = emit();
+      mkdirSync(path.join(dir, 'fixture/domain'), { recursive: true });
+      writeFileSync(path.join(dir, 'fixture/domain/contract.hpp'), output.domain);
+      writeFileSync(path.join(dir, 'probe.hpp'), output.consumer);
+      const input = path.join(dir, 'native.cpp'),
+        binary = path.join(dir, getCppExecutableName(toolchain!, 'native'));
+      writeFileSync(
+        input,
+        `#include "probe.hpp"
+#include <iostream>
+#include <type_traits>
+int main(){int checks=0,failures=0;auto check=[&](bool ok){++checks;if(!ok)++failures;};
+using Row=flight::StructuralRef<flight::RowReadonly<flight::RowOf<flight::Ref<domain::Item>>>>;
+using Mutable=flight::StructuralRef<flight::RowWritable<flight::RowOf<flight::Ref<domain::Item>>>>;
+static_assert(!std::is_convertible_v<Row,Mutable>);
+std::weak_ptr<domain::Item> lifetime;
+{auto owner=flight::make_ref<domain::Item>();owner->value=7;lifetime=owner;domain::Value value=owner;
+auto view=probe::view(value);check(view.shared_native_object().get()==owner.get());check(flight::row_get<flight::RowKey<"value">>(view)==7);
+owner->value=11;check(flight::row_get<flight::RowKey<"value">>(view)==11);
+int calls=0;auto callback=probe::from_callback([&]()->domain::Value{++calls;return value;});check(calls==1&&callback.identity()==view.identity());
+bool threw=false;try{(void)probe::from_callback([]()->domain::Value{throw flight::TypeError("original");});}catch(const flight::TypeError&){threw=true;}check(threw);
+check(!probe::optional(std::nullopt));auto optional=probe::optional(std::optional<domain::Value>{value});check(optional&&optional->identity()==view.identity());
+owner.reset();value=flight::Record<flight::String,flight::Any>{};check(!lifetime.expired());check(flight::row_get<flight::RowKey<"value">>(view)==11);}
+check(lifetime.expired());std::cout<<checks<<" checks, "<<failures<<" failures\\n";return failures?1:0;}`,
+      );
+      execFileSync(toolchain!.command, createCppExecutableArguments(toolchain!, input, binary, [dir, ...includes]), {
+        stdio: 'pipe',
