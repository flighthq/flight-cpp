 type PexDict = Record<string, string>;
 
+// `key in dict` for a dictionary created as `{}`: an own key, or one of Object.prototype's own property names,
+// which an ordinary object inherits.
+const OBJECT_PROTOTYPE_KEYS: ReadonlySet<string> = new Set<string>([
+  '__defineGetter__',
+  '__defineSetter__',
+  '__lookupGetter__',
+  '__lookupSetter__',
+  '__proto__',
+  'constructor',
+  'hasOwnProperty',
+  'isPrototypeOf',
+  'propertyIsEnumerable',
+  'toLocaleString',
+  'toString',
+  'valueOf',
+]);
+
+function pexDictHas(dict: PexDict, key: string): boolean {
+  return Object.hasOwn(dict, key) || OBJECT_PROTOTYPE_KEYS.has(key);
+}
