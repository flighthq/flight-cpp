+// optional-storage and erased-value lanes use, and the operand is evaluated once.
+function emitCppErrorPresenceMemberTestCpp(
+  operand: Readonly<IrExpression>,
+  sentinel: 'null' | 'undefined',
+  present: boolean,
+  strict: boolean,
+  context: EmitContext,
+): string | undefined {
