+function getCppGuardedPathKeyCpp(expression: Readonly<IrExpression>): string | undefined {
+  if (expression.kind === 'identifier' && expression.reference.kind === 'binding') {
+    return expression.reference.binding.id;
+  }
+  if (expression.kind !== 'property' || expression.optional) return undefined;
+  const prefix = getCppGuardedPathKeyCpp(expression.object);
+  return prefix === undefined ? undefined : `${prefix}.${expression.name}`;
