+  statement: Readonly<IrStatement>,
+  context: EmitContext,
+): ReadonlyMap<string, string> {
+  if (statement.kind !== 'if' || statement.otherwise !== undefined) return new Map();
+  if (!isCppAbruptCompletionStatement(statement.consequent)) return new Map();
