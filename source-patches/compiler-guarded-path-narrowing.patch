@@ -0,0 +1,214 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// The proof a lowered `instanceof` guard carries, and the read it projects.
+//
+// A property read whose declared union the analysis cannot state -- a member declared through an alias, or a
+// union naming a type the run's profiles do not provide -- has no semantic proof to project through, while the
+// GUARD still names the alternative and the carrier it tested. This backend change carries that name into the
+// branch the guard controls and emits the read as the throwing twin of the guard's own question, from the same
+// carrier expansion. Its lifetime is TypeScript's: a write to the path or any prefix withdraws it, any call
+// withdraws it, and it never escapes the branch that proves it.
+//
+// The imported-alias case (`body: NetResponseBody`, the measured @flighthq/loader shape) is proven end to end by
+// regenerating that package: `load.hpp` must contain the projection. The stand-in used here -- the same guard and
+// read over a union the analysis cannot state -- differs only in why the semantic proof is absent.
+const NET_RESPONSE_BODY = 'string | unknown | ArrayBuffer | Blob | null';
+
+function lower(file: string, source: string, profileTypeNames?: readonly string[]) {
+  const sourceFile = ts.createSourceFile(
+    `/flight/packages/math/src/${file}`,
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  return lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/math',
+    upstreamDirectory: '/flight',
+    ...(profileTypeNames === undefined ? {} : { profileTypeNames }),
+  });
+}
+
+const externalBindings = {
+  bindings: [
+    { headers: ['flight/blob.hpp'], nullability: 'non-null' as const, ownership: 'shared' as const, sourceName: 'Blob', space: 'type' as const, targetName: 'flight::Blob' },
+    { headers: ['flight/blob.hpp'], nullability: 'non-null' as const, ownership: 'shared' as const, sourceName: 'Blob', space: 'value' as const, targetName: 'flight::Blob' },
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(file: string, source: string, profileTypeNames?: readonly string[]) {
+  return emitIrModuleCpp(lower(file, source, profileTypeNames).module, {
+    externalBindings,
+    runtimeProfile: 'flight-cpp',
+  }).contents;
+}
+
+function captureBackendEmissionFailure(run: () => unknown) {
+  try {
+    run();
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error;
+    throw error;
+  }
+  throw new Error('expected C++ emission to refuse and it did not');
+}
+
+const GUARD = 'flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr';
+const PROJECTION = 'flight::union_kind_or_throw<flight::ArrayBuffer>(response->body)';
+
+describe('the proof a lowered instanceof guard carries', () => {
+  it('projects a read whose union the analysis cannot state', () => {
+    const contents = emit(
+      'guarded-path-absent-evidence.ts',
+      `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`,
+    );
+    expect(contents).toContain(GUARD);
+    expect(contents).toContain(PROJECTION);
+    // Applied once: the carrier inside the projection is the carrier, not another projection.
+    expect(contents).toContain('flight::Uint8Array(flight::union_kind_or_throw<flight::ArrayBuffer>(response->body))');
+    expect(contents).not.toContain('union_kind_or_throw<flight::ArrayBuffer>(flight::union_kind_or_throw');
+  });
+
+  it('projects the same read when the union evidence IS available, from that proof', () => {
+    const contents = emit(
+      'guarded-path-with-evidence.ts',
+      `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`,
+      ['Blob'],
+    );
+    expect(contents).toContain(GUARD);
+    expect(contents).toContain('flight::Uint8Array(flight::union_kind_or_throw<flight::ArrayBuffer>(response->body))');
+  });
+
+  it('projects a read the semantic proof already reaches, exactly once', () => {
+    const contents = emit(
+      'guarded-path-written-union.ts',
+      `export interface R { ok: boolean; body: string | ArrayBuffer | null; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`,
+    );
+    expect(contents).toContain(GUARD);
+    expect(contents).toContain('flight::Uint8Array(std::get<0>(response->body.value()))');
+    expect(contents).not.toContain('union_kind_or_throw<flight::ArrayBuffer>(flight::union_kind_or_throw');
+  });
+
+  it('projects a read behind a terminating guard', () => {
+    const contents = emit(
+      'guarded-path-terminating.ts',
+      `export interface R { body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array {
+         if (!(response.body instanceof ArrayBuffer)) throw new Error('bad');
+         return new Uint8Array(response.body);
+       }`,
+    );
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr');
+    expect(contents).toContain(PROJECTION);
+  });
+
+  it('reads the same carrier the guard tested, by reference', () => {
+    const contents = emit(
+      'guarded-path-identity.ts',
+      `export interface R { ok: boolean; body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         return response.ok && response.body instanceof ArrayBuffer ? new Uint8Array(response.body) : null;
+       }`,
+    );
+    // One carrier expression, named by both: the guard tests it and the projection reads into it. The
+    // runtime's own identity behaviour is pinned in tests/union_kind_test.cpp.
+    expect(contents.match(/response->body/g)?.length).toBeGreaterThanOrEqual(2);
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body)');
+    expect(contents).toContain('flight::union_kind_or_throw<flight::ArrayBuffer>(response->body)');
+  });
+
+  it('withdraws the proof when the path itself is written', () => {
+    const contents = emit(
+      'guarded-path-written.ts',
+      `export interface R { body: string | ArrayBuffer | null; }
+       export function f(response: R, next: string | ArrayBuffer | null): Uint8Array | null {
+         if (response.body instanceof ArrayBuffer) { response.body = next; return new Uint8Array(response.body); }
+         return null;
+       }`,
+    );
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr');
+    // The write is a value the guard said nothing about, so the read after it is emitted without a projection.
+    expect(contents).toContain('response->body =');
+    expect(contents).toContain('flight::Uint8Array(response->body)');
+    expect(contents).not.toContain('union_kind_or_throw');
+  });
+
+  it('withdraws the proof when a prefix of the path is written', () => {
+    const contents = emit(
+      'guarded-path-prefix-written.ts',
+      `export interface R { body: string | ArrayBuffer | null; }
+       export function f(response: R, other: R): Uint8Array | null {
+         if (response.body instanceof ArrayBuffer) { response = other; return new Uint8Array(response.body); }
+         return null;
+       }`,
+    );
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr');
+    expect(contents).toContain('response = other');
+    expect(contents).not.toContain('union_kind_or_throw');
+  });
+
+  it('withdraws the proof across a call, as TypeScript does for a property narrowing', () => {
+    const contents = emit(
+      'guarded-path-call.ts',
+      // The call does not itself read the path, so the only projection the assertion can see is the one the
+      // rule is about: whether the proof survives the call for the read after it.
+      `export interface R { body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         if (response.body instanceof ArrayBuffer) { const n = Number('1'); return new Uint8Array(response.body); }
+         return null;
+       }`,
+    );
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr');
+    expect(contents).not.toContain('union_kind_or_throw');
+  });
+
+  it('does not project a different path that the same guard proves nothing about', () => {
+    const contents = emit(
+      'guarded-path-other.ts',
+      `export interface R { body: string | ArrayBuffer | null; other: string | ArrayBuffer | null; }
+       export function f(response: R): Uint8Array | null {
+         return response.body instanceof ArrayBuffer ? new Uint8Array(response.other) : null;
+       }`,
+    );
+    expect(contents).toContain('flight::union_kind_if<flight::ArrayBuffer>(response->body) != nullptr');
+    expect(contents).not.toContain('union_kind_or_throw');
+  });
+
+  it('does not project the path outside the branch the guard controls', () => {
+    const contents = emit(
+      'guarded-path-outside.ts',
+      `export interface R { body: ${NET_RESPONSE_BODY}; }
+       export function f(response: R): Uint8Array | null {
+         if (response.body instanceof ArrayBuffer) return new Uint8Array(response.body);
+         return new Uint8Array(response.body);
+       }`,
+    );
+    expect(contents.match(/union_kind_or_throw/g)?.length).toBe(1);
+    expect(contents.match(/flight::Uint8Array\(response->body\)/g)?.length).toBe(1);
+  });
+
+  it('refuses a guard whose operand has no carrier to ask about', () => {
+    const failure = captureBackendEmissionFailure(() =>
+      emit(
+        'guarded-path-concrete.ts',
+        `export function f(value: ArrayBuffer): boolean { return value instanceof Uint8Array; }`,
+      ),
+    );
+    expect(failure.rule).toBe('cpp-instanceof-operand-unresolved');
+  });
+});
