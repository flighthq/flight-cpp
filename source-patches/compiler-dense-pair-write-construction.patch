@@ -0,0 +1,157 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const prelude = `
+  interface Point { x: number; y: number }
+  const point: Point = { x: 0, y: 0 };
+  function transformPoint(out: Point, a: number, b: number): void { out.x = a + b; out.y = a - b; }
+`;
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/pairs.ts', prelude + source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+it('constructs a length-sized array that a pair-write loop fills before it escapes', () => {
+  const output = emit(`
+    export function build(contours: number[][]): number[][] {
+      const out: number[][] = [];
+      for (const contour of contours) {
+        const transformed = new Array<number>(contour.length);
+        for (let i = 0; i < contour.length; i += 2) {
+          transformPoint(point, contour[i], contour[i + 1]);
+          transformed[i] = point.x;
+          transformed[i + 1] = point.y;
+        }
+        out.push(transformed);
+      }
+      return out;
+    }
+  `);
+  // The sized allocation is cleared, then every pair is an append checked at the current length: the
+  // unobservable holes are never read and no zero-filled value is ever observed.
+  expect(output).toContain('flight::Array<double>(static_cast<double>(contour.size()))');
+  expect(output).toContain('.clear()');
+  expect(output).toContain('sequential_append_index != static_cast<double>(sequential_append_receiver.size())');
+  // The in-bounds element keeps its checked read; the partner slot is read through the presence-aware
+  // scalar cell at its numeric argument, so an absent partner is NaN rather than a range error.
+  expect(output).toContain('contour.element(i)');
+  expect(output).toContain('.get(');
+  expect(output).toContain('flight::JsonScalarCell{flight::Any{*');
+  expect(output).toContain('flight::JsonScalarCell{}.to_number()');
+  // The result is still a flight::Array, not a copied or substituted owner.
+  expect(output).toContain('flight::Array<double> transformed');
+});
+
+it('accepts an unassigned array parameter as the stable write bound', () => {
+  const output = emit(`
+    export function build(contour: number[]): number[] {
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        transformPoint(point, contour[i], contour[i + 1]);
+        transformed[i] = point.x;
+        transformed[i + 1] = point.y;
+      }
+      return transformed;
+    }
+  `);
+  expect(output).toContain('sequential_append_index');
+});
+
+it('refuses when the call can reach the array itself', () => {
+  const source = `
+    function mutate(values: number[]): void { values.push(1); }
+    export function build(contour: number[]): number[] {
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        mutate(contour);
+        transformed[i] = contour[i];
+        transformed[i + 1] = contour[i + 1];
+      }
+      return transformed;
+    }
+  `;
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/pairs.ts', prelude + source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  expect(() => emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' })).toThrow(/Array length construction/);
+});
+
+it('refuses when the loop body mutates the bound array', () => {
+  const source = `
+    export function build(contour: number[]): number[] {
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        contour.push(0);
+        transformed[i] = contour[i];
+        transformed[i + 1] = contour[i + 1];
+      }
+      return transformed;
+    }
+  `;
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/pairs.ts', prelude + source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  expect(() => emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' })).toThrow(/Array length construction/);
+});
+
+it('keeps the general indexed read unchanged outside a pair-write numeric argument', () => {
+  const output = emit(`
+    export function raw(values: number[], index: number): number { return values[index]; }
+  `);
+  expect(output).toContain('values.element(index)');
+  expect(output).not.toContain('JsonScalarCell');
+});
+
+it('refuses when a closure defined before the loop can mutate the bound array', () => {
+  const source = `
+    export function build(contour: number[]): number[] {
+      const mutate = (): void => { contour.push(0); };
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        mutate();
+        transformed[i] = contour[i];
+        transformed[i + 1] = contour[i + 1];
+      }
+      return transformed;
+    }
+  `;
+  expect(() => emit(source)).toThrow(/Array length construction/);
+});
+
+it('refuses when an alias of the array is handed to a call', () => {
+  const source = `
+    function consume(values: number[]): void { values.push(0); }
+    export function build(contour: number[]): number[] {
+      const alias = contour;
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        consume(alias);
+        transformed[i] = contour[i];
+        transformed[i + 1] = contour[i + 1];
+      }
+      return transformed;
+    }
+  `;
+  expect(() => emit(source)).toThrow(/Array length construction/);
+});
+
+it('refuses when the bound array is stored in a module global before the loop', () => {
+  const source = `
+    const registry: number[][] = [];
+    export function build(contour: number[]): number[] {
+      registry.push(contour);
+      const transformed = new Array<number>(contour.length);
+      for (let i = 0; i < contour.length; i += 2) {
+        transformed[i] = contour[i];
+        transformed[i + 1] = contour[i + 1];
+      }
+      return transformed;
+    }
+  `;
+  expect(() => emit(source)).toThrow(/Array length construction/);
+});
