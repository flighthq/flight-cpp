+// The source compares function objects, including exact null and undefined states. Normalize both
+// carriers before visiting, evaluate each operand once in source order, and compare only retained
+// callable identities; a null sentinel never becomes undefined or a fabricated callback.
+function emitCppCallableIdentityComparisonCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'binary' }>>,
+  leftType: Readonly<IrType> | undefined,
+  rightType: Readonly<IrType> | undefined,
+  context: EmitContext,
+): string | undefined {
+  if (
+    getCppRuntimeProfile(context.options) !== 'flight-cpp' ||
+    !leftType ||
+    !rightType ||
+    (expression.operator !== '===' && expression.operator !== '!==')
+  )
+    return undefined;
+  const leftCallable = getCppClosedCallableType(leftType, context, new Set());
+  const rightCallable = getCppClosedCallableType(rightType, context, new Set());
+  if (!leftCallable || !rightCallable || leftCallable.typeParameters.length || rightCallable.typeParameters.length)
+    return undefined;
+  const callableType = emitType(leftCallable, context);
+  if (!callableType.startsWith('std::function<') || callableType !== emitType(rightCallable, context)) return undefined;
+  const common: IrType = { kind: 'union', types: [leftCallable, { kind: 'null' }, { kind: 'undefined' }] };
+  const left = getGeneratedTargetName('callableIdentityLeft', context);
+  const right = getGeneratedTargetName('callableIdentityRight', context);
+  context.includes.add('flight/callable.hpp');
+  context.includes.add('type_traits');
+  context.includes.add('variant');
+  const compare = `std::visit([](const auto& left, const auto& right) -> bool { using Left = std::remove_cvref_t<decltype(left)>; using Right = std::remove_cvref_t<decltype(right)>; if constexpr (!std::is_same_v<Left, Right>) return false; else if constexpr (std::is_same_v<Left, ${callableType}>) return flight::callable_identity_equal(left, right); else return true; }, ${left}, ${right})`;
+  return `([&]() { auto ${left} = ${emitExpression(expression.left, context, common)}; auto ${right} = ${emitExpression(expression.right, context, common)}; return ${expression.operator === '!==' ? '!' : ''}${compare}; }())`;
+}
+
 function emitCppReferenceIdentityComparison(
   expression: Readonly<Extract<IrExpression, { kind: 'binary' }>>,
   leftType: Readonly<IrType> | undefined,
