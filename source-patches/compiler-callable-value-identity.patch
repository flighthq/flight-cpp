--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppCallableIdentityComparison.test.ts
@@ -0,0 +1,105 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import ts from 'typescript';
+
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const toolchain = findCppCompilerToolchain();
+const includes = collectCppRuntimeIncludeDirectories(resolveDependency(root, 'flight-cpp').directory);
+
+function emitCallableFixture() {
+  const source = `
+    type Handler = (value: number) => number;
+    interface Slot { fillBounds: Handler | null }
+    export function makeHandler(seed: number): Handler { return (value) => seed + value; }
+    export function namedHandler(value: number): number { return value + 1; }
+    export function makeOwnedHandler(seed: number): Handler {
+      const owner = { value: seed };
+      const handler: Handler = (value) => { owner.value += value; return owner.value; };
+      owner.value += 1;
+      return handler;
+    }
+    export function equal(left: Handler | null | undefined, right: Handler | null | undefined): boolean { return left === right; }
+    export function different(left: Handler | null | undefined, right: Handler | null | undefined): boolean { return left !== right; }
+    export function fromSlot(previous: Readonly<Slot> | undefined, command: Slot): boolean { return previous?.fillBounds === command.fillBounds; }
+    let reads = 0;
+    function readLeft(value: Handler | null | undefined): Handler | null | undefined { reads = reads * 10 + 1; return value; }
+    function readRight(value: Handler | null | undefined): Handler | null | undefined { reads = reads * 10 + 2; return value; }
+    export function ordered(left: Handler | null | undefined, right: Handler | null | undefined): boolean { reads = 0; const same = readLeft(left) === readRight(right); return same && reads === 12; }
+    function throwingLeft(): Handler { reads = reads * 10 + 1; throw 7; }
+    export function interrupted(right: Handler): boolean { reads = 0; return throwingLeft() === readRight(right); }
+    export function readCount(): number { return reads; }
+    export function exercise(): boolean {
+      const first = makeHandler(1);
+      const alias = first;
+      const second = makeHandler(1);
+      const owned = makeOwnedHandler(1);
+      const ownedAlias = owned;
+      const present: Slot = { fillBounds: first };
+      const absent: Slot = { fillBounds: null };
+      return equal(first, alias) && !equal(first, second) && first(2) === 3 && second(2) === 3 &&
+        equal(null, null) && equal(undefined, undefined) && !equal(null, undefined) && !equal(undefined, null) &&
+        !equal(first, null) && !equal(first, undefined) && different(first, second) && !different(first, alias) &&
+        fromSlot(present, present) && fromSlot(absent, absent) && !fromSlot(undefined, absent) &&
+        ordered(first, alias) && ordered(null, null) && ordered(undefined, undefined) &&
+        equal(namedHandler, namedHandler) && !equal(namedHandler, first) && !equal(first, namedHandler) &&
+        equal(owned, ownedAlias) && owned(2) === 4 && ownedAlias(3) === 7;
+    }
+  `;
+  const [result] = lowerTypeScriptSources([
+    {
+      packageName: '@flighthq/math',
+      upstreamDirectory: '/flight',
+      sourceFile: ts.createSourceFile('/flight/packages/math/src/callables.ts', source, ts.ScriptTarget.Latest, true),
+    },
+  ]);
+  expect(result!.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result!.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe('callable value identity', () => {
+  it('retains function literal identity and compares exact null/undefined/function states once', () => {
+    const cpp = emitCallableFixture();
+    expect(cpp).toContain('flight::Function<double(double)>');
+    expect(cpp).toContain('flight::callable_identity_equal');
+    expect(cpp).toContain('std::visit');
+  });
+
+  it.skipIf(!toolchain || !includes.length)(
+    'compiles, links and runs original emitted callable identities and presence comparisons',
+    () => {
+      if (!toolchain) throw new Error('toolchain missing');
+      const directory = mkdtempSync(path.join(tmpdir(), 'flight-callable-identity-'));
+      try {
+        const source = path.join(directory, 'callables.cpp');
+        const binary = path.join(directory, getCppExecutableName(toolchain, 'callables'));
+        writeFileSync(
+          source,
+          emitCallableFixture() +
+            '\nint main() { if (!flighthq_math::exercise()) return 1; try { flighthq_math::interrupted(flighthq_math::make_handler(1)); } catch (double value) { return value == 7 && flighthq_math::read_count() == 1 ? 0 : 2; } return 3; }\n',
+        );
+        execFileSync(toolchain.command, createCppExecutableArguments(toolchain, source, binary, includes), {
+          encoding: 'utf8',
+          stdio: 'pipe',
+        });
+        execFileSync(binary, [], { encoding: 'utf8', stdio: 'pipe' });
+      } finally {
+        rmSync(directory, { recursive: true, force: true });
+      }
+    },
+    120000,
+  );
+});
