--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppReadonlyHelperProjection.test.ts
@@ -0,0 +1,134 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import type { CompilerModuleResolutionPlan } from '../../compiler-types/src/index.js';
+import { createCppCompilerBackend } from './cppCompilerBackend.js';
+
+function emitReadonlyHelper(code: string, imported = false): string {
+  const packageName = '@flighthq/readonly-helper';
+  const ownerPackage = '@flighthq/helper-owner';
+  const declarations = `export interface Base { value: number }
+    export interface Owner extends Base { cache: Map<string, number> }
+    export interface Runtime { active: Owner | null }`;
+  const source = (owner: string, file: string, text: string) => ({
+    packageName: owner,
+    sourceFile: ts.createSourceFile(
+      `/flight/packages/${owner.slice('@flighthq/'.length)}/src/${file}.ts`,
+      text,
+      ts.ScriptTarget.Latest,
+      true,
+    ),
+    upstreamDirectory: '/flight',
+  });
+  const moduleResolution: CompilerModuleResolutionPlan = {
+    edges: [
+      {
+        specifier: '@flighthq/helper-owner/contract',
+        target: { packageName: ownerPackage, source: 'packages/helper-owner/src/contract.ts' },
+      },
+    ],
+    schema: 'flight-compiler-module-resolution/1',
+  };
+  const results = lowerTypeScriptSources(
+    imported
+      ? [
+          source(ownerPackage, 'contract', declarations),
+          source(
+            packageName,
+            'calls',
+            `import type { Base, Owner, Runtime } from '@flighthq/helper-owner/contract'; ${code}`,
+          ),
+        ]
+      : [source(packageName, 'calls', declarations + code)],
+    moduleResolution,
+  );
+  expect(results.flatMap((result) => result.diagnostics)).toEqual([]);
+  const modules = results.map((result) => result.module);
+  return createCppCompilerBackend().createEmissionSession!({
+    moduleResolution,
+    modules,
+    options: { runtimeProfile: 'flight-cpp' },
+  }).emitModule(modules[modules.length - 1]!)[0]!.contents;
+}
+
+function readCall(text: string): string {
+  const call = text.split('\n').find((line) => line.includes('return read_value('));
+  expect(call).toBeDefined();
+  return call!;
+}
+
+describe('emitIrModuleCpp', () => {
+  it('requests only a readonly projection at the guarded nominal-slot helper boundary', () => {
+    for (const imported of [false, true]) {
+      const text = emitReadonlyHelper(
+        `
+        export function readValue(owner: Readonly<Owner>): number { return owner.value; }
+        export function handoff(runtime: Runtime): number {
+          const owner = runtime.active;
+          if (owner === null) return -1;
+          return readValue(owner);
+        }`,
+        imported,
+      );
+      const call = readCall(text);
+      expect(call).toContain('RowReadonly<');
+      expect(call).toContain('(owner.value())');
+      expect(call).not.toContain('RowWritable<');
+      expect(text).toContain('if (!owner.has_value())');
+      expect(text.split('owner = runtime->active;')).toHaveLength(2);
+    }
+  });
+
+  it('retains a checked base read projection without requesting writes to the wider owner', () => {
+    const call = readCall(
+      emitReadonlyHelper(`
+      export function readValue(owner: Readonly<Base>): number { return owner.value; }
+      export function handoff(owner: Owner): number { return readValue(owner); }
+    `),
+    );
+    expect(call).toContain('structural_ref_cast<');
+    expect(call).toContain('RowReadonly<');
+    expect(call).not.toContain('RowWritable<');
+  });
+
+  it('evaluates an effectful owner producer once for the readonly helper', () => {
+    const call = readCall(
+      emitReadonlyHelper(`
+      export function readValue(owner: Readonly<Owner>): number { return owner.value; }
+      export function handoff(produce: () => Owner): number { return readValue(produce()); }
+    `),
+    );
+    expect(call.split('produce()')).toHaveLength(2);
+    expect(call).not.toContain('RowWritable<');
+  });
+
+  it('preserves the already-supported exact guarded readonly binding projection', () => {
+    for (const sentinel of ['null', 'undefined']) {
+      const text = emitReadonlyHelper(`
+        export function readValue(owner: Readonly<Owner>): number { return owner.value; }
+        export function handoff(owner: Readonly<Owner> | ${sentinel}): number {
+          if (owner === ${sentinel}) return -1;
+          return readValue(owner);
+        }`);
+      expect(readCall(text)).toBe('  return read_value(owner.value());');
+    }
+  });
+
+  it('keeps writable helpers distinct from readonly callers', () => {
+    const text = emitReadonlyHelper(`
+      export function writeValue(owner: Partial<Owner>): void { owner.value = 9; }
+      export function handoff(owner: Owner): void { writeValue(owner); }
+    `);
+    expect(text).toContain('write_value(owner);');
+    expect(text).not.toContain('RowReadonly<');
+    const readonlyCall = emitReadonlyHelper(`
+      export function writeValue(owner: Partial<Owner>): void { owner.value = 9; }
+      export function handoff(owner: Readonly<Owner>): void { writeValue(owner); }
+    `);
+    expect(readonlyCall).toContain('RowReadonly<');
+    expect(readonlyCall).toContain('write_value(owner);');
+    expect(readonlyCall).not.toContain('shared_exact_object');
+    expect(readonlyCall).not.toContain('materialize_row');
+  });
+});
