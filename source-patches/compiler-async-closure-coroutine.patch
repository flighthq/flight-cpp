+// An async closure, lowered to a coroutine that cannot outlive what it reads.
+//
+// A coroutine lambda's frame does not copy the lambda's captures: it keeps a pointer to the closure object and
+// reads them through it. Any owner that drops the closure while the coroutine is suspended -- `then` once it has
+// started the callback, an object whose async method is mid-await when the object goes -- leaves the frame
+// reading released memory. So the coroutine lambda is held in a shared owner created when the closure is
+// created, and each call hands that owner to `flight::retain_closure`, which keeps it alive exactly as long as
+// the call's coroutine frame. The call's task is returned unchanged: it starts eagerly and settles when the body
+// completes, as the module-level async function does, with no additional scheduling step.
+//
+// Captures are taken where the closure is created, as for any closure: the inner lambda is constructed in the
+// outer one's capture initializer. The outer callable has the same parameters and result, so it is assignable
+// wherever the inner one would have been.
+function emitCppAsyncClosureCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'function' }>>,
+  parameters: readonly Readonly<IrParameter>[],
+  params: readonly string[],
+  capture: string,
+  returns: Readonly<IrType>,
+  context: EmitContext,
+  prologue: readonly string[],
+): string {
+  context.includes.add('coroutine');
+  context.includes.add('functional');
+  context.includes.add('memory');
+  context.includes.add('flight/task.hpp');
+  const resultType = emitType(returns, context);
+  const parameterTypes = params.map((parameter) => {
+    const separator = parameter.lastIndexOf(' ');
+    return parameter.slice(0, separator);
+  });
+  if (parameterTypes.some((type) => type === 'auto' || type.includes('&&...'))) {
+    emissionError(context, 'async closures require C++ coroutine lowering');
+  }
+  const argumentNames = params.map((parameter) => parameter.slice(parameter.lastIndexOf(' ') + 1));
+  const awaited = getIrTaskAwaitedTypeCpp(returns, context);
+  const body = expression.expression
+    ? !(awaited.kind === 'primitive' && awaited.name === 'void')
+      ? [`co_return ${emitExpression(expression.expression, context, awaited)};`]
+      : [`${emitExpression(expression.expression, context)};`, 'co_return;']
+    : [...emitStatements(expression.body, context), ...emitImplicitCompletionCpp(expression.body, context)];
+  const inner = `${capture}(${params.join(', ')}) -> ${resultType} {\n${indentSourceLines([...prologue, ...body]).join('\n')}\n}`;
+  const holder = getGeneratedTargetName('asyncClosure', context);
+  const signature = `std::function<${resultType}(${parameterTypes.join(', ')})>`;
+  return `[${holder} = std::make_shared<const ${signature}>(${inner})](${params.join(', ')}) -> ${resultType} { return flight::retain_closure((*${holder})(${argumentNames.join(', ')}), ${holder}); }`;
+}
