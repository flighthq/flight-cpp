+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+// The coroutine lambda is held in a shared owner made where the closure is made, and every call hands that owner
+// to flight::retain_closure, which keeps it alive for the call's coroutine frame.
+describe('async closures lower to coroutines that keep their closure alive', () => {
+  it('lowers an async callback handed to then', () => {
+    const emitted = emit(`export function chain(tail: Promise<void>, log: string[]): Promise<void> {
+      return tail.then(async () => { log.push('before'); await tail; log.push('after'); });
+    }`);
+    expect(emitted).toContain(
+      'return tail.then([async_closure = std::make_shared<const std::function<flight::Task<void>()>>([=]() -> flight::Task<void> {',
+    );
+    expect(emitted).toContain('co_await tail;');
+    expect(emitted).toContain(
+      '})]() -> flight::Task<void> { return flight::retain_closure((*async_closure)(), async_closure); });',
+    );
+    expect(emitted).toContain('#include <coroutine>');
+  });
+
+  it('lowers an async object method with the callable type its member declares', () => {
+    const emitted = emit(`export interface Box { value: string }
+      export interface Holder { box: Box; read(): Promise<string> }
+      export function holder(box: Box, gate: Promise<void>): Holder {
+        return { box, async read(): Promise<string> { await gate; return box.value; } };
+      }`);
+    expect(emitted).toContain('std::function<flight::Task<flight::String>()> read;');
+    expect(emitted).toContain('.read = [async_closure = std::make_shared<const std::function<flight::Task<flight::String>()>>(');
+    expect(emitted).toContain('co_return box->value;');
+  });
+
+  it('lowers an expression-bodied async arrow with its parameters forwarded', () => {
+    const emitted = emit(`export function doubler(): (x: number) => Promise<number> { return async (x: number) => x * 2; }`);
+    expect(emitted).toContain('co_return (x * 2.0);');
+    expect(emitted).toContain(
+      '](double x) -> flight::Task<double> { return flight::retain_closure((*async_closure)(x), async_closure); };',
+    );
+  });
+
+  it('keeps a shared mutable capture in its binding cell', () => {
+    const emitted = emit(`export function counter(gate: Promise<void>): () => Promise<number> {
+      let n = 0;
+      return async () => { n += 1; await gate; return n; };
+    }`);
+    expect(emitted).toContain('const auto n_capture = flight::make_binding_cell(double{0.0});');
+    expect(emitted).toContain('co_return n_capture.read_binding();');
+  });
+
+  it('refuses a generic async closure, which has no single callable type to keep alive', () => {
+    expect(() =>
+      emit(`export function f(): <T>(value: T) => Promise<T> { return async <T>(value: T): Promise<T> => value; }`),
+    ).toThrow(/async closures require C\+\+ coroutine lowering/);
+  });
+
+  it('refuses an async closure with a rest parameter', () => {
+    expect(() =>
+      emit(`export function f(): (...values: number[]) => Promise<number> { return async (...values: number[]) => values.length; }`),
+    ).toThrow(/async closures require C\+\+ coroutine lowering/);
+  });
+
+  it('refuses an async closure that uses this', () => {
+    expect(() =>
+      emit(`export class C { value = 1; make(): () => Promise<number> { return async () => this.value; } }`),
+    ).toThrow(/async closures require C\+\+ coroutine lowering/);
+  });
+});
