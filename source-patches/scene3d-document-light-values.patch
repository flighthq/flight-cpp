@@ -0,0 +1,20 @@
+import type { AmbientLight } from './AmbientLight';
+import type { AreaLight } from './AreaLight';
+import type { DirectionalLight } from './DirectionalLight';
+import type { Environment } from './Environment';
+import type { HemisphereLight } from './HemisphereLight';
+import type { Light } from './Light';
+import type { PointLight } from './PointLight';
+import type { SpotLight } from './SpotLight';
+
+// The open Light arm keeps vendor descriptors accepted, while the redundant built-in arms retain
+// their concrete owners across heterogeneous document storage on invariant native targets.
+export type LightValue =
+  | Light
+  | AmbientLight
+  | AreaLight
+  | DirectionalLight
+  | Environment
+  | HemisphereLight
+  | PointLight
+  | SpotLight;
