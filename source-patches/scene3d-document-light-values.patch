@@ -0,0 +1,20 @@
+import type { AmbientLight } from './AmbientLight.ts';
+import type { AreaLight } from './AreaLight.ts';
+import type { DirectionalLight } from './DirectionalLight.ts';
+import type { Environment } from './Environment.ts';
+import type { HemisphereLight } from './HemisphereLight.ts';
+import type { Light } from './Light.ts';
+import type { PointLight } from './PointLight.ts';
+import type { SpotLight } from './SpotLight.ts';
+
+// The open Light arm keeps vendor descriptors accepted, while the redundant built-in arms retain
+// their concrete owners across heterogeneous document storage on invariant native targets.
+export type LightValue =
+  | Light
+  | AmbientLight
+  | AreaLight
+  | DirectionalLight
+  | Environment
+  | HemisphereLight
+  | PointLight
+  | SpotLight;
