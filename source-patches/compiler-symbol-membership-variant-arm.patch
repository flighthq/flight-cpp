@@ -0,0 +1,47 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/symbolMembershipArm.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const shapes = `
+  export const RuntimeKey: unique symbol = Symbol('runtime');
+  export interface EntityRuntime { id: number }
+  export interface Entity { [RuntimeKey]: EntityRuntime | undefined; kind: string }
+  export interface DeviceState extends Entity { device: number }
+  export interface StateRuntime extends EntityRuntime { context: number }
+`;
+
+it('tests the one arm that declares a required unique-symbol key', () => {
+  const output = emit(`${shapes}
+    export function pick(value: DeviceState | StateRuntime): number { return RuntimeKey in value ? 1 : 2; }
+  `);
+
+  expect(output).toContain('std::variant<flight::Ref<StateRuntime>, flight::Ref<DeviceState>> value');
+  expect(output).toContain('return (value.index() == 1 ? 1.0 : 2.0);');
+  expect(output).not.toContain('runtime_key in value');
+});
+
+it('takes no arm test when another arm declares the symbol key optionally', () => {
+  const output = emit(`${shapes}
+    export interface Detached { [RuntimeKey]?: EntityRuntime; kind: string; detached: true }
+    export function pick(value: DeviceState | Detached): number { return RuntimeKey in value ? 1 : 2; }
+  `);
+
+  expect(output).not.toMatch(/value\\.index\\(\\) == \\d \\? 1\\.0 : 2\\.0/);
+});
