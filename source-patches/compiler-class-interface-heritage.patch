+// The interface a class declares as its native base, resolved from the class's own imports. Only a
+// DECLARED pair adopts, the class must have no base of its own (one native interface base is the
+// bounded shape), and every interface member must be one the class can actually satisfy: a data
+// member needs the compatible field checked above, a method needs a plain instance method a thunk can
+// forward to. An interface member the class cannot satisfy leaves the class untouched, which keeps the
+// forward reference's existing diagnostic rather than inventing a body.
+function getCppClassInterfaceHeritageCpp(
+  declaration: Readonly<IrClassDeclaration>,
+  context: EmitContext,
+): Readonly<{
+  declaration: Readonly<IrInterfaceDeclaration>;
+  module: Readonly<IrModule>;
+  typeName: string;
+}> | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp') return undefined;
+  if (declaration.extends !== undefined || declaration.typeParameters.length > 0) return undefined;
+  const adoption = (context.options.classInterfaceAdoptions ?? []).find(
+    (candidate) => candidate.derive === true && candidate.class === declaration.binding.name,
+  );
+  if (!adoption) return undefined;
+  // The declaration is resolved by name across the whole program, not from this module's imports: the
+  // class that implements the interface need not mention it, which is exactly the structural case.
+  const matches = [...context.directBindingOwners.values()].flatMap((owner) =>
+    owner !== null &&
+    owner.declaration.kind === 'interface' &&
+    owner.declaration.binding.name === adoption.interface
+      ? [{ declaration: owner.declaration, module: owner.module }]
+      : [],
+  );
+  if (matches.length !== 1) return undefined;
+  const match = matches[0]!;
+  const interfaceDeclaration = match.declaration;
+  if (interfaceDeclaration.typeParameters.length > 0) return undefined;
+  const adoptable = interfaceDeclaration.properties.every(
+    (property) =>
+      !property.optional &&
+      property.phantom !== true &&
+      isCppClassInterfaceMemberCompatibleCpp(property, { declaration }, context) &&
+      isCppClassInterfaceThunkForwardableCpp(property, declaration),
+  );
+  if (!adoptable) return undefined;
+  const targetName =
+    context.targetNameMaps.get(getCppModuleIdentityKey(match.module))?.get(interfaceDeclaration.binding.id) ??
+    safeCppTypeName(interfaceDeclaration.binding.name);
+  const namespace = getCppCompilerPackageNamespace(match.module.packageName, context.options.packageTargets);
+  return {
+    declaration: interfaceDeclaration,
+    module: match.module,
+    typeName: namespace ? `${namespace}::${targetName}` : targetName,
+  };
+}
+
+// A data member needs no forwarding: the class's field IS the interface's cell once the duplicate
+// declaration is omitted. A method member is storage in the emitted interface, so the class must have
+// one plain instance method whose signature the thunk can take over exactly; an optional or rest
+// parameter, a generic, an async method, an accessor, a static, or a method with no body has no
+// faithful forward.
+function isCppClassInterfaceThunkForwardableCpp(
+  property: Readonly<IrObjectTypeProperty>,
+  declaration: Readonly<IrClassDeclaration>,
+): boolean {
+  if (property.type.kind !== 'function') return true;
+  if (property.type.typeParameters.length > 0) return false;
+  if (property.type.parameters.some((parameter) => parameter.optional || parameter.rest)) return false;
+  const method = declaration.methods.find((candidate) => candidate.name === property.name);
+  if (!method) return false;
+  if (method.static || method.async || method.abstract || method.accessor !== undefined) return false;
+  return method.parameters.every((parameter) => parameter.initializer === undefined);
+}
+
+// Binds each inherited interface method member to the class method of the same name. The member is
+// named through the base type because the class method hides it for unqualified lookup; the capture is
+// the object itself, and the thunk dies with the member it lives in, so it never outlives the owner.
+function emitCppInterfaceMethodThunkInitializersCpp(
+  heritage: Readonly<{ declaration: Readonly<IrInterfaceDeclaration>; typeName: string }>,
+  declaration: Readonly<IrClassDeclaration>,
+  context: EmitContext,
+): string[] {
+  const interfaceType = heritage.typeName;
+  const lines: string[] = [];
+  for (const property of heritage.declaration.properties) {
+    if (property.type.kind !== 'function') continue;
+    const method = declaration.methods.find((candidate) => candidate.name === property.name);
+    if (!method) continue;
+    const forward = property.type.parameters.map((parameter, index) => ({
+      name: safeCppName(parameter.name === '' ? `argument_${index}` : parameter.name),
+      type: emitType(parameter.type, context),
+    }));
+    const parameters = forward.map((parameter) => `${parameter.type} ${parameter.name}`);
+    const call = `this->${safeCppName(method.name)}(${forward.map((parameter) => parameter.name).join(', ')})`;
+    const returnsVoid = emitType(property.type.returns, context) === 'void';
+    const body = returnsVoid ? `${call};` : `return ${call};`;
+    lines.push(
+      `    ${interfaceType}::${safeCppName(property.name)} = [this](${parameters.join(', ')}) { ${body} };`,
+    );
+  }
+  return lines;
+}
