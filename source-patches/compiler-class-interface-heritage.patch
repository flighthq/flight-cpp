@@ -0,0 +1,93 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import type { CppCompilerBackendOptions } from '../../compiler-types/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+type Adoption = NonNullable<CppCompilerBackendOptions['classInterfaceAdoptions']>[number];
+
+function adoption(interfaceName: string, className: string): Adoption {
+  return { class: className, derive: true, interface: interfaceName, parameters: [] };
+}
+
+function emit(source: string, adoptions: readonly Adoption[] = []): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/classInterfaceHeritage.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp', classInterfaceAdoptions: adoptions }).contents;
+}
+
+const paired = `
+  interface R { pos: number; label: string; read(): number; advance(amount: number): void }
+  class C {
+    pos = 3;
+    label: string;
+    constructor(label: string) { this.label = label; }
+    read(): number { this.pos += 1; return this.pos; }
+    advance(amount: number): void { this.pos += amount; }
+  }
+`;
+
+it('emits the declared interface as the class native base', () => {
+  const output = emit(paired, [adoption('R', 'C')]);
+  expect(output).toContain('struct C : public flighthq_example::R {');
+  expect(output).not.toContain('struct C : public flight::ReferenceEnabled {');
+});
+
+it('shares the interface data members instead of declaring a second cell', () => {
+  const output = emit(paired, [adoption('R', 'C')]);
+  const start = output.indexOf('struct C : public flighthq_example::R {');
+  const classBody = output.slice(start, output.indexOf('\n};', start));
+  expect(classBody).not.toContain('double pos;');
+  expect(classBody).not.toContain('flight::String label;');
+  expect(classBody).toContain('this->pos = 3.0;');
+  expect(classBody).toContain('this->label = label)');
+});
+
+it('forwards each interface method member to the class method of the same name', () => {
+  const output = emit(paired, [adoption('R', 'C')]);
+  expect(output).toContain('flighthq_example::R::read = [this]() { return this->read(); };');
+  expect(output).toContain('flighthq_example::R::advance = [this](double amount) { this->advance(amount); };');
+});
+
+it('leaves an undeclared class exactly as it was', () => {
+  const output = emit(paired);
+  expect(output).toContain('struct C : public flight::ReferenceEnabled {');
+  expect(output).not.toContain('::R::read =');
+});
+
+it('does not adopt when the class declares a base of its own', () => {
+  const output = emit(
+    `
+      interface R { pos: number; read(): number }
+      class Base { pos = 0; }
+      class C extends Base { read(): number { this.pos += 1; return this.pos; } }
+    `,
+    [adoption('R', 'C')],
+  );
+  expect(output).toContain('struct C : public Base {');
+  expect(output).not.toContain('::R::read =');
+});
+
+it('does not adopt an interface member the class cannot forward', () => {
+  // TypeScript's structural check accepts a method with fewer parameters, but the emitted interface
+  // member has storage of its own signature, so there is no thunk that would forward it faithfully.
+  const output = emit(
+    `
+      interface R { pos: number; read(marker: number): number }
+      class C { pos = 0; read(): number { return 1; } }
+    `,
+    [adoption('R', 'C')],
+  );
+  expect(output).toContain('struct C : public flight::ReferenceEnabled {');
+  expect(output).not.toContain('::R::read =');
+});
