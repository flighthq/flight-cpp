+  const memberType = getIrObjectPropertyTypeCpp(targetType, expression.name, context);
+  if (!memberType) return undefined;
+  const memberStorage = emitType(memberType, context);
+  const absent = hasIrTypeAbsentMember(memberType)
+    ? `${memberStorage}{}`
+    : isCppExternalHostHandleTypeCpp(memberType, context)
+      ? (context.includes.add('flight/host_handle_absence.hpp'), `flight::absent_host_handle<${memberStorage}>()`)
+      : undefined;
