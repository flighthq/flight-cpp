+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// `(target as WgpuTextureRenderTarget).view` reads a member of an object asserted from a native interface
+// base to a derived owner. TypeScript checks nothing at runtime, and JavaScript reads the member of
+// whatever object it has. The lowering reads it that way, evaluating the receiver once: the SAME live owner
+// when the allocation is the derived type or a subclass (flight::recover_owner); otherwise the member cell
+// of another owner that declares it (flight::StructuralMemberView); otherwise the member's absence. A
+// missing member is never thrown at the read. It is the member's own absent state, or, for a declared
+// opaque host-handle absence carrier, the empty handle. A member type with no absent state refuses, and a
+// bare value assertion keeps its existing refusal.
+const declarations = `export interface Target { context: NativeContext | null; width: number }
+export interface Texture extends Target { readonly context: null; view: NativeView; level: number; label?: string }
+export interface CustomTexture extends Texture { extra: number }
+`;
+
+const handle = (sourceName: string, targetName: string) => ({
+  headers: ['host/view.hpp'],
+  nullability: 'non-null' as const,
+  ownership: 'shared' as const,
+  sourceName,
+  space: 'type' as const,
+  targetName,
+});
+const bindings = {
+  bindings: [handle('NativeView', 'host::View'), handle('NativeContext', 'host::Context')],
+  schema: 'flight-cpp-external-bindings/1' as const,
+};
+
+function emit(body: string) {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/read.ts', declarations + body, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { externalBindings: bindings, runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function refusal(body: string) {
+  try {
+    emit(body);
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error.rule;
+    throw error;
+  }
+  return undefined;
+}
+
+describe('a member read through a base-to-derived interface assertion', () => {
+  it('recovers the same owner, then reads a structural member, then reports the handle as absent', () => {
+    const contents = emit('export function f(t: Target): NativeView { return (t as Texture).view; }');
+    expect(contents).toContain('struct Texture : public Target {\n  using flight_native_base = Target;');
+    expect(contents).toContain(
+      'return ([&]() -> host::View { const auto asserted_receiver = t; if (const auto recovered_owner = flight::recover_owner<Texture>(asserted_receiver)) return recovered_owner->view; if (const auto structural_member = flight::StructuralMemberView<Target>(asserted_receiver).template read<host::View>("view"); structural_member.has_value()) return static_cast<const host::View&>(structural_member); return flight::absent_host_handle<host::View>(); }());',
+    );
+    expect(contents).toContain('#include <flight/host_handle_absence.hpp>');
+    expect(contents).not.toMatch(/static_pointer_cast|dynamic_pointer_cast|reinterpret_cast/u);
+  });
+
+  it('evaluates the receiver expression exactly once', () => {
+    const contents = emit('export function f(get: () => Target): NativeView { return (get() as Texture).view; }');
+    expect(contents.match(/get\(\)/gu)).toHaveLength(1);
+    expect(contents).toContain('const auto asserted_receiver = get();');
+  });
+
+  it('reports an optional member as its own absence', () => {
+    expect(emit('export function f(t: Target): string | undefined { return (t as Texture).label; }')).toContain(
+      'return std::optional<flight::String>{}; }());',
+    );
+  });
+
+  it('refuses a member whose type has no absent state', () => {
+    expect(refusal('export function f(t: Target): number { return (t as Texture).level; }')).toBe(
+      'cpp-checked-derived-member-absence-unrepresented',
+    );
+  });
+
+  it('keeps a bare value assertion refused', () => {
+    expect(refusal('export function f(t: Target): Texture { return t as Texture; }')).toBe(
+      'cpp-reference-assertion-without-heritage',
+    );
+  });
+
+  it('writes a grandchild literal into the base cell its parent refines', () => {
+    const contents = emit('export function f(view: NativeView): CustomTexture { return { context: null, width: 1, view, level: 2, extra: 3 }; }');
+    expect(contents).toContain('auto object_member_context = std::nullopt;');
+    expect(contents).not.toContain('object_member_context = flight::null');
+  });
+});
