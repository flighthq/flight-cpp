+//      handle; anything else has no representation and refuses.
+// No pointer cast is made and no early check is added: a missing member is reported, never thrown at the
+// read. Only the member-read form is lowered; a bare value assertion keeps its refusal.
+function emitCppCheckedDerivedMemberReadCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'property' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (getCppRuntimeProfile(context.options) !== 'flight-cpp' || expression.optional) return undefined;
