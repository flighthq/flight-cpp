diff --git a/packages/compiler-backend-cpp/src/cppPrivateRecordForwardedReads.test.ts b/packages/compiler-backend-cpp/src/cppPrivateRecordForwardedReads.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppPrivateRecordForwardedReads.test.ts
@@ -0,0 +1,61 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const file = ts.createSourceFile('/flight/packages/example/src/forwardedRecord.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(file, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+function attempt(source: string): string | undefined {
+  try { return emit(source); }
+  catch (error) {
+    if (typeof error !== 'object' || error === null || !('kind' in error) || error.kind !== 'backend-emission') throw error;
+    return undefined;
+  }
+}
+
+const prefix = 'type R=Record<string,unknown>;function leaf(row:R):unknown{return row.x;}';
+const source = prefix + 'function middle(row:R):unknown{return leaf(row);}export function run(row:R):unknown{return middle(row);}';
+
+it('forwards through an established private reader while retaining the public Record ABI', () => {
+  const output = emit(source);
+  expect(output).toContain('leaf(flight::NamedProperties row)');
+  expect(output).toContain('middle(flight::NamedProperties row)');
+  expect(output).toContain('run(R row)');
+  expect(output).toContain('middle(flight::named_properties(row))');
+});
+it('grows the proof from a real reader through two private forwarding calls', () => {
+  const output = emit(prefix + 'function middle(row:R):unknown{return leaf(row);}function outer(row:R):unknown{return middle(row);}export function run(row:R):unknown{return outer(row);}');
+  expect(output).toContain('outer(flight::NamedProperties row)');
+});
+it('keeps one original guarded JSON owner through the private forwarding graph', () => {
+  const output = emit(prefix + `function middle(row:R):unknown{return leaf(row);}
+function parse(text:string):R{let raw:unknown;try{raw=JSON.parse(text);}catch(e){throw new Error((e as Error).message);}if(raw===null||typeof raw!=='object'||Array.isArray(raw))throw new Error('object');return raw as R;}
+export function run(text:string):unknown{return middle(parse(text));}`);
+  expect(output).toContain('flight::NamedProperties parse(');
+  expect(output).toContain('return flight::named_properties(raw)');
+  expect(output).toContain('catch (const flight::JsonSyntaxError&');
+});
+
+const excluded: readonly (readonly [string, string])[] = [
+  ['returned owner', 'type R=Record<string,unknown>;function leaf(row:R):R{return row;}function middle(row:R):R{return leaf(row);}export function run(row:R):R{return middle(row);}'],
+  ['mutation', source.replace('return row.x;', 'row.x=1;return row.x;')],
+  ['comparison', source.replace('return row.x;', 'return row===row;')],
+  ['alias', source.replace('return row.x;', 'const alias=row;return alias.x;')],
+  ['escaped closure', source.replace('return row.x;', 'return ()=>row.x;')],
+  ['callback exposure', source + 'export function callback():(row:R)=>unknown{return leaf;}'],
+  ['exported callee', source.replace('function leaf', 'export function leaf')],
+  ['exported forwarding helper', source.replace('function middle', 'export function middle')],
+  ['external forwarding', source.replace('return leaf(row);', 'return external(row);') + 'export function external(row:R):unknown{return row.x;}'],
+  ['stored callback', source.replace('return leaf(row);', 'sink(leaf);return leaf(row);') + 'function sink(fn:(row:R)=>unknown):void{}'],
+  ['optional parameter', source.replace('middle(row:R)', 'middle(row?:R)').replace('return leaf(row);', 'return row?leaf(row):undefined;')],
+  ['defaulted parameter', source.replace('middle(row:R)', 'middle(row:R={})')],
+  ['unestablished recursion', 'type R=Record<string,unknown>;function first(row:R):unknown{return second(row);}function second(row:R):unknown{return first(row);}export function run(row:R):unknown{return first(row);}'],
+];
+it.each(excluded)('does not select an unsafe or unestablished forwarding parameter: %s', (_name, input) => {
+  const output = attempt(input);
+  if (output) expect(output).not.toContain((_name === 'unestablished recursion' ? 'first' : 'middle') + '(flight::NamedProperties row)');
+});
