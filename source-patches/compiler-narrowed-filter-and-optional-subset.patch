+export interface Clip { samples:number[] }
+export interface Left { kind:0; left:number }
+export interface Right { kind:1; right:number }
+export interface Other { kind:2; other:number }
+export type Pair=Left|Right;
+export type Full=Pair|Other;
+function isOther(value:Readonly<Full>):value is Readonly<Other>{return value.kind===2;}
+export function selectPair(value:Readonly<Full>|undefined):Readonly<Pair>|null{
+ if(value===undefined)return null;
+ if(isOther(value))return null;
+ return value;
+}
+export function select(input:(Clip|null)[]):Clip[]{
+ return input.filter((clip):clip is Clip=>clip!==null&&clip.samples.length>0);
+}
+export function read(input:(Clip|null)[]):number[]{
+ const active=input.filter((clip):clip is Clip=>clip!==null&&clip.samples.length>0);
+ return active.map(clip=>clip.samples[0]);
+}
+export function defined(input:(Clip|undefined)[]):Clip[]{
+ return input.filter((clip):clip is Clip=>clip!==undefined);
+}
+`;
