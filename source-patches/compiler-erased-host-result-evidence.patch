diff --git a/packages/compiler-backend-cpp/src/cppErasedHostResultEvidence.test.ts b/packages/compiler-backend-cpp/src/cppErasedHostResultEvidence.test.ts
new file mode 100644
index 0000000..df45b2c
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppErasedHostResultEvidence.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest';
+
+import ts from 'typescript';
+
+import { isBackendEmissionFailure } from '../../compiler-emission/src/index.js';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+// The lowering's program does not resolve external host types (WebGPU), so the checker erases every result
+// that names one to `any`. Three bounded sources of evidence answer for such a result, and only for an
+// erased one -- a type the checker recorded is never replaced:
+//   - an optional call `receiver.callback?.(...)` takes the member's DECLARED callable return;
+//   - a call on an external host receiver takes the binding profile's declared `callResultType`, read back
+//     as the one source type the same profile binds to it;
+//   - a local the checker types `T | any` is stored as its initializer's evidence when that is complete.
+const declarations = `export interface Screen {
+  context: Ctx;
+  presentationView: View | null;
+  acquireCaptureTexture: ((target: Screen) => Tex) | null;
+}
+`;
+const handle = (sourceName: string, targetName: string, members: readonly (readonly [string, string, string?])[] = []) => ({
+  headers: ['host/view.hpp'],
+  ...(members.length > 0
+    ? {
+        members: members.map(([sourceMember, target, result]) => ({
+          parameters: [],
+          sourceMember,
+          targetName: target,
+          ...(result ? { callResultType: result } : {}),
+        })),
+      }
+    : {}),
+  nullability: 'non-null' as const,
+  ownership: 'shared' as const,
+  sourceName,
+  space: 'type' as const,
+  targetName,
+});
+const bindings = (withResults: boolean) => ({
+  bindings: [
+    handle('Ctx', 'host::Ctx', [['getCurrentTexture', 'get_current_texture', withResults ? 'host::Tex' : undefined]]),
+    handle('View', 'host::View'),
+    handle('Tex', 'host::Tex', [['createView', 'create_view', withResults ? 'host::View' : undefined]]),
+  ],
+  schema: 'flight-cpp-external-bindings/1' as const,
+});
+
+function emit(body: string, withResults = true): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/math/src/erased.ts', declarations + body, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { externalBindings: bindings(withResults), runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function refusal(body: string, withResults = true): string | undefined {
+  try {
+    emit(body, withResults);
+  } catch (error) {
+    if (isBackendEmissionFailure(error)) return error.rule;
+    throw error;
+  }
+  return undefined;
+}
+
+describe('evidence for results the checker erased', () => {
+  it('types an erased optional call by the member declared callable return', () => {
+    const contents = emit('export function f(t: Screen): Tex | undefined { return t.acquireCaptureTexture?.(t); }');
+    expect(contents).toContain('([&]() -> std::optional<host::Tex> { auto optional_chain_receiver = t->acquire_capture_texture;');
+    expect(contents).not.toContain('std::optional<flight::Any>');
+  });
+
+  it('types an erased host call by the binding declared call result', () => {
+    const contents = emit('export function f(t: Screen): void { t.presentationView = t.context.getCurrentTexture().createView(); }');
+    expect(contents).toContain('(t->presentation_view = std::optional<host::View>{t->context.get_current_texture().create_view()});');
+  });
+
+  it('keeps an erased host call unproven when the profile declares no result', () => {
+    expect(refusal('export function f(t: Screen): void { t.presentationView = t.context.getCurrentTexture().createView(); }', false)).toBe(
+      'cpp-contextual-union-missing-expression-type:optionalSingle',
+    );
+  });
+
+  it('stores a local typed with an erased arm as its complete initializer evidence', () => {
+    const contents = emit(
+      'export function f(t: Screen): void { const texture = t.acquireCaptureTexture?.(t) ?? t.context.getCurrentTexture(); t.presentationView = texture.createView(); }',
+    );
+    expect(contents).toContain('auto texture = ');
+    expect(contents).toContain('(t->presentation_view = std::optional<host::View>{texture.create_view()});');
+  });
+
+  it('never replaces a result the checker recorded', () => {
+    const contents = emit(
+      'export interface Counter { next: ((step: number) => number) | null }\nexport function f(c: Counter): number | undefined { return c.next?.(1); }',
+    );
+    expect(contents).toContain('-> std::optional<double>');
+  });
+});
