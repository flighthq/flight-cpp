+    !source ||
+    source.kind !== 'named' ||
+    source.reference.kind !== 'binding' ||
+    source.reference.binding.kind !== 'import'
+  ) {
+    return false;
+  }
+  const alias = resolveCppTypeAliasTarget(source, context);
+  if (!alias || !isCppImportedUnionAliasAbiCarrierCpp(source, alias, context)) return false;
