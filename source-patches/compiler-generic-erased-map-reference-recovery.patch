+    expect(emitted).toContain('flight::erased_ref_as<Base>');
+    if (cppSyntaxGate.available) {
+      const syntax = cppSyntaxGate.checkCppSourceSyntax(emitted, 'generic-erased-reference-cache');
+      expect(syntax.diagnostic).toBe('');
+      expect(syntax.ok).toBe(true);
+    }
+  });
