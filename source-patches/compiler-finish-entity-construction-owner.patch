+// `finishEntity<Type>(out: EntityConstruction<Type>): Type` finishes the construction's OWN owner.
+// A call written without a type argument must specialize from the ARGUMENT, never from the expected
+// return type: a factory that declares a public base as its return would otherwise instantiate the
+// finish with that base, ask the row to be a schema whose object differs from the recorded owner, and
+// the exact-owner recovery rejects it. Specializing from the argument keeps the same allocation and
+// lets the returned reference widen along the emitted C++ heritage.
+function getCppEntityConstructionCallTypeArgumentsCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'call' }>>,
+  context: EmitContext,
+): readonly Readonly<IrType>[] | undefined {
+  if (expression.typeArguments.length > 0) return undefined;
+  const callee = expression.callee;
+  if (callee.kind !== 'identifier') return undefined;
+  const name =
+    callee.reference.kind === 'ambient'
+      ? callee.reference.name
+      : callee.reference.kind === 'binding'
+        ? callee.reference.binding.name
+        : undefined;
+  if (name !== 'finishEntity') return undefined;
+  const argument = expression.arguments[0];
+  if (argument === undefined || argument.kind === 'spread') return undefined;
+  const argumentType = getIrExpressionTypeEvidenceCpp(argument, context);
+  if (argumentType === undefined) return undefined;
+  const row = context.referenceRepresentationPlanner.resolveStructuralRow(argumentType, context.module);
+  const subject = row ? getCppStructuralRowObjectTypeCpp(row) : undefined;
+  if (subject === undefined) return undefined;
+  const present = getCppNonNullableType(subject, context, new Set()) ?? subject;
+  return hasFlightReferenceRepresentationCpp(present, context) ? [subject] : undefined;
+}
+
 function emitCppTypeArguments(types: readonly Readonly<IrType>[], context: EmitContext): string {
   return types.length === 0 ? '' : `<${types.map((type) => emitCppTypeArgumentCpp(type, context)).join(', ')}>`;
 }
