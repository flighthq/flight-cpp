@@ -0,0 +1,124 @@
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile(
+    '/flight/packages/example/src/membershipTest.ts',
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const result = lowerTypeScriptSource(sourceFile, {
+    packageName: '@flighthq/example',
+    upstreamDirectory: '/flight',
+  });
+  expect(result.diagnostics).toEqual([]);
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+function refusal(source: string): string {
+  try {
+    emit(source);
+  } catch (error) {
+    return String(error);
+  }
+  throw new Error('expected the membership test to be refused');
+}
+
+it('asks a Record for an own entry and, for a key known only at run time, the inherited prototype names', () => {
+  const output = emit(`
+    export function hasLiteral(dict: Record<string, number>): boolean { return 'x' in dict; }
+    export function hasKey(dict: Record<string, number>, key: string): boolean { return key in dict; }
+    export function hasInherited(dict: Record<string, number>): boolean { return 'toString' in dict; }
+  `);
+
+  expect(output).toContain('return dict.has(flight::String("x"));');
+  expect(output).toContain(
+    'const auto membership_key = key; const auto& membership_receiver = dict; return membership_receiver.has(membership_key) || flight::is_object_prototype_property(membership_key);',
+  );
+  expect(output).toContain('return (static_cast<void>(dict), true);');
+  expect(output).not.toMatch(/ in dict/);
+});
+
+it('asks a structural row owner for the cell when every type that can reach it declares the key required', () => {
+  const output = emit(`
+    export interface Node2 { kind: string }
+    export interface Mesh2 extends Node2 { materials: number[] }
+    export function hasMaterials(node: Readonly<Node2>): boolean { return 'materials' in node; }
+  `);
+
+  expect(output).toContain('return flight::row_has<flight::RowKey<"materials">>(node);');
+});
+
+it('answers a key the receiver declares required without reading its value', () => {
+  const output = emit(`
+    export interface State { id: number | undefined }
+    export function hasId(state: State): boolean { return 'id' in state; }
+  `);
+
+  expect(output).toContain('return (static_cast<void>(state), true);');
+});
+
+it('refuses an optional key, an assignable optional declarer, a nominal receiver, and an erased view', () => {
+  expect(
+    refusal(`
+      export interface Node3 { kind: string; extra?: number }
+      export function hasExtra(node: Node3): boolean { return 'extra' in node; }
+    `),
+  ).toContain('declares optional: absent and present-undefined are both admitted');
+  expect(
+    refusal(`
+      export interface Node4 { kind: string }
+      export interface Mesh4 extends Node4 { materials?: number[] }
+      export function hasMaterials(node: Readonly<Node4>): boolean { return 'materials' in node; }
+    `),
+  ).toContain('a type assignable to the receiver declares optional');
+  expect(
+    refusal(`
+      export interface RenderState { id: number }
+      export function hasDevice(state: RenderState): boolean { return 'device' in state; }
+    `),
+  ).toContain('cannot hold a value that declares it');
+  expect(
+    refusal(`
+      export interface Adapter { cache: number; adapt: () => void }
+      export function isAdapter(value: unknown): boolean {
+        return typeof value === 'object' && value !== null && 'cache' in (value as Adapter);
+      }
+    `),
+  ).toContain('declared by an ASSERTED receiver type');
+  expect(
+    refusal(`
+      export function hasRotate(raw: unknown): boolean {
+        if (raw === null || typeof raw !== 'object') return false;
+        const transform = raw as Record<string, unknown>;
+        return 'rotate' in transform;
+      }
+    `),
+  ).toContain('flight::NamedProperties::has answers own keys only');
+});
+
+it('keeps the closed-union arm test for a key exactly one arm declares', () => {
+  const output = emit(`
+    export interface A { worldMatrix: number | null; name: string }
+    export interface B { name: string }
+    export function hasWorldMatrix(value: A | B): boolean { return 'worldMatrix' in value; }
+  `);
+
+  expect(output).toContain('std::variant<flight::Ref<B>, flight::Ref<A>> value');
+  expect(output).toMatch(/return \(?value\.index\(\) == 1\)?;|holds_alternative<flight::Ref<A>>\(value\)/);
+});
+
+it('leaves a symbol key on a closed variant receiver to the existing lowering', () => {
+  const output = emit(`
+    export const RuntimeKey: unique symbol = Symbol('runtime');
+    export interface Entity { [RuntimeKey]: number | undefined; name: string }
+    export interface Runtime { name: string }
+    export function hasRuntimeKey(value: Entity | Runtime): boolean { return RuntimeKey in value; }
+  `);
+
+  expect(output).not.toContain('cpp-membership-test-unrepresented');
+});
