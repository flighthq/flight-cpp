+// `typeof setInterval` or `typeof setTimeout` naming the ambient host function -- a library declaration
+// or a `declare`d one -- rather than a local binding that happens to share the name.
+function isTypeScriptAmbientHostTimerQuery(argument: ts.TypeNode, context: LoweringContext): boolean {
+  if (!ts.isTypeQueryNode(argument) || !ts.isIdentifier(argument.exprName)) return false;
+  const name = argument.exprName.text;
+  if (name !== 'setInterval' && name !== 'setTimeout') return false;
+  const declarations = context.checker.getSymbolAtLocation(argument.exprName)?.declarations ?? [];
+  return (
+    declarations.length > 0 &&
+    declarations.every(
+      (declaration) =>
+        declaration.getSourceFile().isDeclarationFile ||
+        (ts.getCombinedModifierFlags(declaration) & ts.ModifierFlags.Ambient) !== 0,
+    )
+  );
+}
