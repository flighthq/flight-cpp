+// A forwarded pack element is moved when it is an rvalue, so forwarding is right only at the pack's one
+// use. JavaScript hands the same argument values to every call that spreads the rest parameter, so a pack
+// spread twice, or once inside a loop (whose body, condition and increment all repeat), must reach each
+// call as lvalues: a later call would otherwise receive moved-from values. Pack bindings are unique to
+// their declaring function, so counting spreads module-wide counts them within that function.
+function collectIrModuleReusedDependentCallablePackIdsCpp(module: Readonly<IrModule>): ReadonlySet<string> {
+  const packIds = new Set(collectIrModuleDependentCallablePacksCpp(module).keys());
+  const loopPaths: (readonly (number | string)[])[] = [];
+  const spreadPaths = new Map<string, (readonly (number | string)[])[]>();
+  analyzeIrModuleTraversal(module, {
+    statement(statement, path) {
+      if (
+        statement.kind === 'for' ||
+        statement.kind === 'forOf' ||
+        statement.kind === 'forIn' ||
+        statement.kind === 'while' ||
+        statement.kind === 'do'
+      ) {
+        loopPaths.push(path);
+      }
+    },
+    expression(expression, path) {
+      if (
+        expression.kind === 'spread' &&
+        expression.expression.kind === 'identifier' &&
+        expression.expression.reference.kind === 'binding' &&
+        packIds.has(expression.expression.reference.binding.id)
+      ) {
+        const id = expression.expression.reference.binding.id;
+        spreadPaths.set(id, [...(spreadPaths.get(id) ?? []), path]);
+      }
+    },
+  });
+  const within = (path: readonly (number | string)[], prefix: readonly (number | string)[]): boolean =>
+    prefix.length < path.length && prefix.every((segment, index) => path[index] === segment);
+  const reused = new Set<string>();
+  for (const [id, paths] of spreadPaths) {
+    if (paths.length > 1 || paths.some((path) => loopPaths.some((loop) => within(path, loop)))) reused.add(id);
+  }
+  return reused;
+}
