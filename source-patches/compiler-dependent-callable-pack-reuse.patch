index 0000000..afbb4d7
--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppDependentCallablePackReuse.test.ts
@@ -0,0 +1,50 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const callable = 'T extends (...args: any[]) => void';
+const forwarded = 'std::forward<ArgsPack>(args)...';
+
+// A forwarded rvalue is moved, so only a rest parameter's single use may forward it. JavaScript passes the
+// same argument values to every call that spreads the parameter.
+describe('spreading a dependent callable rest parameter', () => {
+  it('forwards a single use', () => {
+    const contents = emit(`export function once<${callable}>(a: T, ...args: Parameters<T>): void { a(...args); }`);
+    expect(contents).toContain(`a(${forwarded});`);
+  });
+
+  it('forwards a single use inside a branch, which runs at most once', () => {
+    const contents = emit(
+      `export function maybe<${callable}>(a: T, go: boolean, ...args: Parameters<T>): void { if (go) a(...args); }`,
+    );
+    expect(contents).toContain(`a(${forwarded});`);
+  });
+
+  it('passes lvalues to every call when the pack is spread twice', () => {
+    const contents = emit(
+      `export function twice<${callable}>(a: T, b: T, ...args: Parameters<T>): void { a(...args); b(...args); }`,
+    );
+    expect(contents).toContain('a(args...);');
+    expect(contents).toContain('b(args...);');
+    expect(contents).not.toContain(forwarded);
+  });
+
+  it.each([
+    ['for', 'for (let i = 0; i < slots.length; i++) slots[i](...args);'],
+    ['while', 'let i = 0; while (i < slots.length) { slots[i](...args); i++; }'],
+    ['do', 'let i = 0; do { slots[i](...args); i++; } while (i < slots.length);'],
+    ['for-of', 'for (const slot of slots) slot(...args);'],
+  ])('passes lvalues to a single spread inside a %s loop', (_, body) => {
+    const contents = emit(`export function all<${callable}>(slots: T[], ...args: Parameters<T>): void { ${body} }`);
+    expect(contents).toContain('(args...);');
+    expect(contents).not.toContain(forwarded);
+  });
+});
