--- /dev/null
+++ b/packages/compiler-backend-cpp/src/cppDependentIndexedAccess.test.ts
@@ -0,0 +1,44 @@
+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/x/src/x.ts', source, ts.ScriptTarget.Latest, true);
+  const result = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/x', upstreamDirectory: '/flight' });
+  return emitIrModuleCpp(result.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+describe("a dependent T['key'] is read through the type argument's carrier", () => {
+  it("spells @flighthq/tray invokeRead's failure parameter so a union result instantiates", () => {
+    const emitted = emit(`export type U = { readonly outcome: 'updated' } | { readonly error?: unknown; readonly outcome: 'image-update-failed' };
+      export function f<Result extends { readonly outcome: string }>(failure: Result['outcome']): Result['outcome'] { return failure; }
+      export function useU(): string { return f<U>('image-update-failed'); }`);
+    expect(emitted).toContain(
+      'inline flight::indexed_member_t<Result, flight::RowKey<"outcome">> f(flight::indexed_member_t<Result, flight::RowKey<"outcome">> failure) {',
+    );
+    expect(emitted).toContain('#include <flight/structural_ref.hpp>');
+    expect(emitted).not.toContain('std::declval<Result&>()');
+  });
+
+  it("spells @flighthq/materials getMaterialOfKind's kind parameter the same way", () => {
+    const emitted = emit(`export interface Material { kind: string; name: string | null }
+      export function getMaterialOfKind<T extends Material>(material: Readonly<Material> | null, kind: T['kind']): boolean {
+        return material !== null && material.kind === kind;
+      }`);
+    expect(emitted).toContain('flight::indexed_member_t<T, flight::RowKey<"kind">> kind');
+  });
+
+  it('keys the trait by the source member name, which the generated table maps to the C++ member', () => {
+    const emitted = emit(`export function f<Result extends { readonly failureReason: string }>(reason: Result['failureReason']): void {}`);
+    expect(emitted).toContain('flight::indexed_member_t<Result, flight::RowKey<"failureReason">> reason');
+  });
+
+  it('still refuses a key a constraint branch does not carry', () => {
+    expect(() =>
+      emit(`interface Plain { dimension: '2d' } interface Depth { depth: number }
+        export type Narrowed<Type extends Plain | Depth> = Type['dimension'];`),
+    ).toThrow(/is not a member of every inhabited constraint branch/);
+  });
+});
