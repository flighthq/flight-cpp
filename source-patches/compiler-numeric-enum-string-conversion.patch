+      true,
+    ),
+    upstreamDirectory: '/flight',
+  });
+  const moduleResolution: CompilerModuleResolutionPlan = {
+    edges: [
+      {
+        specifier: '@flighthq/enum-owner/contract',
+        target: { packageName: provider, source: 'packages/enum-owner/src/contract.ts' },
+      },
+      { specifier: './values', target: { packageName: provider, source: 'packages/enum-owner/src/values.ts' } },
+    ],
+    schema: 'flight-compiler-module-resolution/1',
+  };
+  const results = lowerTypeScriptSources(
+    imported
+      ? [
+          source(provider, 'values', declarations),
+          source(provider, 'contract', "export * from './values';"),
+          source(
+            consumer,
