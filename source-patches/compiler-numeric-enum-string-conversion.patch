+const declarations =
+  "export enum Mode { Zero = 0, Negative = -3, Alias = -3, High = 1048577 }\nexport enum Label { NumericText = '0', Name = 'MaterialRenderer' }\nexport enum Decorated { Zero = 0, Flag = 2 }\nexport namespace Decorated { export function accepts(value: number): boolean { return value !== 0; } }\nexport enum Empty {}\nexport type Alias = Mode;\n";
