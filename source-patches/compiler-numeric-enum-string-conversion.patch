+#include <iostream>
+#include <limits>
+#include <memory>
+namespace n = enum_check;
+namespace t = ${imported ? 'enum_owner' : 'enum_check'};
+int main() {
+auto print = [](const flight::String& value) { std::cout << value.to_utf8() << '\\n'; };
+${cases.map((item) => `print(${item[0]});`).join('\n')}
+int reads = 0;
+print(n::evaluated([&] { ++reads; return t::Mode::Negative; }));
+print(flight::to_string(reads));
+auto marker = std::make_shared<int>(17); bool exact = false;
+try { n::evaluated([&]() -> t::Mode { throw marker; }); }
+catch (const std::shared_ptr<int>& caught) { exact = caught == marker && !caught.owner_before(marker) && !marker.owner_before(caught); }
