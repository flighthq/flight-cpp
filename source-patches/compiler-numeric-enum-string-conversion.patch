+
+function emitEnumStrings(imported: boolean) {
+  const provider = '@flighthq/enum-owner';
+  const consumer = '@flighthq/enum-check';
+  const source = (packageName: string, file: string, code: string) => ({
+    packageName,
+    sourceFile: ts.createSourceFile(
+      `/flight/packages/${packageName.slice('@flighthq/'.length)}/src/${file}.ts`,
