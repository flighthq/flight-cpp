+// Numeric enum values are numbers in JavaScript, including unnamed values and duplicate-valued
+// members. The declaration, rather than a C++ name or a reverse-map lookup, proves that conversion.
+function isCppNumericEnumStringTypeCpp(
+  type: Readonly<IrType> | undefined,
+  context: EmitContext,
+  visited: ReadonlySet<string> = new Set(),
+): boolean {
+  if (type?.kind !== 'named') return false;
+  const owner = getCppNamedTypeDeclarationOwnerCpp(type, getCppNamedTypeBindingModuleCpp(type, context), context);
+  if (owner?.declaration.kind === 'enum') {
+    return owner.declaration.members.every((member) => typeof member.value === 'number');
+  }
+  if (owner?.declaration.kind !== 'typeAlias') return false;
+  const key = `${getCppModuleIdentityKey(owner.module)}\0${owner.declaration.binding.id}`;
+  if (visited.has(key)) return false;
+  const target = resolveCppTypeAliasTarget(type, context);
+  return (
+    target !== undefined &&
+    isCppNumericEnumStringTypeCpp(target, { ...context, module: owner.module }, new Set(visited).add(key))
+  );
+}
+
+function emitCppExplicitStringValueConversionCpp(
+  value: string,
+  type: Readonly<IrType> | undefined,
+  context: EmitContext,
+): string {
+  return isCppNumericEnumStringTypeCpp(type, context)
+    ? `flight::to_string(static_cast<double>(${value}))`
+    : `flight::to_string(${value})`;
+}
