+import ts from 'typescript';
+import { describe, expect, it } from 'vitest';
+
+import { lowerTypeScriptSources } from '../../compiler-semantic/src/index.js';
+import type { CompilerModuleResolutionPlan } from '../../compiler-types/src/index.js';
+import { createCppCompilerBackend } from './cppCompilerBackend.js';
+
+function emitReadonlyReturn(code: string, imported = false): string {
+  const packageName = '@flighthq/readonly-return';
+  const ownerPackage = '@flighthq/readonly-owner';
+  const declarations = `export interface Host { value: number }
+    export interface Runtime { host?: Readonly<Host> }`;
+  const source = (owner: string, file: string, text: string) => ({
+    packageName: owner,
+    sourceFile: ts.createSourceFile(
+      `/flight/packages/${owner.slice('@flighthq/'.length)}/src/${file}.ts`,
+      text,
+      ts.ScriptTarget.Latest,
+      true,
+    ),
+    upstreamDirectory: '/flight',
+  });
+  const moduleResolution: CompilerModuleResolutionPlan = {
+    edges: [{
+      specifier: '@flighthq/readonly-owner/contract',
+      target: { packageName: ownerPackage, source: 'packages/readonly-owner/src/contract.ts' },
+    }],
+    schema: 'flight-compiler-module-resolution/1',
+  };
+  const results = lowerTypeScriptSources(
+    imported
+      ? [source(ownerPackage, 'contract', declarations), source(packageName, 'readonly',
+          `import type { Host, Runtime } from '@flighthq/readonly-owner/contract'; ${code}`)]
+      : [source(packageName, 'readonly', declarations + code)],
+    moduleResolution,
+  );
+  expect(results.flatMap((result) => result.diagnostics)).toEqual([]);
+  const modules = results.map((result) => result.module);
+  return createCppCompilerBackend().createEmissionSession!({
+    moduleResolution,
+    modules,
+    options: { runtimeProfile: 'flight-cpp' },
+  }).emitModule(modules[modules.length - 1]!)[0]!.contents;
+}
+
+describe('emitIrModuleCpp', () => {
+  it('returns the exact stored readonly view after a null or undefined guard', () => {
+    for (const sentinel of ['null', 'undefined']) {
+      for (const imported of [false, true]) {
+        const text = emitReadonlyReturn(`export function getHost(host: Readonly<Host> | ${sentinel}): Readonly<Host> {
+          if (host === ${sentinel}) throw new Error('missing');
+          return host;
+        }`, imported);
+        expect(text).toContain('return host.value();');
+        expect(text).not.toContain('RowWritable');
+        expect(text).toContain('throw flight::Error(flight::String("missing"));');
+      }
+    }
+  });
+
+  it('preserves the guarded property snapshot and one effectful source read', () => {
+    const text = emitReadonlyReturn(`export function getHost(runtime: Runtime): Readonly<Host> {
+      const host = runtime.host;
+      if (host === undefined) throw new Error('missing');
+      return host;
+    }
+    export function getEffects(read: () => Readonly<Host> | undefined): Readonly<Host> {
+      const host = read();
+      if (host === undefined) throw new Error('missing');
+      return host;
+    }`);
+    expect(text).toContain('host = runtime->host;');
+    expect(text.split('host = read();')).toHaveLength(2);
+    expect(text.split('return host.value();')).toHaveLength(3);
+    expect(text).not.toContain('RowWritable');
+  });
+
+  it('keeps an exact partial readonly schema without adding required cells', () => {
+    const text = emitReadonlyReturn(`export function getHost(host: Readonly<Partial<Host>> | undefined): Readonly<Partial<Host>> {
+      if (host === undefined) throw new Error('missing');
+      return host;
+    }`);
+    expect(text).toContain('RowReadonly<flight::RowPartial<');
+    expect(text).toContain('return host.value();');
+    expect(text).not.toContain('RowWritable');
+  });
+
+  it('does not project a returned optional whose absence is still reachable', () => {
+    const text = emitReadonlyReturn(`export function getHost(host: Readonly<Host> | undefined): Readonly<Host> | undefined {
+      return host;
+    }`);
+    expect(text).toContain('return host;');
+    expect(text).not.toContain('host.value()');
+  });
+});
