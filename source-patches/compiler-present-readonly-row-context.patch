+// Flow narrowing may name the nominal subject of Readonly<T> even though the binding keeps a
+// readonly row in its optional storage. A matching readonly context needs that exact stored view;
+// constructing a writable projection first would add authority the binding never held.
+function emitCppContextualPresentReadonlyRowCpp(
+  expression: Readonly<IrExpression>,
+  expectedType: Readonly<IrType>,
+  context: EmitContext,
+): string | undefined {
+  if (
+    expression.kind !== 'identifier' ||
+    expression.reference.kind !== 'binding' ||
+    expression.presence !== 'narrowedPresent'
+  ) {
+    return undefined;
+  }
+  const bindingType = getCppBindingTypeCpp(expression.reference.binding.id, context);
+  const union = bindingType ? getIrUnionTypeCpp(bindingType, context, new Set()) : undefined;
+  if (!union) return undefined;
+  const isolatedContext = { ...context, anonymousStructs: new Map(), includes: new Set<string>() };
+  const plan = getCppUnionRepresentationPlan(union, isolatedContext);
+  if (plan.kind !== 'optionalSingle' || plan.valueSlots.length !== 1) return undefined;
+  const slot = plan.valueSlots[0]!;
+  const sourceRow = context.referenceRepresentationPlanner.resolveStructuralRow(slot.runtimeType, context.module);
+  const targetRow = context.referenceRepresentationPlanner.resolveStructuralRow(expectedType, context.module);
+  if (
+    !sourceRow ||
+    !targetRow ||
+    !isCppStructuralRowSchemaReadonlyCpp(sourceRow) ||
+    !isCppStructuralRowSchemaReadonlyCpp(targetRow) ||
+    qualifyCppDeclaringModuleTypeCpp(slot.targetType, context) !==
+      qualifyCppDeclaringModuleTypeCpp(emitType(expectedType, isolatedContext), context)
+  ) {
+    return undefined;
+  }
+  return emitExpression(expression, context, undefined, false);
+}
