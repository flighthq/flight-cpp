@@ -0,0 +1,174 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  collectCppRuntimeIncludeDirectories,
+  createCppExecutableArguments,
+  findCppCompilerToolchain,
+  getCppExecutableName,
+} from '../../../scripts/cppToolchain.js';
+import { resolveDependency } from '../../../scripts/dependencyLock.js';
+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+const source = `
+export const EntityRuntimeKey = Symbol.for('EntityRuntime');
+export interface RenderRegistries { marker: number }
+export interface GlRenderRegistries extends RenderRegistries { glTag: number }
+export interface RenderStateRuntime { registries: RenderRegistries; frame: number }
+export interface GlRenderStateRuntime extends RenderStateRuntime { registries: GlRenderRegistries; glFrame: number }
+export interface RenderState { [EntityRuntimeKey]: RenderStateRuntime | undefined }
+export interface GlRenderState extends RenderState { [EntityRuntimeKey]: GlRenderStateRuntime | undefined }
+export function readTag(runtime: GlRenderStateRuntime): number { const regs = runtime.registries; return regs.glTag; }
+export function readFrame(state: GlRenderState): number { const runtime = state[EntityRuntimeKey]; if (runtime === undefined) return -1; return runtime.glFrame; }
+export function replaceRegistries(runtime: GlRenderStateRuntime, registries: GlRenderRegistries): void { runtime.registries = registries; }
+export function replaceRuntime(state: GlRenderState, runtime: GlRenderStateRuntime): void { state[EntityRuntimeKey] = runtime; }
+export function clearRuntime(state: GlRenderState): void { state[EntityRuntimeKey] = undefined; }
+export function baseReplaceRuntime(state: RenderState, runtime: RenderStateRuntime): void { state[EntityRuntimeKey] = runtime; }
+export function baseClearRuntime(state: RenderState): void { state[EntityRuntimeKey] = undefined; }
+export function baseReplaceRegistries(runtime: RenderStateRuntime, registries: RenderRegistries): void { runtime.registries = registries; }
+export function nestedTag(state: GlRenderState): number { const runtime = state[EntityRuntimeKey]; if (runtime === undefined) return -1; const registries = runtime.registries; return registries.glTag; }
+export function nestedReplace(state: GlRenderState, registries: GlRenderRegistries): void { const runtime = state[EntityRuntimeKey]; if (runtime !== undefined) runtime.registries = registries; }
+export function readonlyRuntime(state: Readonly<GlRenderState>): GlRenderStateRuntime { return state[EntityRuntimeKey]!; }
+export function nativeRuntime(state: GlRenderState): GlRenderStateRuntime { const runtime = state[EntityRuntimeKey]; if (runtime === undefined) throw new Error('missing'); return runtime; }
+export function nativeRegistries(runtime: GlRenderStateRuntime): GlRenderRegistries { return runtime.registries; }
+`;
+const carriers = [
+  {
+    nominal: 'GlRenderRegistries',
+    base: 'RenderRegistries',
+    target: 'flight::NominalOrStructuralView<GlRenderRegistries, RenderRegistries>',
+    cells: [{ baseOwner: 'RenderStateRuntime', owner: 'GlRenderStateRuntime', field: 'registries' }],
+  },
+  {
+    nominal: 'GlRenderStateRuntime',
+    base: 'RenderStateRuntime',
+    target: 'flight::NominalOrStructuralView<GlRenderStateRuntime, RenderStateRuntime>',
+    cells: [{ baseOwner: 'RenderState', owner: 'GlRenderState', field: 'EntityRuntimeKey' }],
+  },
+];
+function emit(options = carriers) {
+  const sf = ts.createSourceFile('/flight/packages/math/src/cells.ts', source, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sf, { packageName: '@flighthq/math', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { runtimeProfile: 'flight-cpp', structuralValueCarriers: options }).contents;
+}
+
+it('elects the same physical base cell at exactly the declared relations', () => {
+  const output = emit();
+  expect(output).toContain('struct GlRenderStateRuntime : public RenderStateRuntime {');
+  expect(output).toContain('struct GlRenderState : public RenderState {');
+  expect(output.match(/struct GlRenderStateRuntime : public RenderStateRuntime \{([\s\S]*?)\n\};/u)![1]).not.toMatch(
+    /registries\s*[;=]/u,
+  );
+  expect(output.match(/struct GlRenderState : public RenderState \{([\s\S]*?)\n\};/u)![1]).not.toMatch(
+    /entity_runtime_key\s*[;=]/u,
+  );
+  expect(output).toContain('::write_symbol_cell<&RenderState::entity_runtime_key>');
+  expect(output).toContain('.native()');
+});
+
+it('keeps undeclared refinements off native heritage', () => {
+  const output = emit([]);
+  expect(output).toContain('struct GlRenderStateRuntime : public flight::ReferenceEnabled {');
+  expect(output).toContain('struct GlRenderState : public flight::ReferenceEnabled {');
+});
+
+it('refuses a declared payload without the promised native base proof', () => {
+  expect(() => emit(carriers.map((c, i) => (i === 0 ? { ...c, base: 'OtherRegistries' } : c)))).toThrow(
+    /requires proven native payload heritage/u,
+  );
+});
+
+const repositoryRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const runtime = resolveDependency(repositoryRoot, 'flight-cpp');
+const includes = collectCppRuntimeIncludeDirectories(runtime.directory);
+const toolchain = findCppCompilerToolchain();
+
+it.skipIf(!toolchain || includes.length === 0)(
+  'runs complete emitted cell reads, writes, absence and partial native escapes',
+  () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'flight-shared-cells-'));
+    try {
+      writeFileSync(path.join(directory, 'cells-emitted.hpp'), emit());
+      const native = path.join(directory, 'native.cpp');
+      writeFileSync(native, NATIVE);
+      const executable = path.join(directory, getCppExecutableName(toolchain!, 'shared-cells'));
+      execFileSync(
+        toolchain!.command,
+        createCppExecutableArguments(toolchain!, native, executable, [directory, ...includes]),
+        { encoding: 'utf8', stdio: 'pipe' },
+      );
+      execFileSync(executable, [], { encoding: 'utf8' });
+    } finally {
+      rmSync(directory, { recursive: true, force: true });
+    }
+  },
+  120_000,
+);
+
+const NATIVE = `#include "cells-emitted.hpp"
+#include <cassert>
+#include <cmath>
+#include <type_traits>
+namespace n = flighthq_math;
+int main() {
+  static_assert(std::is_base_of_v<n::RenderStateRuntime, n::GlRenderStateRuntime>);
+  static_assert(std::is_base_of_v<n::RenderState, n::GlRenderState>);
+  static_assert(std::is_same_v<decltype(n::GlRenderState::entity_runtime_key), std::optional<flight::Ref<n::RenderStateRuntime>>>);
+  static_assert(std::is_same_v<decltype(n::GlRenderStateRuntime::registries), flight::Ref<n::RenderRegistries>>);
+  auto state = flight::make_ref<n::GlRenderState>();
+  flight::Ref<n::RenderState> base = state;
+  auto runtime = flight::make_ref<n::GlRenderStateRuntime>(); runtime->gl_frame = 17;
+  auto registry = flight::make_ref<n::GlRenderRegistries>(); registry->gl_tag = 23;
+  runtime->registries = registry;
+  n::replace_runtime(state, runtime);
+  assert(n::readonly_runtime(state) == runtime);
+  assert(n::read_frame(state) == 17 && n::native_runtime(state) == runtime);
+  assert(n::read_tag(runtime) == 23 && n::native_registries(runtime) == registry);
+  assert(&base->entity_runtime_key == &state->entity_runtime_key);
+  flight::Ref<n::RenderStateRuntime> runtime_base = runtime;
+  assert(&runtime_base->registries == &runtime->registries);
+  auto second = flight::make_ref<n::GlRenderRegistries>(); second->gl_tag = 29;
+  n::nested_replace(state, second);
+  assert(n::nested_tag(state) == 29);
+  assert(runtime_base->registries == second && n::read_tag(runtime) == 29);
+  n::base_replace_registries(runtime_base, registry);
+  assert(n::read_tag(runtime) == 23);
+  n::clear_runtime(state); assert(!base->entity_runtime_key && n::read_frame(state) == -1);
+  flight::StructuralRef<flight::RowOf<flight::Ref<n::RenderState>>> row{base};
+  assert(flight::row_has_own_property(row, n::entity_runtime_key));
+  auto fresh = flight::make_ref<n::GlRenderState>();
+  flight::StructuralRef<flight::RowOf<flight::Ref<n::RenderState>>> fresh_row{flight::Ref<n::RenderState>(fresh)};
+  assert(!flight::row_has_own_property(fresh_row, n::entity_runtime_key));
+  n::base_clear_runtime(fresh);
+  assert(flight::row_has_own_property(fresh_row, n::entity_runtime_key));
+  assert(!flight::row_has_own_property(row, flight::Symbol(flight::String("EntityRuntime"))));
+  assert(!row.shared_owner()->has_dynamic_value(n::entity_runtime_key));
+  n::base_replace_runtime(base, runtime); assert(n::read_frame(state) == 17);
+  auto wrong = flight::make_ref<n::RenderStateRuntime>();
+  n::base_replace_runtime(base, wrong);
+  assert(base->entity_runtime_key == wrong && std::isnan(n::read_frame(state)));
+  bool refused = false;
+  try { (void)n::native_runtime(state); } catch (const flight::NativeScalarEscapeError&) { refused = true; }
+  assert(refused);
+  auto wrong_registry = flight::make_ref<n::RenderRegistries>();
+  runtime_base->registries = wrong_registry;
+  assert(std::isnan(n::read_tag(runtime)));
+  refused = false;
+  try { (void)n::native_registries(runtime); } catch (const flight::NativeScalarEscapeError&) { refused = true; }
+  assert(refused);
+  {
+    auto retained = flight::make_ref<n::GlRenderStateRuntime>();
+    std::weak_ptr<n::GlRenderStateRuntime> weak = retained;
+    n::replace_runtime(state, retained); retained.reset();
+    auto view = flight::NominalOrStructuralView<n::GlRenderStateRuntime, n::RenderStateRuntime>::read_cell(state->entity_runtime_key);
+    n::base_clear_runtime(base); assert(!weak.expired());
+    view.reset(); assert(weak.expired());
+  }
+}
+`;
