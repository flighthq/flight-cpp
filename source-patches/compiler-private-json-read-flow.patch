+  ['extra parse', producer.replace('return raw as Raw;', 'raw = JSON.parse(text); return raw as Raw;') + reader],
+  ['mutation', producer.replace('return raw as Raw;', '(raw as Record<string, unknown>).n = 3; return raw as Raw;') + reader],
+  ['fallthrough catch', producer.replace("throw new Error('syntax');", '') + reader],
+  ['effectful parse input', producer.replace('text: string): Raw', 'text: () => string): Raw').replace('JSON.parse(text)', 'JSON.parse(text())') + reader.replace('run(text: string)', 'run(text: () => string)')],
+  ['guard side effect', producer.replace('|| Array.isArray(raw)', '|| Array.isArray(raw) || effect(raw)') + `function effect(raw: unknown): boolean { return false; }` + reader],
+] as const)('keeps the ordinary producer ABI for %s', (_name, source) => {
+  expect(emit(source)).not.toContain('flight::NamedProperties parse_raw(');
+});
+
+it.each([
