+import ts from 'typescript';
+import { expect, it } from 'vitest';
+
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+
+function emit(source: string): string {
+  const sourceFile = ts.createSourceFile('/flight/packages/example/src/jsonFlow.ts', source, ts.ScriptTarget.Latest, true);
+  const lowered = lowerTypeScriptSource(sourceFile, { packageName: '@flighthq/example', upstreamDirectory: '/flight' });
+  expect(lowered.diagnostics).toEqual([]);
+  return emitIrModuleCpp(lowered.module, { runtimeProfile: 'flight-cpp' }).contents;
+}
+
+const producer = `type Raw = Record<string, unknown>;
+function parseRaw(text: string): Raw {
+  let raw: unknown;
+  try { raw = JSON.parse(text); } catch { throw new Error('syntax'); }
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('object');
+  return raw as Raw;
+}`;
+const reader = `function read(raw: Raw): unknown { return raw.n; }
+export function run(text: string): unknown { return read(parseRaw(text)); }`;
+
+it('retains one original parsed owner across a private producer, local and read-only mutable-Record helper', () => {
+  const output = emit(producer + reader + `export function pair(text: string): unknown {
+    const raw = parseRaw(text); read(raw); return read(raw);
+  }`);
+  expect(output).toContain('inline flight::NamedProperties parse_raw');
+  expect(output).toContain('inline flight::Any read(flight::NamedProperties raw)');
+  expect(output).toContain('flight::NamedProperties raw = parse_raw(text)');
+  expect(output).toContain('return flight::named_properties(raw);');
+  expect(output).toContain('using Raw = flight::Record<flight::String, flight::Any>');
+  expect(output).not.toContain('static_cast<Raw>');
+});
+
+it('retains erased nested shapes and distinguishes optional nullish reads from required reads', () => {
+  const output = emit(producer + `function nested(obj: unknown): unknown {
+    const shape = obj as { x?: unknown } | undefined; return shape?.x;
+  } function read(raw: Raw): unknown {
+    const accel = raw.acceleration as { x?: unknown } | undefined;
+    if (accel !== undefined) return accel.x;
+    return nested(raw.n);
+  } export function run(text: string): unknown { return read(parseRaw(text)); }`);
+  expect(output).toContain('flight::Any shape = obj');
+  expect(output).toContain('flight::Any accel = raw.get');
+  expect(output).toContain('read_json_data_property');
+  expect(output).toContain('.is_nullish()');
+  expect(output).toContain('!presence_operand.is_undefined()');
+  expect(output).not.toContain('.object_if<');
+});
+
+it.each([
+  ['exported', producer.replace('function parseRaw', 'export function parseRaw') + reader],
+  ['returned result', producer + reader + `export function escape(text: string): Raw { return parseRaw(text); }`],
+  ['returned local', producer + reader + `export function escape(text: string): Raw { const raw = parseRaw(text); return raw; }`],
+  ['callback', producer + reader + `export function callback(): (text: string) => Raw { return parseRaw; }`],
+  ['comparison', producer + reader + `export function compare(text: string): boolean { const a = parseRaw(text); const b = parseRaw(text); return a === b; }`],
