+// Record owns configurable dictionary entries (including its shared symbol-attachment store).
+// JavaScript delete succeeds for a missing key as well as a removed key. Do not read the payload or
+// return erase's removed/not-found flag. A C++ member call sequences its receiver before the sole key
+// argument, and the comma keeps the source boolean after that one mutation of the same Record owner.
+function emitCppRecordDeleteCpp(
+  expression: Readonly<Extract<IrExpression, { kind: 'unary' }>>,
+  context: EmitContext,
+): string | undefined {
+  if (
+    expression.operator !== 'delete' ||
+    expression.operand.kind !== 'element' ||
+    getCppRuntimeProfile(context.options) !== 'flight-cpp'
+  )
+    return undefined;
+  const sourceType = getIrExpressionTypeEvidenceCpp(expression.operand.object, context);
+  const record = getCppRecordDeleteTypeArgumentsCpp(sourceType, context, new Set());
+  if (!record) return undefined;
+  const target = emitExpression(expression.operand.object, context);
+  const key = emitCppRequiredRecordKeyCpp(expression.operand.index, record.key, context);
+  return `(${target}.erase(${key}), true)`;
+}
+
+// Keep dictionary deletion separate from nominal/index-signature shapes and readonly views.
+// Only the actual ambient Record declaration (possibly behind aliases) proves this storage contract.
+function getCppRecordDeleteTypeArgumentsCpp(
+  type: Readonly<IrType> | undefined,
+  context: EmitContext,
+  resolvingAliases: ReadonlySet<string>,
+): Readonly<{ key: IrType; value: IrType }> | undefined {
+  if (!type || type.kind !== 'named') return undefined;
+  if (type.reference.kind === 'ambient') {
+    if (type.reference.name === 'Readonly' && type.typeArguments.length === 1) {
+      const record = getCppRecordDeleteTypeArgumentsCpp(type.typeArguments[0], context, resolvingAliases);
+      if (record)
+        emissionError(
+          context,
+          'deleting a readonly Record property is not a writable dictionary operation',
+          'cpp-readonly-record-delete',
+        );
+      return undefined;
+    }
+    return type.reference.name === 'Record' ? getCppRecordTypeArgumentsCpp(type, context, resolvingAliases) : undefined;
+  }
+  if (resolvingAliases.has(type.reference.binding.id)) return undefined;
+  const alias = resolveCppTypeAliasTarget(type, context);
+  return alias
+    ? getCppRecordDeleteTypeArgumentsCpp(alias, context, new Set(resolvingAliases).add(type.reference.binding.id))
+    : undefined;
+}
