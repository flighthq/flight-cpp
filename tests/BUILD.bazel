load("@rules_cc//cc:defs.bzl", "cc_test")
load(":header_tests.bzl", "flight_cpp_public_header_tests")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "runtime_test",
    srcs = ["runtime_test.cpp"],
    size = "small",
    deps = ["//:cpp"],
)

cc_test(
    name = "runtime_conformance_test",
    srcs = ["runtime_conformance_test.cpp"],
    size = "small",
    deps = ["//:cpp"],
)

cc_test(
    name = "generated_runtime_test",
    srcs = [
        "generated/semantic_runtime.hpp",
        "generated_runtime_test.cpp",
    ],
    size = "small",
    deps = ["//:cpp"],
)

cc_test(
    name = "c_api_test",
    srcs = ["c_api_test.c"],
    size = "small",
    deps = ["//:c"],
)

cc_test(
    name = "c_api_thread_test",
    srcs = ["c_api_thread_test.cpp"],
    size = "small",
    deps = ["//:c"],
)

cc_test(
    name = "host_sdl_test",
    srcs = ["host_sdl_test.cpp"],
    env = {
        "SDL_AUDIODRIVER": "dummy",
        "SDL_VIDEODRIVER": "dummy",
    },
    size = "small",
    tags = ["manual"],
    deps = [
        "//:host_sdl_gl",
        "//:host_sdl_sdk_audio",
        "//:host_sdl_sdk_clipboard",
        "//:host_sdl_sdk_cursor",
        "//:host_sdl_sdk_platform",
        "//:host_sdl_sdk_window",
        "//:host_sdl_wgpu",
    ],
)

flight_cpp_public_header_tests()
