+import ts from 'typescript';
+import { expect, it } from 'vitest';
+import { lowerTypeScriptSource } from '../../compiler-semantic/src/index.js';
+import { emitIrModuleCpp } from './cppCompilerBackend.js';
+function emit(source:string):string {
+ const lowered=lowerTypeScriptSource(ts.createSourceFile('/flight/packages/example/src/proposal.ts',source,ts.ScriptTarget.Latest,true),{packageName:'@flighthq/example',upstreamDirectory:'/flight'});
+ expect(lowered.diagnostics).toEqual([]);return emitIrModuleCpp(lowered.module,{runtimeProfile:'flight-cpp'}).contents;
+}
+const prefix='export interface Options{size?:number;kind?:number}export interface Sink{parse(text:string,options?:Readonly<Options>):number}export let sink:Sink={parse:(_text:string,options?:Readonly<Options>)=>5};';
+const forward='export function dispatch(text:string,options?:Options):number{return sink.parse(text,options)}';
+const consumer='export function consume(text:string,options?:Readonly<Options>):number{return dispatch(text,options)}';
+it('adds a uniquely named readonly helper while keeping the original native ABI',()=>{
+ const output=emit(prefix+forward+consumer);
+ expect(output).toContain('inline double dispatch(flight::String text, std::optional<flight::Ref<Options>> options = std::nullopt)');
+ expect(output.match(/inline double dispatch_flight_readonly_options_/g)?.length).toEqual(1);
+ expect(output).toMatch(/return dispatch_flight_readonly_options_[a-f0-9]+\(text, options\);/);
+ expect(output.match(/return sink->parse\(text, options\);/g)?.length).toEqual(2);
+ expect(output).not.toContain('structural_ref_cast');expect(output).not.toContain('make_structural_ref');
+});
+it('keeps a nominal caller on the original entrypoint',()=>{
+ const output=emit(prefix+forward+'export function native(text:string,options?:Options):number{return dispatch(text,options)}');
+ expect(output).toContain('return dispatch(text, options);');
+});
+const excluded:readonly(readonly[string,string])[]=[
+ ['mutable target',prefix.replace('Readonly<Options>','Options')+forward],
+ ['different canonical owner',prefix.replace('export interface Sink','export interface Other{size?:number;kind?:number}export interface Sink').replace('Readonly<Options>','Readonly<Other>')+forward],
+ ['two forwarding uses',prefix+forward.replace('return sink.parse(text,options)','sink.parse(text,options);return sink.parse(text,options)')],
+ ['alias escape',prefix+forward.replace('return sink.parse(text,options)','const alias=options;return sink.parse(text,alias)')],
+ ['captured reference',prefix+forward.replace('return sink.parse(text,options)','const fn=()=>sink.parse(text,options);return fn()')],
+ ['additional direct read',prefix+forward.replace('return sink.parse(text,options)','options?.size;return sink.parse(text,options)')],
+ ['parameter write',prefix+forward.replace('return sink.parse(text,options)','options=undefined;return sink.parse(text,options)')],
+ ['identity observation',prefix+forward.replace('return sink.parse(text,options)','if(options===undefined)return 0;return sink.parse(text,options)')],
+ ['non numeric shape',prefix.replace('kind?:number','kind?:string')+forward],
+ ['three field shape',prefix.replace('kind?:number','kind?:number;other?:number')+forward],
+];
+it.each(excluded)('leaves the preceding lane for %s',(_name,source)=>{
+ const output=emit(source);expect(output).not.toContain('dispatch_flight_readonly_options_');
+});
