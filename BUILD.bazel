load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cpp",
    hdrs = [
        "include/flight/abort.hpp",
        "include/flight/array.hpp",
        "include/flight/array_buffer.hpp",
        "include/flight/array_buffer_view.hpp",
        "include/flight/audio_buffer.hpp",
        "include/flight/base64.hpp",
        "include/flight/blob.hpp",
        "include/flight/boolean.hpp",
        "include/flight/callable.hpp",
        "include/flight/conditional_facet_ref.hpp",
        "include/flight/contract.hpp",
        "include/flight/data_view.hpp",
        "include/flight/date.hpp",
        "include/flight/dom_exception.hpp",
        "include/flight/equality.hpp",
        "include/flight/error.hpp",
        "include/flight/executor.hpp",
        "include/flight/host.hpp",
        "include/flight/image_data.hpp",
        "include/flight/host/console.hpp",
        "include/flight/host/performance.hpp",
        "include/flight/host/timers.hpp",
        "include/flight/intl.hpp",
        "include/flight/iterable.hpp",
        "include/flight/iterator.hpp",
        "include/flight/json.hpp",
        "include/flight/map.hpp",
        "include/flight/math.hpp",
        "include/flight/number.hpp",
        "include/flight/object.hpp",
        "include/flight/presence.hpp",
        "include/flight/reference.hpp",
        "include/flight/regexp.hpp",
        "include/flight/record.hpp",
        "include/flight/rejection.hpp",
        "include/flight/runtime.hpp",
        "include/flight/set.hpp",
        "include/flight/sequence_view.hpp",
        "include/flight/string.hpp",
        "include/flight/stream.hpp",
        "include/flight/structural_ref.hpp",
        "include/flight/symbol.hpp",
        "include/flight/task.hpp",
        "include/flight/text_decoder.hpp",
        "include/flight/text_encoder.hpp",
        "include/flight/typed_array.hpp",
        "include/flight/uri.hpp",
        "include/flight/url.hpp",
        "include/flight/version.hpp",
        "include/flight/weak_map.hpp",
        "include/flight/weak_set.hpp",
        "include/flight/web_types.hpp",
    ],
    strip_include_prefix = "include",
)

cc_library(
    name = "c",
    srcs = ["src/c_runtime.cpp"],
    hdrs = ["include/flight/c/runtime.h"],
    linkstatic = True,
    strip_include_prefix = "include",
    deps = [":cpp"],
)

alias(
    name = "flight_cpp",
    actual = ":cpp",
)

alias(
    name = "flight_cpp_c",
    actual = ":c",
)

alias(
    name = "sdk_preview",
    actual = "//generated:sdk_preview",
)

cc_library(
    name = "host_sdl",
    srcs = [
        "src/host_sdl/detail.hpp",
        "src/host_sdl/audio.cpp",
        "src/host_sdl/host.cpp",
        "src/host_sdl/input.cpp",
        "src/host_sdl/window.cpp",
    ],
    hdrs = [
        "include/flight/host_sdl/audio.hpp",
        "include/flight/host_sdl/export.hpp",
        "include/flight/host_sdl/host.hpp",
        "include/flight/host_sdl/input.hpp",
        "include/flight/host_sdl/window.hpp",
    ],
    strip_include_prefix = "include",
    tags = ["manual"],
    deps = [
        ":cpp",
        "@sdl3_source//:sdl3",
    ],
)

cc_library(
    name = "host_sdl_gl",
    srcs = [
        "src/host_sdl/gl.cpp",
        "src/host_sdl/web_platform.cpp",
        "src/host_sdl/webgl.cpp",
    ],
    hdrs = [
        "include/flight/host_sdl/gl.hpp",
        "include/flight/host_sdl/web_platform.hpp",
        "include/flight/host_sdl/web_platform_types.hpp",
        "include/flight/host_sdl/webgl.hpp",
    ],
    strip_include_prefix = "include",
    tags = ["manual"],
    deps = [":host_sdl"],
)

cc_library(
    name = "host_sdl_sdk_audio",
    srcs = ["src/host_sdl/sdk_audio.cpp"],
    hdrs = ["include/flight/host_sdl/sdk_audio.hpp"],
    strip_include_prefix = "include",
    tags = ["manual"],
    deps = [
        ":host_sdl",
        ":sdk_preview",
    ],
)

cc_library(
    name = "host_sdl_wgpu",
    srcs = ["src/host_sdl/wgpu.cpp"],
    hdrs = ["include/flight/host_sdl/wgpu.hpp"],
    strip_include_prefix = "include",
    tags = ["manual"],
    deps = [":host_sdl"],
)

test_suite(
    name = "tests",
    tests = [
        "//examples:tween",
        "//examples:sdk_math",
        "//tests:c_api_test",
        "//tests:c_api_thread_test",
        "//tests:generated_runtime_test",
        "//tests:public_header_tests",
        "//tests:runtime_conformance_test",
        "//tests:runtime_test",
        "//tests/consumer:c_consumer_test",
        "//tests/consumer:cpp_consumer_test",
    ],
)
