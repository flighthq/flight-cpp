build --incompatible_strict_action_env
build --nostamp

common --lockfile_mode=error
common --enable_platform_specific_config

build:linux --cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20
build:freebsd --cxxopt=-std=c++20
build:openbsd --cxxopt=-std=c++20
build:windows --cxxopt=/std:c++20

# Floating-point contraction stays off, matching the Flight::Cpp CMake interface: JavaScript never fuses a
# multiply into an add. See docs/floating-point-contraction.md.
build:linux --copt=-ffp-contract=off
build:macos --copt=-ffp-contract=off
build:freebsd --copt=-ffp-contract=off
build:openbsd --copt=-ffp-contract=off
build:windows --copt=/fp:precise

test --test_env=LC_ALL=C
test --test_env=TZ=UTC
test --test_output=errors

build:local-posix --cxxopt=-pthread
build:local-posix --linkopt=-pthread

build:release --compilation_mode=opt
build:release --nostamp
build:release --strip=always

test:ci --keep_going

try-import %workspace%/.bazelrc.local
