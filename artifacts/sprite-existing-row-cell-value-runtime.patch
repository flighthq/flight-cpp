+namespace detail {
+template <typename Value>
+[[nodiscard]] std::optional<Any> row_cell_value_as_any(const Value& value) {
+  if constexpr (is_std_optional<std::remove_cvref_t<Value>>::value) {
+    return value ? row_cell_value_as_any(*value) : std::optional<Any>(Any(undefined));
+  } else if constexpr (requires { value.shared_owner(); value.shared_native_object(); }) {
+    const auto owner = value.shared_owner();
+    if (!owner) return std::nullopt;
+    auto erased = owner->raw_value();
+    // The existing owner must name its exact source object. No box, proxy-target substitution or
+    // fabricated nominal owner is a representation of this row value.
+    if (!erased || !erased->held_object() || erased->erased_row_owner().get() != owner.get()) return std::nullopt;
+    return erased;
+  } else {
+    return any_from(value);
+  }
+}
+} // namespace detail
 
