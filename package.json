{
  "name": "flight-cpp-repository",
  "version": "0.1.0",
  "private": true,
  "description": "Repository automation for the Flight C++20 runtime. The runtime itself is built with CMake or Bazel and needs no Node.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "abort:oracle": "node ./scripts/abortOracle.mjs",
    "abi:check": "node ./scripts/abiHealth.mjs",
    "array-like:oracle": "node ./scripts/arrayLikeOracle.mjs",
    "audio-buffer:oracle": "node ./scripts/audioBufferOracle.mjs",
    "base64:oracle": "node ./scripts/base64Oracle.mjs",
    "blob:oracle": "node ./scripts/blobOracle.mjs",
    "build:check": "node ./scripts/buildHealth.mjs",
    "check": "node ./scripts/check.mjs",
    "compile:check": "node ./scripts/emittedSourceCompile.mjs",
    "facets:oracle": "node ./scripts/conditionalFacetOracle.mjs",
    "examples:check": "node ./scripts/exampleHealth.mjs",
    "examples:generate": "node ./scripts/upstreamExampleGeneration.mjs",
    "examples:generate:check": "node ./scripts/upstreamExampleGeneration.mjs --check",
    "headless:oracle": "node ./scripts/headlessProfileOracle.mjs",
    "promise-like:oracle": "node ./scripts/promiseLikeOracle.mjs",
    "regexp:oracle": "node ./scripts/regexpOracle.mjs",
    "rehydrate": "node ./scripts/rehydrate.mjs",
    "rehydrate:check": "node ./scripts/rehydrate.mjs --check",
    "rehydrate:update": "node ./scripts/rehydrate.mjs --update",
    "release:check": "node ./scripts/releaseHealth.mjs",
    "runtime:oracle": "node ./scripts/runtimeOracle.mjs",
    "sdk:check": "node ./scripts/sdkGeneration.mjs --check",
    "sdk:compile": "node ./scripts/sdkHeaderCompile.mjs",
    "sdk:compile:headless": "node ./scripts/sdkHeaderCompile.mjs --generated=out/sdk-headless --report=out/sdk-headless-header-compilation.json",
    "sdk:compile:sdl": "node ./scripts/sdkHeaderCompile.mjs --generated=out/sdk-sdl --report=out/sdk-sdl-header-compilation.json",
    "sdk:compile:sdl-gl": "node ./scripts/sdkHeaderCompile.mjs --generated=out/sdk-sdl-gl --report=out/sdk-sdl-gl-header-compilation.json",
    "sdk:compile:sdl-wgpu": "node ./scripts/sdkHeaderCompile.mjs --generated=out/sdk-sdl-wgpu --report=out/sdk-sdl-wgpu-header-compilation.json",
    "sdk:generate": "node ./scripts/sdkGeneration.mjs",
    "sdk:generate:headless": "node ./scripts/sdkGeneration.mjs --binding-profile=bindings/runtime.json --binding-profile=bindings/headless.json --output=out/sdk-headless",
    "sdk:generate:sdl": "node ./scripts/sdkGeneration.mjs --binding-profile=bindings/runtime.json --binding-profile=bindings/headless.json --binding-profile=bindings/web-types.json --binding-profile=bindings/sdl-gl.json --binding-profile=bindings/sdl-wgpu.json --binding-profile=bindings/sdl-app.json --output=out/sdk-sdl",
    "sdk:generate:sdl-gl": "node ./scripts/sdkGeneration.mjs --binding-profile=bindings/runtime.json --binding-profile=bindings/headless.json --binding-profile=bindings/web-types.json --binding-profile=bindings/sdl-gl.json --output=out/sdk-sdl-gl",
    "sdk:generate:sdl-wgpu": "node ./scripts/sdkGeneration.mjs --binding-profile=bindings/runtime.json --binding-profile=bindings/headless.json --binding-profile=bindings/web-types.json --binding-profile=bindings/sdl-wgpu.json --output=out/sdk-sdl-wgpu",
    "sdk:generate:runtime": "node ./scripts/sdkGeneration.mjs --binding-profile=bindings/runtime.json --output=out/sdk-runtime",
    "sdl-app:oracle": "node ./scripts/sdlAppProfileOracle.mjs",
    "sdl-gl:oracle": "node ./scripts/sdlGlProfileOracle.mjs",
    "sdl-wgpu:oracle": "node ./scripts/sdlWgpuProfileOracle.mjs",
    "structural:oracle": "node ./scripts/structuralProxyOracle.mjs",
    "stream:oracle": "node ./scripts/streamOracle.mjs",
    "text-encoder:oracle": "node ./scripts/textEncoderOracle.mjs",
    "uri:oracle": "node ./scripts/uriOracle.mjs",
    "web-types:oracle": "node ./scripts/webTypesOracle.mjs"
  }
}
